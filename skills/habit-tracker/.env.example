# Habit Tracker Environment Variables

# Discord Bot Token (required for DM notifications)
DISCORD_TOKEN=your_discord_bot_token_here

# Target User ID for reminders (your Discord user ID)
TARGET_USER_ID=your_discord_user_id_here

# GLM-4V API Key for food image recognition (optional)
GLM_API_KEY=your_glm_api_key_here

# Siyuan Note data path (optional, for sync feature)
SIYUAN_DATA_PATH=/path/to/siyuan/data
