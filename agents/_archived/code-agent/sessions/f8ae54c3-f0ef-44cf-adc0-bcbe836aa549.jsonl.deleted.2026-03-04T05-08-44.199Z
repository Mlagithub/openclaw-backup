{"type":"message","id":"02f7c1a6","parentId":"fb94cb25","timestamp":"2026-03-04T04:08:21.832Z","message":{"role":"toolResult","toolCallId":"tool-e57b75ffee484694977e53e5cd1422f6","toolName":"read","content":[{"type":"text","text":"import type { RGB, PixelDataState, ArtboardSize } from \"../types.js\";\nimport { PixelData } from \"../crdt/PixelData.js\";\nimport { Encoder } from \"../encoding/Encoder.js\";\nimport { Decoder } from \"../encoding/Decoder.js\";\n\n/**\n * Compression mode\n */\nexport type CompressionMode = \"none\" | \"binary\";\n\n/**\n * PixelEditor - Canvas-based pixel art editor with CRDT sync\n */\nexport class PixelEditor {\n  /** The underlying canvas element */\n  #el: HTMLCanvasElement;\n\n  /** 2D canvas rendering context */\n  #ctx: CanvasRenderingContext2D;\n\n  /** Artboard size in drawable pixels */\n  #artboard: ArtboardSize;\n\n  /** Underlying pixel data CRDT */\n  #data: PixelData;\n\n  /** Selected drawing color */\n  #color: RGB = [0, 0, 0];\n\n  /** Previous cursor position for line drawing */\n  #prev: [x: number, y: number] | undefined;\n\n  /** Painted pixels during current drag (for timestamp optimization) */\n  #painted = new Set<string>();\n\n  /** Change event listeners */\n  #listeners: Array<(data: PixelDataState | Uint8Array) => void> = [];\n\n  /** Compression mode */\n  #compressionMode: CompressionMode = \"none\";\n\n  /** Encoder instance */\n  #encoder?: Encoder;\n\n  /** Decoder instance */\n  #decoder?: Decoder;\n\n  /**\n   * Set the compression mode\n   */\n  set compressionMode(mode: CompressionMode) {\n    this.#compressionMode = mode;\n    if (mode === \"binary\") {\n      this.#encoder = new Encoder(this.#artboard.w, this.#artboard.h);\n      this.#decoder = new Decoder();\n    }\n  }\n\n  /**\n   * Get the compression mode\n   */\n  get compressionMode(): CompressionMode {\n    return this.#compressionMode;\n  }\n\n  /**\n   * Set the drawing color\n   */\n  set color(color: RGB) {\n    this.#color = color;\n  }\n\n  /**\n   * Get the drawing color\n   */\n  get color(): RGB {\n    return this.#color;\n  }\n\n  /**\n   * Create a new PixelEditor\n   * @param el - Canvas element\n   * @param artboard - Artboard dimensions\n   * @param id - Unique peer ID (optional, generates UUID if not provided)\n   */\n  constructor(el: HTMLCanvasElement, artboard: ArtboardSize, id?: string) {\n    this.#el = el;\n    this.#artboard = artboard;\n\n    const ctx = el.getContext(\"2d\");\n    if (!ctx) throw new Error(\"Couldn't get 2D rendering context\");\n    this.#ctx = ctx;\n\n    this.#data = new PixelData(id ?? crypto.randomUUID());\n\n    // Listen for pointer events\n    this.#el.addEventListener(\"pointerdown\", this);\n    this.#el.addEventListener(\"pointermove\", this);\n    this.#el.addEventListener(\"pointerup\", this);\n\n    // Handle high-DPI displays\n    this.#el.width = this.#el.clientWidth * devicePixelRatio;\n    this.#el.height = this.#el.clientHeight * devicePixelRatio;\n    this.#ctx.scale(devicePixelRatio, devicePixelRatio);\n    this.#ctx.imageSmoothingEnabled = false;\n\n    // Initial draw\n    this.#draw();\n  }\n\n  /**\n   * Add a change listener\n   */\n  set onchange(listener: (data: PixelDataState | Uint8Array) => void) {\n    this.#listeners.push(listener);\n  }\n\n  /**\n   * Handle pointer events (implements EventListener interface)\n   */\n  handleEvent(e: PointerEvent): void {\n    switch (e.type) {\n      case \"pointerdown\": {\n        this.#el.setPointerCapture(e.pointerId);\n        // Clear painted set for new drag\n        this.#painted.clear();\n        // Fall through to paint\n      }\n      // eslint-disable-next-line no-fallthrough\n      case \"pointermove\": {\n        if (!this.#el.hasPointerCapture(e.pointerId)) return;\n\n        // Convert canvas pixels to artboard pixels\n        const x = Math.floor(\n          (this.#artboard.w * e.offsetX) / this.#el.clientWidth\n        );\n        const y = Math.floor(\n          (this.#artboard.h * e.offsetY) / this.#el.clientHeight\n        );\n\n        this.#paint(x, y);\n        this.#prev = [x, y];\n        break;\n      }\n      case \"pointerup\": {\n        this.#el.releasePointerCapture(e.pointerId);\n        this.#prev = undefined;\n        this.#painted.clear();\n        break;\n      }\n    }\n  }\n\n  /**\n   * Paint a pixel and draw a line from previous position\n   */\n  #paint(x: number, y: number): void {\n    // Bounds check\n    if (x < 0 || this.#artboard.w <= x) return;\n    if (y < 0 || this.#artboard.h <= y) return;\n\n    // Timestamp optimization: skip if already painted in this drag\n    const key = PixelData.key(x, y);\n    if (this.#painted.has(key)) return;\n    this.#painted.add(key);\n\n    // Set the pixel\n    this.#data.set(x, y, this.#color);\n\n    // Draw line from previous position using DDA algorithm\n    if (this.#prev) {\n      const [px, py] = this.#prev;\n      this.#drawLine(px, py, x, y);\n    }\n\n    this.#draw();\n    this.#notify();\n  }\n\n  /**\n   * Draw a line between two points using DDA algorithm\n   */\n  #drawLine(x0: number, y0: number, x1: number, y1: number): void {\n    const dx = x1 - x0;\n    const dy = y1 - y0;\n    const steps = Math.max(Math.abs(dx), Math.abs(dy));\n\n    if (steps === 0) return;\n\n    const xInc = dx / steps;\n    const yInc = dy / steps;\n\n    let x = x0;\n    let y = y0;\n\n    for (let i = 0; i < steps; i++) {\n      x += xInc;\n      y += yInc;\n      const ix = Math.round(x);\n      const iy = Math.round(y);\n\n      // Bounds check\n      if (ix < 0 || this.#artboard.w <= ix) continue;\n      if (iy < 0 || this.#artboard.h <= iy) continue;\n\n      // Timestamp optimization\n      const key = PixelData.key(ix, iy);\n      if (this.#painted.has(key)) continue;\n      this.#painted.add(key);\n\n      this.#data.set(ix, iy, this.#color);\n    }\n  }\n\n  /**\n   * Draw all pixels to canvas\n   */\n  async #draw(): Promise<void> {\n    const chans = 4; // RGBA\n    const buffer = new Uint8ClampedArray(\n      this.#artboard.w * this.#artboard.h * chans\n    );\n    const rowsize = this.#artboard.w * chans;\n\n    for (let row = 0; row < this.#artboard.h; row++) {\n      const offsetY = row * rowsize;\n      for (let col = 0; col < this.#artboard.w; col++) {\n        const offsetX = col * chans;\n        const offset = offsetY + offsetX;\n\n        const [r, g, b] = this.#data.get(col, row);\n        buffer[offset] = r;\n        buffer[offset + 1] = g;\n        buffer[offset + 2] = b;\n        buffer[offset + 3] = 255; // Alpha\n      }\n    }\n\n    const data = new ImageData(buffer, this.#artboard.w, this.#artboard.h);\n    const bitmap = await createImageBitmap(data);\n    this.#ctx.drawImage(\n      bitmap,\n      0,\n      0,\n      this.#el.clientWidth,\n      this.#el.clientHeight\n    );\n  }\n\n  /**\n   * Notify listeners of state change\n   */\n  #notify(): void {\n    const state = this.#data.state;\n\n    if (this.#compressionMode === \"binary\" && this.#encoder) {\n      const encoded = this.#encoder.encode(state);\n      for (const listener of this.#listeners) {\n        listener(encoded);\n      }\n    } else {\n      for (const listener of this.#listeners) {\n        listener(state);\n      }\n    }\n  }\n\n  /**\n   * Receive and merge remote state\n   */\n  receive(data: PixelDataState | Uint8Array): void {\n    if (this.#compressionMode === \"binary\" && this.#decoder && data instanceof Uint8Array) {\n      const { state } = this.#decoder.decode(data);\n      this.#data.merge(state);\n    } else if (data instanceof Uint8Array) {\n      throw new Error(\"Received binary data but binary mode is not enabled\");\n    } else {\n      this.#data.merge(data);\n    }\n    this.#draw();\n  }\n\n  /**\n   * Get the current state\n   */\n  get state(): PixelDataState {\n    return this.#data.state;\n  }\n\n  /**\n   * Get the current artboard size\n   */\n  get artboard(): ArtboardSize {\n    return { ...this.#artboard };\n  }\n}"}],"isError":false,"timestamp":1772597301830}}
{"type":"message","id":"e7f62412","parentId":"02f7c1a6","timestamp":"2026-03-04T04:08:21.838Z","message":{"role":"toolResult","toolCallId":"tool-2761ffb8fa70474a8db9490c8f96e313","toolName":"read","content":[{"type":"text","text":"/**\n * RGB color tuple: [red, green, blue]\n * Each channel is 0-255\n */\nexport type RGB = [red: number, green: number, blue: number];\n\n/**\n * State of an LWW Register: [peerId, timestamp, value]\n */\nexport type LWWRegisterState<T> = [peerId: string, timestamp: number, value: T];\n\n/**\n * State of an LWW Map: mapping of keys to LWW Register states\n */\nexport type LWWMapState<T> = Record<string, LWWRegisterState<T | null>>;\n\n/**\n * State of PixelData (same as LWWMapState<RGB>)\n */\nexport type PixelDataState = LWWMapState<RGB>;\n\n/**\n * Value type for LWW Map\n */\nexport type LWWMapValue<T> = Record<string, T>;\n\n/**\n * Artboard dimensions\n */\nexport interface ArtboardSize {\n  w: number;\n  h: number;\n}"}],"isError":false,"timestamp":1772597301836}}
{"type":"message","id":"bfdd0215","parentId":"e7f62412","timestamp":"2026-03-04T04:08:21.843Z","message":{"role":"toolResult","toolCallId":"tool-8f7f2ea9faea4512aec944ee0752de8e","toolName":"read","content":[{"type":"text","text":"import type { RGB, PixelDataState } from \"../types.js\";\nimport { LWWMap } from \"./LWWMap.js\";\n\n/**\n * PixelData - Thin wrapper over LWWMap for pixel coordinates\n * \n * Maps (x, y) coordinates to RGB colors using an underlying LWW Map.\n * Default color is white [255, 255, 255].\n */\nexport class PixelData {\n  /** Unique peer ID */\n  readonly id: string;\n  \n  /** Underlying LWW Map */\n  #data: LWWMap<RGB>;\n\n  /**\n   * Get the current value (map of \"x,y\" -> RGB)\n   */\n  get value(): Record<string, RGB> {\n    return this.#data.value;\n  }\n\n  /**\n   * Get the full state for serialization\n   */\n  get state(): PixelDataState {\n    return this.#data.state;\n  }\n\n  /**\n   * Create a new PixelData instance\n   * @param id - Unique peer ID\n   * @param state - Optional initial state\n   */\n  constructor(id: string, state?: PixelDataState) {\n    this.id = id;\n    this.#data = new LWWMap(this.id, state ?? {});\n  }\n\n  /**\n   * Generate a string key from coordinates\n   * @param x - X coordinate\n   * @param y - Y coordinate\n   * @returns String key \"x,y\"\n   */\n  static key(x: number, y: number): string {\n    return `${x},${y}`;\n  }\n\n  /**\n   * Set a pixel color\n   * @param x - X coordinate\n   * @param y - Y coordinate\n   * @param value - RGB color\n   */\n  set(x: number, y: number, value: RGB): void {\n    const key = PixelData.key(x, y);\n    this.#data.set(key, value);\n  }\n\n  /**\n   * Get a pixel color\n   * Returns white [255, 255, 255] if not set\n   * @param x - X coordinate\n   * @param y - Y coordinate\n   * @returns RGB color\n   */\n  get(x: number, y: number): RGB {\n    const key = PixelData.key(x, y);\n    const value = this.#data.get(key);\n    return value ?? [255, 255, 255];\n  }\n\n  /**\n   * Delete a pixel (set to tombstone)\n   * @param x - X coordinate\n   * @param y - Y coordinate\n   */\n  delete(x: number, y: number): void {\n    const key = PixelData.key(x, y);\n    this.#data.delete(key);\n  }\n\n  /**\n   * Merge remote state\n   * @param state - Remote state to merge\n   */\n  merge(state: PixelDataState): void {\n    this.#data.merge(state);\n  }\n}"}],"isError":false,"timestamp":1772597301841}}
