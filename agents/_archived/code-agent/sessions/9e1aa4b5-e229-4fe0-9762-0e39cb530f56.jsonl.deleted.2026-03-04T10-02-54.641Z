{"type":"message","id":"c0f9d728","parentId":"e643eaa1","timestamp":"2026-03-04T09:05:24.819Z","message":{"role":"toolResult","toolCallId":"tool-b7af6b6d008e4ba095db97564c9d8ade","toolName":"read","content":[{"type":"text","text":"#pragma once\n\n#include <memory>\n#include <unordered_map>\n#include <map>\n#include <functional>\n\n#ifdef SUPPORT_METIS\n#include <metis.h>\n#else \n    typedef int64_t idx_t;\n#endif\n\n#include \"meshCutter.h\"\n#include \"cgFile.h\"\n\nusing std::map;\nusing std::unordered_map;\n\n// Hash function for face (vector of cgsize_t)\ninline size_t hashFace(const vector<cgsize_t>& face) {\n    size_t h = 0;\n    for (auto id : face)\n        h ^= hash<cgsize_t>{}(id) + 0x9e3779b9 + (h << 6) + (h >> 2);\n    return h;\n}\n\n\nnamespace MeshCut\n{\nclass MetisCutter : public MeshCutter\n{\npublic:\n    MetisCutter();\n    virtual ~MetisCutter();\n\npublic:\n    void cut(int argc, char** argv) override;\n\nprivate:\n    using cgns_filetype = std::shared_ptr<CGFile>;\n    int RANK = 0, SIZE = 1;\n    cgns_filetype bigMesh_;\n    vector<cgns_filetype> smallMesh_;\n    map<int, map<cgsize_t, cgsize_t>> nodeIdG2L_;\n    set<cgsize_t> nodeIds_, cellIds_;\n    vector<idx_t> cellPartition_, nodePartition_;\n    unordered_map<int, unordered_map<size_t, vector<cgsize_t>>> outerFace_;\n    cgsize_t globalOffset_ = 0;\n    set<int> ownerFile_;\n    struct DecomposeResult\n    {\n        idx_t nCellThisRank, start;\n    };\n    struct Cell\n    {\n        idx_t id;   // begin from 1\n        int partId; // begin from 0;\n    };\n    vector<int> ownerThread_;\n\nprivate:\n    void collect_interface();\n    \n    vector<Cell> collect_subBody(const DecomposeResult& decomposeResult, const vector<int>& ownerThread);\n\n    void cut_metis(string mesh, const int np);\n\n    int cut_metis(const vector<vector<idx_t>>& cellToplogy, idx_t np, vector<idx_t>& cellPartition, vector<idx_t>& nodePartition);\n\n    void cut_parmetis(string mesh, const int np);\n\n    int cut_parmetis(idx_t np, vector<idx_t>& elmdist, vector<idx_t>& eptr, vector<idx_t>& eind, vector<idx_t>& cellPartition);\n\n    DecomposeResult decompose_body(const CGFile::Section& bigBody, const int np);\n\n    void updateOwnerThread(string filename, const int np);\n\n    void openSubMeshToWrite(string filename, const int id, const int np);\n\n    void rwBody(const int ifile, const CGFile::Section& bigBody);\n\n    void rwBoundary(const int ifile);\n\n    void rwInterface(const int ifile);\n\n    void rwNode(const int ifile);\n\n    std::string smallMeshName(string bigMeshName, const int id, const int np);\n\n    void updateOuterFace(const CGFile::Section& curS, const int id);\n\n    void writeGlobalInfo(const CGFile::Section& curS, const int id);\n\n    void writeInterface(const int ifile, const int np);\n};\n} // namespace MeshCut\n"}],"isError":false,"timestamp":1772615124817}}
{"type":"message","id":"eb22de43","parentId":"c0f9d728","timestamp":"2026-03-04T09:05:24.825Z","message":{"role":"toolResult","toolCallId":"tool-eca08c4b81e9456688a1fbb705cb4672","toolName":"read","content":[{"type":"text","text":"#include <algorithm>\n#include <cmath>\n#include <cstring>\n#include <ctime>\n#include <numeric>\n\n#include <cgns_io.h>\n#include <parmetis.h>\n\n#include \"cmdLine.h\"\n#include \"metisCutter.h\"\n#include \"mpiAdapter.h\"\n#include \"stringUtil.h\"\n\nstatic const int DataTAG = 1000;\n\nstatic std::vector<idx_t> distribute(const idx_t len, const int n, idx_t &nCellThisRank)\n{\n    vector<idx_t> dist(n + 1, 0);\n    idx_t base = len / n;\n    idx_t remainder = len % n;\n    int rank;\n    MPI_Comm_rank(MPI_COMM_WORLD, &rank);\n    nCellThisRank = base + (rank < remainder ? 1 : 0);\n    MPI_Allgather(&nCellThisRank, 1, GetMPIDataType<idx_t>(), dist.data() + 1, 1, GetMPIDataType<idx_t>(), MPI_COMM_WORLD);\n    for (int iProc = 1; iProc < n + 1; ++iProc) { dist[iProc] += dist[iProc - 1]; }\n    return dist;\n}\n\nnamespace MeshCut\n{\nMetisCutter::MetisCutter() : bigMesh_(nullptr) {}\n\nMetisCutter::~MetisCutter() {}\n\nvoid MetisCutter::cut(int argc, char **argv)\n{\n    CmdLine cl{};\n    cl.regist<std::string, CmdLine::MustOffer>(\"m\", \"mesh\", \"mesh file name.\", \" \");\n    cl.regist<size_t, CmdLine::MustOffer>(\"np\", \"npart\", \"part number of sub-mesh.\", \" \");\n    cl.parse(argc, argv);\n\n    MPIAdapter::Initialize(&argc, &argv);\n#ifdef DEBUG_MODE\n    if (!MPIAdapter::isParallel() || (MPIAdapter::isParallel() && MPIAdapter::isMaster()))\n    {\n        std::cout << \"DEBUG_MODE: type any char to continue\\n\";\n        auto a = std::getchar();\n    }\n    MPIAdapter::Barrier();\n#endif\n    MPIAdapter::isParallel() ? this->cut_parmetis(cl.get<std::string>(\"mesh\"), cl.get<size_t>(\"npart\")) : this->cut_metis(cl.get<std::string>(\"mesh\"), cl.get<size_t>(\"npart\"));\n}\n\n// collect interface from all other threads\nvoid MetisCutter::collect_interface()\n{\n    // Pack interface data into a string for sending\n    auto packInterface = [&, this]() -> std::string\n    {\n        std::string sendStr;\n        for (auto ifile : outerFace_)\n        {\n            if (ifile.second.empty()) continue;\n\n            sendStr += (std::to_string(ifile.first) + \":\");\n            for (auto face : ifile.second) { sendStr += (std::to_string(face.first) + \";\"); }\n            sendStr += \"#\";\n        }\n\n        return sendStr;\n    };\n\n    // Unpack received interface data\n    auto unpackInterface = [&, this](const std::string &recvStr)\n    {\n        for (auto ifile : stringSplit(recvStr, \"#\"))\n        {\n            if (ifile.empty()) continue;\n            auto cur = stringSplit(ifile, \":\");\n            if (cur.size() < 2) continue;\n            auto nbrFile = std::stoi(cur[0]);\n            if (ownerFile_.count(nbrFile) != 0) continue;\n\n            check(true, \" \", format(\"  Thread %d: recv %d interface of file %d\\n\", RANK, stringSplit(cur[1], \";\").size(), nbrFile));\n\n            auto &nbrOuterface = outerFace_[nbrFile];\n            for (auto faceHash : stringSplit(cur[1], \";\")) { \n                if (!faceHash.empty()) {\n                    nbrOuterface.insert({std::stoull(faceHash), {}});\n                }\n            }\n        }\n    };\n\n    MPIAdapter::Barrier();\n\n    std::string sendTmp = packInterface();\n    int sendCnt = sendTmp.size();\n\n\n[636 more lines in file. Use offset=101 to continue.]"}],"isError":false,"timestamp":1772615124822}}
