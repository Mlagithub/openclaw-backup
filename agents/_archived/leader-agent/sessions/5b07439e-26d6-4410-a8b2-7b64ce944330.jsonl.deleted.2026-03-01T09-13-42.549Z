{"type":"message","id":"775753f9","parentId":"9d357863","timestamp":"2026-03-01T08:22:03.152Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Now let me create the validator_base.py","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"tool-106c8d80003f4544a046960b4145a315","name":"exec","arguments":{"command":"cat > /home/one/.openclaw/skills/team-vsdd/core/validator_base.py << 'ENDOFFILE'\n\"\"\"\n验证器基类\n\n提供领域验证的基础框架：\n- 文档验证\n- 结构验证\n- 领域特定验证规则\n\"\"\"\n\nimport re\nfrom pathlib import Path\nfrom typing import Dict, Any, List, Optional, Callable\nfrom dataclasses import dataclass\n\n\n@dataclass\nclass ValidationResult:\n    \"\"\"验证结果\"\"\"\n    valid: bool\n    phase: str\n    errors: List[str]\n    warnings: List[str]\n    score: float = 0.0\n\n\nclass DocumentValidator:\n    \"\"\"文档验证器\n    \n    验证文档的基本结构和内容。\n    \"\"\"\n    \n    # 必需章节定义\n    REQUIRED_SECTIONS = {\n        'spec': ['功能描述', '接口设计', '约束条件'],\n        'test_design': ['测试策略', '测试用例'],\n        'test_impl': ['测试框架', '测试代码'],\n        'design': ['架构设计', '模块设计'],\n        'code_impl': ['修改文件清单', '关键代码实现'],\n        'adversarial': ['审查范围', '发现的问题'],\n        'verify': ['验证范围', '验证结果'],\n        'docs': ['简介', '使用']\n    }\n    \n    # 推荐章节定义\n    RECOMMENDED_SECTIONS = {\n        'spec': ['验证属性', '输入/输出'],\n        'test_design': ['边界用例', '异常用例'],\n        'test_impl': ['测试执行'],\n        'design': ['数据结构', '算法设计'],\n        'code_impl': ['设计对应关系', '测试验证'],\n        'adversarial': ['安全审查', '性能审查'],\n        'verify': ['测试覆盖', '结论'],\n        'docs': ['安装', 'API 文档']\n    }\n    \n    def validate(self, phase: str, content: str) -> ValidationResult:\n        \"\"\"验证文档\n        \n        Args:\n            phase: Phase 名称\n            content: 文档内容\n        \"\"\"\n        errors = []\n        warnings = []\n        \n        # 检查文档非空\n        if not content or not content.strip():\n            errors.append(\"文档内容为空\")\n            return ValidationResult(\n                valid=False,\n                phase=phase,\n                errors=errors,\n                warnings=warnings\n            )\n        \n        # 检查必需章节\n        required = self.REQUIRED_SECTIONS.get(phase, [])\n        for section in required:\n            if section not in content:\n                errors.append(f\"缺少必需章节: {section}\")\n        \n        # 检查推荐章节\n        recommended = self.RECOMMENDED_SECTIONS.get(phase, [])\n        for section in recommended:\n            if section not in content:\n                warnings.append(f\"建议添加章节: {section}\")\n        \n        # 计算评分\n        total_sections = len(required) + len(recommended)\n        found_sections = total_sections - len(errors) - len(warnings)\n        score = found_sections / total_sections if total_sections > 0 else 1.0\n        \n        return ValidationResult(\n            valid=len(errors) == 0,\n            phase=phase,\n            errors=errors,\n            warnings=warnings,\n            score=score\n        )\n\n\nclass DomainValidator:\n    \"\"\"领域验证器\n    \n    根据领域特定规则验证文档。\n    \"\"\"\n    \n    def __init__(self, rules: Optional[Dict[str, Any]] = None):\n        \"\"\"初始化领域验证器\n        \n        Args:\n            rules: 领域验证规则\n        \"\"\"\n        self.rules = rules or {}\n        self.doc_validator = DocumentValidator()\n        \n        # 注册领域特定验证器\n        self.domain_validators: Dict[str, Callable] = {}\n    \n    def register_validator(self, phase: str, validator: Callable):\n        \"\"\"注册 Phase 验证器\n        \n        Args:\n            phase: Phase 名称\n            validator: 验证函数\n        \"\"\"\n        self.domain_validators[phase] = validator\n    \n    def validate(self, phase: str, doc_path: Path) -> ValidationResult:\n        \"\"\"验证文档\n        \n        Args:\n            phase: Phase 名称\n            doc_path: 文档路径\n        \"\"\"\n        if not doc_path.exists():\n            return ValidationResult(\n                valid=False,\n                phase=phase,\n                errors=[f\"文档不存在: {doc_path}\"],\n                warnings=[]\n            )\n        \n        content = doc_path.read_text(encoding='utf-8')\n        \n        # 基本文档验证\n        result = self.doc_validator.validate(phase, content)\n        \n        # 应用领域特定验证\n        if phase in self.domain_validators:\n            domain_result = self.domain_validators[phase](content, self.rules)\n            result.errors.extend(domain_result.get('errors', []))\n            result.warnings.extend(domain_result.get('warnings', []))\n            result.valid = result.valid and len(domain_result.get('errors', [])) == 0\n        \n        return result\n    \n    def validate_with_rules(self, phase: str, content: str) -> ValidationResult:\n        \"\"\"根据领域规则验证内容\n        \n        Args:\n            phase: Phase 名称\n            content: 文档内容\n        \"\"\"\n        result = self.doc_validator.validate(phase, content)\n        \n        # 检查测试重点\n        if phase == 'test_design':\n            test_focus = self.rules.get('test_focus', [])\n            if test_focus:\n                for focus in test_focus:\n                    if focus not in content:\n                        result.warnings.append(f\"测试设计未覆盖测试重点: {focus}\")\n        \n        # 检查审查重点\n        if phase == 'adversarial':\n            adversarial_checks = self.rules.get('adversarial_checks', [])\n            if adversarial_checks:\n                for check in adversarial_checks:\n                    if check not in content:\n                        result.warnings.append(f\"对抗审查未检查: {check}\")\n        \n        return result\n\n\nclass CodeValidator:\n    \"\"\"代码验证器\n    \n    验证代码实现文档中的代码片段。\n    \"\"\"\n    \n    # 支持的语言\n    LANGUAGE_PATTERNS = {\n        'python': r'```python\\s*\\n(.*?)\\n```',\n        'javascript': r'```javascript\\s*\\n(.*?)\\n```',\n        'typescript': r'```typescript\\s*\\n(.*?)\\n```',\n        'c': r'```c\\s*\\n(.*?)\\n```',\n        'cpp': r'```cpp\\s*\\n(.*?)\\n```',\n        'java': r'```java\\s*\\n(.*?)\\n```',\n        'go': r'```go\\s*\\n(.*?)\\n```',\n        'rust': r'```rust\\s*\\n(.*?)\\n```',\n        'bash': r'```bash\\s*\\n(.*?)\\n```',\n    }\n    \n    def extract_code_blocks(self, content: str, language: Optional[str] = None) -> List[Dict[str, str]]:\n        \"\"\"提取代码块\n        \n        Args:\n            content: 文档内容\n            language: 特定语言，None 表示所有语言\n        \"\"\"\n        code_blocks = []\n        \n        if language:\n            patterns = {language: self.LANGUAGE_PATTERNS.get(language)}\n        else:\n            patterns = self.LANGUAGE_PATTERNS\n        \n        for lang, pattern in patterns.items():\n            if not pattern:\n                continue\n            \n            matches = re.findall(pattern, content, re.DOTALL)\n            for i, code in enumerate(matches):\n                code_blocks.append({\n                    'language': lang,\n                    'code': code,\n                    'index': i\n                })\n        \n        return code_blocks\n    \n    def validate_code_block(self, code: str, language: str) -> Dict[str, Any]:\n        \"\"\"验证代码块基本正确性\n        \n        Args:\n            code: 代码内容\n            language: 编程语言\n        \"\"\"\n        issues = []\n        \n        # 检查基本语法模式\n        if language == 'python':\n            # 检查缩进一致性\n            lines = code.split('\\n')\n            indent_chars = set()\n            for line in lines:\n                if line and not line[0].isspace():\n                    continue\n                if line.startswith(' '):\n                    indent_chars.add('space')\n                elif line.startswith('\\t'):\n                    indent_chars.add('tab')\n            \n            if len(indent_chars) > 1:\n                issues.append(\"Python 代码混用空格和制表符缩进\")\n        \n        # 检查括号匹配\n        brackets = {'(': ')', '[': ']', '{': '}'}\n        stack = []\n        for char in code:\n            if char in brackets:\n                stack.append(char)\n            elif char in brackets.values():\n                if not stack:\n                    issues.append(\"检测到未匹配的右括号\")\n                    break\n                if brackets[stack[-1]] != char:\n                    issues.append(\"检测到括号类型不匹配\")\n                    break\n                stack.pop()\n        \n        if stack:\n            issues.append(\"检测到未匹配的左括号\")\n        \n        return {\n            'valid': len(issues) == 0,\n            'issues': issues\n        }\n\n\nclass TestValidator:\n    \"\"\"测试验证器\n    \n    验证测试文档和测试覆盖。\n    \"\"\"\n    \n    def validate_test_design(self, content: str) -> ValidationResult:\n        \"\"\"验证测试设计文档\n        \n        Args:\n            content: 文档内容\n        \"\"\"\n        errors = []\n        warnings = []\n        \n        # 检查测试用例表格\n        table_pattern = r'\\|.*\\|.*\\|'\n        tables = re.findall(table_pattern, content)\n        \n        if len(tables) < 3:\n            warnings.append(\"测试用例表格数量较少，建议增加更多测试用例\")\n        \n        # 检查测试类型覆盖\n        test_types = ['正常用例', '边界用例', '异常用例']\n        for test_type in test_types:\n            if test_type not in content:\n                warnings.append(f\"缺少 {test_type} 章节\")\n        \n        return ValidationResult(\n            valid=len(errors) == 0,\n            phase='test_design',\n            errors=errors,\n            warnings=warnings\n        )\n    \n    def calculate_coverage(\n        self,\n        spec_content: str,\n        test_content: str\n    ) -> Dict[str, Any]:\n        \"\"\"计算测试覆盖\n        \n        Args:\n            spec_content: 规格文档内容\n            test_content: 测试文档内容\n        \"\"\"\n        # 从规格中提取功能点\n        spec_features = self._extract_features(spec_content)\n        \n        # 从测试中提取测试点\n        test_features = self._extract_features(test_content)\n        \n        # 计算覆盖\n        covered = []\n        not_covered = []\n        \n        for feature in spec_features:\n            # 简单的关键词匹配\n            keywords = feature.lower().split()\n            found = any(\n                all(kw in test_content.lower() for kw in keywords)\n                for _ in [1]\n            )\n            \n            if found:\n                covered.append(feature)\n            else:\n                not_covered.append(feature)\n        \n        coverage_rate = len(covered) / len(spec_features) if spec_features else 1.0\n        \n        return {\n            'total_features': len(spec_features),\n            'covered': len(covered),\n            'not_covered': len(not_covered),\n            'coverage_rate': coverage_rate,\n            'covered_features': covered,\n            'missing_features': not_covered\n        }\n    \n    def _extract_features(self, content: str) -> List[str]:\n        \"\"\"提取功能点\"\"\"\n        features = []\n        \n        # 查找列表项\n        list_pattern = r'^\\s*[-*]\\s+(.+)$'\n        matches = re.findall(list_pattern, content, re.MULTILINE)\n        features.extend(matches)\n        \n        # 查找标题\n        header_pattern = r'^#+\\s+(.+)$'\n        matches = re.findall(header_pattern, content, re.MULTILINE)\n        features.extend(matches)\n        \n        return features\nENDOFFILE"}}],"api":"openai-completions","provider":"bailian","model":"glm-5","usage":{"input":32621,"output":2543,"cacheRead":127,"cacheWrite":0,"totalTokens":35291,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772353223055}}
