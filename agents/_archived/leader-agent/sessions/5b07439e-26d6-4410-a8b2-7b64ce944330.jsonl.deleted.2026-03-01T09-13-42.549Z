{"type":"message","id":"e37d28f9","parentId":"a8f21aa3","timestamp":"2026-03-01T08:18:03.203Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"好，orchestrator.py 创建成功。现在继续创建其他核心组件。","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"tool-54d9779ff923441a8ff184f714e94168","name":"exec","arguments":{"command":"cat > /home/one/.openclaw/skills/team-vsdd/core/phase_manager.py << 'ENDOFFILE'\n\"\"\"\nPhase 管理器\n\n管理 VSDD 流程中的各个阶段，包括：\n- Phase 准备和验证\n- 输入输出文档管理\n- 领域特定验证\n\"\"\"\n\nimport json\nfrom pathlib import Path\nfrom typing import Dict, Any, List, Optional\nfrom dataclasses import dataclass\n\n\n@dataclass\nclass PhaseInfo:\n    \"\"\"Phase 信息\"\"\"\n    name: str\n    description: str\n    input_docs: List[str]\n    output_doc: str\n    agent: str\n    template: str\n    validation_rules: Dict[str, Any]\n\n\nclass PhaseManager:\n    \"\"\"Phase 管理器\n    \n    管理 VSDD 流程中的各个阶段。\n    \"\"\"\n    \n    # Phase 定义\n    PHASES = {\n        'spec': {\n            'description': '功能规格定义',\n            'agent': 'design-agent',\n            'dependencies': []\n        },\n        'test_design': {\n            'description': '测试设计',\n            'agent': 'test-agent',\n            'dependencies': ['spec']\n        },\n        'test_impl': {\n            'description': '测试实现',\n            'agent': 'code-agent',\n            'dependencies': ['spec', 'test_design']\n        },\n        'design': {\n            'description': '详细设计',\n            'agent': 'design-agent',\n            'dependencies': ['spec', 'test_design']\n        },\n        'code_impl': {\n            'description': '代码实现',\n            'agent': 'code-agent',\n            'dependencies': ['design', 'test_impl']\n        },\n        'adversarial': {\n            'description': '对抗审查',\n            'agent': 'review-agent',\n            'dependencies': ['spec', 'test_design', 'test_impl', 'design', 'code_impl']\n        },\n        'verify': {\n            'description': '形式化验证',\n            'agent': 'verify-agent',\n            'dependencies': ['design', 'code_impl', 'spec']\n        },\n        'docs': {\n            'description': '文档整合',\n            'agent': 'docs-agent',\n            'dependencies': ['spec', 'design', 'code_impl', 'adversarial']\n        }\n    }\n    \n    def __init__(self, domain, workspace: Path):\n        \"\"\"初始化 Phase 管理器\n        \n        Args:\n            domain: 领域配置\n            workspace: 工作空间路径\n        \"\"\"\n        self.domain = domain\n        self.workspace = Path(workspace)\n        self.docs_dir = self.workspace / 'docs'\n        self.docs_dir.mkdir(parents=True, exist_ok=True)\n    \n    def get_phase_order(self) -> List[str]:\n        \"\"\"获取 Phase 执行顺序\"\"\"\n        # 拓扑排序确保依赖正确\n        ordered = []\n        visited = set()\n        temp_visited = set()\n        \n        def visit(phase: str):\n            if phase in temp_visited:\n                raise ValueError(f\"检测到循环依赖: {phase}\")\n            if phase in visited:\n                return\n            \n            temp_visited.add(phase)\n            \n            for dep in self.PHASES.get(phase, {}).get('dependencies', []):\n                visit(dep)\n            \n            temp_visited.remove(phase)\n            visited.add(phase)\n            ordered.append(phase)\n        \n        for phase in self.PHASES:\n            visit(phase)\n        \n        return ordered\n    \n    def prepare_phase(self, phase_name: str) -> Dict[str, Any]:\n        \"\"\"准备 Phase 执行\n        \n        Args:\n            phase_name: Phase 名称\n        \"\"\"\n        if phase_name not in self.PHASES:\n            raise ValueError(f\"未知的 Phase: {phase_name}\")\n        \n        phase_def = self.PHASES[phase_name]\n        \n        # 检查依赖\n        missing_deps = []\n        for dep in phase_def.get('dependencies', []):\n            dep_doc = self.domain.get_output_doc(dep)\n            dep_path = self.docs_dir / dep_doc\n            if not dep_path.exists():\n                missing_deps.append(dep)\n        \n        if missing_deps:\n            raise ValueError(f\"Phase {phase_name} 缺少依赖: {missing_deps}\")\n        \n        # 准备 Phase 信息\n        return {\n            'name': phase_name,\n            'description': phase_def['description'],\n            'input_docs': self.domain.get_input_docs(phase_name),\n            'output_doc': self.domain.get_output_doc(phase_name),\n            'agent': phase_def['agent'],\n            'template': self.domain.get_template(phase_name),\n            'validation_rules': self.domain.validation_rules\n        }\n    \n    def validate_output(self, phase_name: str, doc_path: Path) -> bool:\n        \"\"\"验证 Phase 输出\n        \n        Args:\n            phase_name: Phase 名称\n            doc_path: 输出文档路径\n        \"\"\"\n        if not doc_path.exists():\n            return False\n        \n        # 检查文档非空\n        content = doc_path.read_text(encoding='utf-8').strip()\n        if not content:\n            return False\n        \n        # 基本结构验证\n        required_sections = self._get_required_sections(phase_name)\n        for section in required_sections:\n            if section not in content:\n                print(f\"警告: 缺少章节 '{section}'\")\n        \n        return True\n    \n    def _get_required_sections(self, phase_name: str) -> List[str]:\n        \"\"\"获取 Phase 必需的章节\"\"\"\n        required = {\n            'spec': ['# Spec:', '## 1.', '## 2.'],\n            'test_design': ['# Test Design:', '## 1.', '## 2.'],\n            'test_impl': ['# Test Implementation:', '## 1.', '## 2.'],\n            'design': ['# Design:', '## 1.', '## 2.'],\n            'code_impl': ['# Code Implementation:', '## 1.', '## 2.'],\n            'adversarial': ['# Adversarial Review:', '## 1.', '## 2.'],\n            'verify': ['# Verification Report:', '## 1.', '## 2.'],\n            'docs': ['# README', '## ']\n        }\n        return required.get(phase_name, [])\n    \n    def get_phase_status(self, phase_name: str) -> Dict[str, Any]:\n        \"\"\"获取 Phase 状态\n        \n        Args:\n            phase_name: Phase 名称\n        \"\"\"\n        output_doc = self.domain.get_output_doc(phase_name)\n        output_path = self.docs_dir / output_doc\n        \n        return {\n            'name': phase_name,\n            'description': self.PHASES.get(phase_name, {}).get('description', ''),\n            'completed': output_path.exists(),\n            'output_doc': str(output_path) if output_path.exists() else None,\n            'dependencies': self.PHASES.get(phase_name, {}).get('dependencies', [])\n        }\n    \n    def list_phases(self) -> List[Dict[str, Any]]:\n        \"\"\"列出所有 Phase 及其状态\"\"\"\n        return [self.get_phase_status(phase) for phase in self.get_phase_order()]\nENDOFFILE"}}],"api":"openai-completions","provider":"bailian","model":"glm-5","usage":{"input":4764,"output":1525,"cacheRead":20599,"cacheWrite":0,"totalTokens":26888,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772353048861}}
