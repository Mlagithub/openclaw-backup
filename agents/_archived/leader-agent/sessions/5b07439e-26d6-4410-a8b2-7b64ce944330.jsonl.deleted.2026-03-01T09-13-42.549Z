{"type":"message","id":"a715c19c","parentId":"da1edf0d","timestamp":"2026-03-01T08:17:28.839Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Good, that worked. Now I need to create the other core files using the same approach. Let me create them one by one.","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"tool-ce6bf362e1c0458bbac7a61241e2b9b3","name":"exec","arguments":{"command":"cat > /home/one/.openclaw/skills/team-vsdd/core/orchestrator.py << 'ENDOFFILE'\n\"\"\"\nVSDD 流程编排器\n\n领域无关的 VSDD 流程编排，负责：\n- 加载领域配置\n- 执行 VSDD 流程\n- 协调各组件工作\n\"\"\"\n\nimport json\nimport os\nfrom pathlib import Path\nfrom typing import Optional, Dict, Any, List\nfrom dataclasses import dataclass, field\n\nfrom .phase_manager import PhaseManager\nfrom .agent_dispatcher import AgentDispatcher\nfrom .traceability import TraceabilitySystem\nfrom .document_manager import DocumentManager\n\n\n@dataclass\nclass DomainConfig:\n    \"\"\"领域配置\"\"\"\n    name: str\n    description: str\n    path: Path\n    templates: Dict[str, str] = field(default_factory=dict)\n    validation_rules: Dict[str, Any] = field(default_factory=dict)\n    phases: List[str] = field(default_factory=lambda: [\n        'spec', 'test_design', 'test_impl', 'design',\n        'code_impl', 'adversarial', 'verify', 'docs'\n    ])\n    formal_verification: Dict[str, Any] = field(default_factory=dict)\n    \n    @classmethod\n    def load(cls, domain_name_or_path: str, base_path: Optional[Path] = None) -> 'DomainConfig':\n        \"\"\"加载领域配置\n        \n        Args:\n            domain_name_or_path: 领域名称或自定义路径\n            base_path: 基础路径（内置领域的根目录）\n        \"\"\"\n        if base_path is None:\n            base_path = Path(__file__).parent.parent / 'domains'\n        \n        # 判断是自定义路径还是内置领域\n        if domain_name_or_path.startswith('/') or domain_name_or_path.startswith('./'):\n            domain_path = Path(domain_name_or_path)\n        else:\n            domain_path = base_path / domain_name_or_path\n        \n        config_file = domain_path / 'domain_config.json'\n        \n        if not config_file.exists():\n            # 返回默认配置\n            return cls(\n                name=domain_name_or_path,\n                description=f\"默认领域配置: {domain_name_or_path}\",\n                path=domain_path\n            )\n        \n        with open(config_file, 'r', encoding='utf-8') as f:\n            config = json.load(f)\n        \n        return cls(\n            name=config.get('domain', domain_name_or_path),\n            description=config.get('description', ''),\n            path=domain_path,\n            templates=config.get('templates', {}),\n            validation_rules=config.get('validation_rules', {}),\n            phases=config.get('phases', ['spec', 'test_design', 'test_impl', 'design',\n                                        'code_impl', 'adversarial', 'verify', 'docs']),\n            formal_verification=config.get('formal_verification', {})\n        )\n    \n    def get_template(self, phase_name: str) -> str:\n        \"\"\"获取指定 Phase 的模板\"\"\"\n        template_rel_path = self.templates.get(phase_name)\n        if not template_rel_path:\n            return self._get_default_template(phase_name)\n        \n        template_path = self.path / template_rel_path\n        if template_path.exists():\n            with open(template_path, 'r', encoding='utf-8') as f:\n                return f.read()\n        \n        return self._get_default_template(phase_name)\n    \n    def _get_default_template(self, phase_name: str) -> str:\n        \"\"\"获取默认模板\"\"\"\n        default_templates = {\n            'spec': '''# Spec: [模块名称]\n\n## 1. 功能描述\n[这个模块做什么]\n\n## 2. 接口设计\n\n### 2.1 函数/接口签名\n```\n[接口定义]\n```\n\n### 2.2 参数说明\n| 参数 | 类型 | 说明 | 约束 |\n|------|------|------|------|\n| ... | ... | ... | ... |\n\n## 3. 输入/输出\n[输入输出描述]\n\n## 4. 约束条件\n[前置条件、后置条件、不变量]\n\n## 5. 验证属性\n[需要验证的性质]\n''',\n            'test_design': '''# Test Design: [模块名称]\n\n## 1. 测试策略\n[测试整体策略]\n\n## 2. 测试用例\n\n### 2.1 正常用例\n| ID | 描述 | 输入 | 期望输出 |\n|----|------|------|----------|\n| ... | ... | ... | ... |\n\n### 2.2 边界用例\n| ID | 描述 | 输入 | 期望输出 |\n|----|------|------|----------|\n| ... | ... | ... | ... |\n\n### 2.3 异常用例\n| ID | 描述 | 输入 | 期望输出 |\n|----|------|------|----------|\n| ... | ... | ... | ... |\n\n## 3. 测试覆盖\n[覆盖目标]\n''',\n            'test_impl': '''# Test Implementation: [模块名称]\n\n## 1. 测试框架\n[使用的测试框架]\n\n## 2. 测试代码\n\n### 2.1 测试文件清单\n| 文件路径 | 说明 |\n|---------|------|\n| ... | ... |\n\n### 2.2 关键测试代码\n```\n[测试代码]\n```\n\n## 3. 测试执行\n[执行命令和结果]\n''',\n            'design': '''# Design: [模块名称]\n\n## 1. 架构设计\n[整体架构描述]\n\n## 2. 模块设计\n\n### 2.1 模块清单\n| 模块名 | 职责 | 接口 |\n|--------|------|------|\n| ... | ... | ... |\n\n### 2.2 模块依赖\n[模块间依赖关系]\n\n## 3. 数据结构\n[关键数据结构设计]\n\n## 4. 算法设计\n[核心算法描述]\n\n## 5. 接口详细设计\n[接口详细定义]\n''',\n            'code_impl': '''# Code Implementation: [模块名称]\n\n## 1. 修改文件清单\n\n### 1.1 新增文件\n| 文件路径 | 语言 | 说明 |\n|---------|------|------|\n| ... | ... | ... |\n\n### 1.2 修改文件\n| 文件路径 | 修改类型 | 说明 |\n|---------|---------|------|\n| ... | ... | ... |\n\n## 2. 关键代码实现\n\n### 2.1 [文件名]\n```\n[代码片段 + 注释]\n```\n\n## 3. 设计对应关系\n| 设计文档条目 | 实现位置 | 状态 |\n|-------------|---------|------|\n| ... | ... | ... |\n\n## 4. 测试验证\n[测试结果]\n''',\n            'adversarial': '''# Adversarial Review: [模块名称]\n\n## 1. 审查范围\n[审查的文档和代码范围]\n\n## 2. 发现的问题\n\n### 2.1 高优先级\n| ID | 问题 | 位置 | 建议 |\n|----|------|------|------|\n| ... | ... | ... | ... |\n\n### 2.2 中优先级\n| ID | 问题 | 位置 | 建议 |\n|----|------|------|------|\n| ... | ... | ... | ... |\n\n### 2.3 低优先级\n| ID | 问题 | 位置 | 建议 |\n|----|------|------|------|\n| ... | ... | ... | ... |\n\n## 3. 安全审查\n[安全相关发现]\n\n## 4. 性能审查\n[性能相关发现]\n\n## 5. 总结\n[审查结论]\n''',\n            'verify': '''# Verification Report: [模块名称]\n\n## 1. 验证范围\n[验证的功能和代码范围]\n\n## 2. 验证结果\n\n### 2.1 静态分析\n| 工具 | 结果 | 问题数 |\n|------|------|--------|\n| ... | ... | ... |\n\n### 2.2 形式化验证\n| 属性 | 状态 | 说明 |\n|------|------|------|\n| ... | ... | ... |\n\n## 3. 测试覆盖\n[测试覆盖率报告]\n\n## 4. 结论\n[验证结论]\n''',\n            'docs': '''# README: [项目名称]\n\n## 简介\n[项目简介]\n\n## 功能特性\n[功能列表]\n\n## 安装\n[安装说明]\n\n## 使用\n[使用说明]\n\n## API 文档\n[API 文档]\n\n## 开发\n[开发指南]\n\n## 许可证\n[许可证信息]\n'''\n        }\n        return default_templates.get(phase_name, '')\n    \n    def get_input_docs(self, phase_name: str) -> List[str]:\n        \"\"\"获取 Phase 的输入文档列表\"\"\"\n        phase_inputs = {\n            'spec': [],\n            'test_design': ['spec.md'],\n            'test_impl': ['spec.md', 'test_design.md'],\n            'design': ['spec.md', 'test_design.md'],\n            'code_impl': ['design.md', 'test_impl.md'],\n            'adversarial': ['spec.md', 'test_design.md', 'test_impl.md',\n                           'design.md', 'code_impl.md'],\n            'verify': ['design.md', 'code_impl.md', 'spec.md'],\n            'docs': ['spec.md', 'design.md', 'code_impl.md', 'review_report.md']\n        }\n        return phase_inputs.get(phase_name, [])\n    \n    def get_output_doc(self, phase_name: str) -> str:\n        \"\"\"获取 Phase 的输出文档名\"\"\"\n        phase_outputs = {\n            'spec': 'spec.md',\n            'test_design': 'test_design.md',\n            'test_impl': 'test_impl.md',\n            'design': 'design.md',\n            'code_impl': 'code_impl.md',\n            'adversarial': 'review_report.md',\n            'verify': 'verification_report.md',\n            'docs': 'README.md'\n        }\n        return phase_outputs.get(phase_name, f'{phase_name}.md')\n\n\nclass VSDDOrchestrator:\n    \"\"\"VSDD 流程编排器\n    \n    领域无关的 VSDD 流程编排，协调 Phase 管理、Agent 调度、\n    文档管理和追踪系统。\n    \"\"\"\n    \n    def __init__(\n        self,\n        project_name: str,\n        domain: str,\n        workspace: Optional[Path] = None,\n        config: Optional[Dict[str, Any]] = None\n    ):\n        \"\"\"初始化编排器\n        \n        Args:\n            project_name: 项目名称\n            domain: 领域名称或自定义路径\n            workspace: 工作空间路径\n            config: 配置字典\n        \"\"\"\n        self.project_name = project_name\n        self.domain = DomainConfig.load(domain)\n        \n        # 设置工作空间\n        if workspace is None:\n            workspace = Path.cwd() / '.vsdd' / project_name\n        self.workspace = Path(workspace)\n        self.workspace.mkdir(parents=True, exist_ok=True)\n        \n        # 加载配置\n        self.config = config or {}\n        \n        # 初始化组件\n        self.phase_manager = PhaseManager(\n            domain=self.domain,\n            workspace=self.workspace\n        )\n        self.agent_dispatcher = AgentDispatcher(\n            config=self.config.get('agents', {})\n        )\n        self.doc_manager = DocumentManager(\n            workspace=self.workspace,\n            project_name=project_name\n        )\n        self.traceability = TraceabilitySystem(\n            db_path=self.workspace / '.vsdd' / 'traceability.json'\n        )\n        \n        # 状态文件\n        self.state_file = self.workspace / '.vsdd' / 'state.json'\n        self.state = self._load_state()\n    \n    def _load_state(self) -> Dict[str, Any]:\n        \"\"\"加载状态\"\"\"\n        if self.state_file.exists():\n            with open(self.state_file, 'r', encoding='utf-8') as f:\n                return json.load(f)\n        return {\n            'project_name': self.project_name,\n            'domain': self.domain.name,\n            'completed_phases': [],\n            'current_phase': None,\n            'goal': None\n        }\n    \n    def _save_state(self):\n        \"\"\"保存状态\"\"\"\n        self.state_file.parent.mkdir(parents=True, exist_ok=True)\n        with open(self.state_file, 'w', encoding='utf-8') as f:\n            json.dump(self.state, f, indent=2, ensure_ascii=False)\n    \n    def init_project(self, goal: str) -> bool:\n        \"\"\"初始化项目\n        \n        Args:\n            goal: 项目目标/需求描述\n        \"\"\"\n        self.state['goal'] = goal\n        self.state['completed_phases'] = []\n        self.state['current_phase'] = None\n        self._save_state()\n        \n        # 初始化追踪系统\n        self.traceability.init_project(self.project_name, goal)\n        \n        return True\n    \n    def run_pipeline(\n        self,\n        phases: Optional[List[str]] = None,\n        start_from: Optional[str] = None\n    ) -> bool:\n        \"\"\"执行完整 VSDD 流程\n        \n        Args:\n            phases: 要执行的 Phase 列表，默认执行所有\n            start_from: 从指定 Phase 开始执行\n        \"\"\"\n        if phases is None:\n            phases = self.domain.phases\n        \n        # 如果指定了起始 Phase，跳过之前的\n        if start_from:\n            start_idx = phases.index(start_from) if start_from in phases else 0\n            phases = phases[start_idx:]\n        \n        for phase_name in phases:\n            if not self.should_run_phase(phase_name):\n                print(f\"跳过 Phase: {phase_name}\")\n                continue\n            \n            print(f\"\\n{'='*60}\")\n            print(f\"执行 Phase: {phase_name}\")\n            print(f\"{'='*60}\")\n            \n            success = self.run_phase(phase_name)\n            \n            if not success:\n                print(f\"Phase {phase_name} 失败\")\n                return False\n            \n            self.state['completed_phases'].append(phase_name)\n            self._save_state()\n        \n        print(f\"\\n{'='*60}\")\n        print(\"VSDD 流程完成!\")\n        print(f\"{'='*60}\")\n        \n        return True\n    \n    def should_run_phase(self, phase_name: str) -> bool:\n        \"\"\"判断是否应该执行该 Phase\"\"\"\n        # 检查是否已完成\n        if phase_name in self.state.get('completed_phases', []):\n            return False\n        \n        # 检查依赖是否满足\n        input_docs = self.domain.get_input_docs(phase_name)\n        for doc in input_docs:\n            doc_path = self.workspace / 'docs' / doc\n            if not doc_path.exists():\n                return False\n        \n        return True\n    \n    def run_phase(self, phase_name: str) -> bool:\n        \"\"\"执行单个 Phase\n        \n        Args:\n            phase_name: Phase 名称\n        \"\"\"\n        # 1. 准备 Phase\n        phase_info = self.phase_manager.prepare_phase(phase_name)\n        \n        # 2. 构造 prompt\n        prompt = self.build_prompt(phase_name, phase_info)\n        \n        # 3. 调用 Agent\n        agent_id = self.get_agent_for_phase(phase_name)\n        output = self.agent_dispatcher.dispatch(agent_id, prompt)\n        \n        if not output:\n            return False\n        \n        # 4. 保存文档\n        doc_path = self.doc_manager.save_document(phase_name, output)\n        \n        # 5. 验证文档\n        if not self.phase_manager.validate_output(phase_name, doc_path):\n            print(f\"Phase {phase_name} 输出验证失败\")\n            return False\n        \n        # 6. 记录追踪\n        self.traceability.record_phase(\n            project=self.project_name,\n            phase=phase_name,\n            input_docs=self.domain.get_input_docs(phase_name),\n            output_doc=self.domain.get_output_doc(phase_name),\n            agent=agent_id\n        )\n        \n        return True\n    \n    def build_prompt(self, phase_name: str, phase_info: Dict[str, Any]) -> str:\n        \"\"\"构建 Agent prompt\n        \n        Args:\n            phase_name: Phase 名称\n            phase_info: Phase 信息\n        \"\"\"\n        prompt_parts = []\n        \n        # 添加项目目标\n        if self.state.get('goal'):\n            prompt_parts.append(f\"# 项目目标\\n\\n{self.state['goal']}\\n\")\n        \n        # 添加任务描述\n        prompt_parts.append(f\"\\n# 任务: {phase_name}\\n\")\n        \n        # 添加输入文档\n        input_docs = self.domain.get_input_docs(phase_name)\n        for doc_name in input_docs:\n            doc_content = self.doc_manager.read_document(doc_name)\n            if doc_content:\n                prompt_parts.append(f\"\\n## 输入文档: {doc_name}\\n\\n{doc_content}\\n\")\n        \n        # 添加输出模板\n        template = self.domain.get_template(phase_name)\n        if template:\n            prompt_parts.append(f\"\\n## 输出模板\\n\\n请按照以下模板格式输出:\\n\\n{template}\\n\")\n        \n        # 添加领域特定指导\n        domain_guidance = self._get_domain_guidance(phase_name)\n        if domain_guidance:\n            prompt_parts.append(f\"\\n## 领域指导 ({self.domain.name})\\n\\n{domain_guidance}\\n\")\n        \n        return \"\\n\".join(prompt_parts)\n    \n    def _get_domain_guidance(self, phase_name: str) -> str:\n        \"\"\"获取领域特定指导\"\"\"\n        rules = self.domain.validation_rules\n        \n        if not rules:\n            return \"\"\n        \n        guidance_parts = []\n        \n        if phase_name == 'test_design' and 'test_focus' in rules:\n            guidance_parts.append(f\"测试重点: {', '.join(rules['test_focus'])}\")\n        \n        if phase_name == 'adversarial' and 'adversarial_checks' in rules:\n            guidance_parts.append(f\"审查重点: {', '.join(rules['adversarial_checks'])}\")\n        \n        if phase_name == 'verify':\n            verify_tools = rules.get('verify_tools', [])\n            if verify_tools:\n                guidance_parts.append(f\"验证工具: {', '.join(verify_tools)}\")\n            \n            perf_metrics = rules.get('performance_metrics', [])\n            if perf_metrics:\n                guidance_parts.append(f\"性能指标: {', '.join(perf_metrics)}\")\n        \n        return \"\\n\".join(guidance_parts)\n    \n    def get_agent_for_phase(self, phase_name: str) -> str:\n        \"\"\"获取 Phase 对应的 Agent\"\"\"\n        agent_mapping = {\n            'spec': 'design-agent',\n            'test_design': 'test-agent',\n            'test_impl': 'code-agent',\n            'design': 'design-agent',\n            'code_impl': 'code-agent',\n            'adversarial': 'review-agent',\n            'verify': 'verify-agent',\n            'docs': 'docs-agent'\n        }\n        return agent_mapping.get(phase_name, 'design-agent')\n    \n    def get_status(self) -> Dict[str, Any]:\n        \"\"\"获取项目状态\"\"\"\n        return {\n            'project_name': self.project_name,\n            'domain': self.domain.name,\n            'goal': self.state.get('goal'),\n            'completed_phases': self.state.get('completed_phases', []),\n            'current_phase': self.state.get('current_phase'),\n            'workspace': str(self.workspace)\n        }\n    \n    def get_traceability_matrix(self) -> Dict[str, Any]:\n        \"\"\"获取追踪矩阵\"\"\"\n        return self.traceability.get_matrix(self.project_name)\n\n\ndef main():\n    \"\"\"命令行入口\"\"\"\n    import argparse\n    \n    parser = argparse.ArgumentParser(description='VSDD 流程编排器')\n    subparsers = parser.add_subparsers(dest='command', help='子命令')\n    \n    # init 命令\n    init_parser = subparsers.add_parser('init', help='初始化项目')\n    init_parser.add_argument('project', help='项目名称')\n    init_parser.add_argument('--domain', '-d', default='industrial',\n                            help='领域名称或路径')\n    init_parser.add_argument('--goal', '-g', required=True,\n                            help='项目目标/需求描述')\n    init_parser.add_argument('--workspace', '-w',\n                            help='工作空间路径')\n    \n    # run 命令\n    run_parser = subparsers.add_parser('run', help='执行流程')\n    run_parser.add_argument('project', help='项目名称')\n    run_parser.add_argument('--domain', '-d', default='industrial',\n                            help='领域名称或路径')\n    run_parser.add_argument('--phase', '-p',\n                            help='执行单个 Phase')\n    run_parser.add_argument('--start-from',\n                            help='从指定 Phase 开始')\n    \n    # status 命令\n    status_parser = subparsers.add_parser('status', help='查看状态')\n    status_parser.add_argument('project', help='项目名称')\n    \n    # trace 命令\n    trace_parser = subparsers.add_parser('trace', help='生成追踪矩阵')\n    trace_parser.add_argument('project', help='项目名称')\n    \n    args = parser.parse_args()\n    \n    if args.command == 'init':\n        orchestrator = VSDDOrchestrator(\n            project_name=args.project,\n            domain=args.domain,\n            workspace=Path(args.workspace) if args.workspace else None\n        )\n        orchestrator.init_project(args.goal)\n        print(f\"项目 '{args.project}' 初始化完成\")\n        print(f\"工作空间: {orchestrator.workspace}\")\n        \n    elif args.command == 'run':\n        orchestrator = VSDDOrchestrator(\n            project_name=args.project,\n            domain=args.domain\n        )\n        if args.phase:\n            success = orchestrator.run_phase(args.phase)\n            print(f\"Phase {args.phase} {'成功' if success else '失败'}\")\n        else:\n            success = orchestrator.run_pipeline(start_from=args.start_from)\n            print(f\"流程 {'成功' if success else '失败'}\")\n            \n    elif args.command == 'status':\n        orchestrator = VSDDOrchestrator(\n            project_name=args.project,\n            domain='industrial'\n        )\n        status = orchestrator.get_status()\n        print(json.dumps(status, indent=2, ensure_ascii=False))\n        \n    elif args.command == 'trace':\n        orchestrator = VSDDOrchestrator(\n            project_name=args.project,\n            domain='industrial'\n        )\n        matrix = orchestrator.get_traceability_matrix()\n        print(json.dumps(matrix, indent=2, ensure_ascii=False))\n    \n    else:\n        parser.print_help()\n\n\nif __name__ == '__main__':\n    main()\nENDOFFILE"}}],"api":"openai-completions","provider":"bailian","model":"glm-5","usage":{"input":176,"output":4811,"cacheRead":20425,"cacheWrite":0,"totalTokens":25412,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772352949856}}
