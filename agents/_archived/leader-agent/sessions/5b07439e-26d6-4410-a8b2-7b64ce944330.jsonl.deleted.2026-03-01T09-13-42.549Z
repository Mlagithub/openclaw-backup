{"type":"message","id":"05e2cfab","parentId":"b7e29a0e","timestamp":"2026-03-01T08:20:23.037Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"继续创建 document_manager.py 和 validator_base.py","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"tool-faec2fca44364eabb04ee9905af738e4","name":"exec","arguments":{"command":"cat > /home/one/.openclaw/skills/team-vsdd/core/document_manager.py << 'ENDOFFILE'\n\"\"\"\n文档管理器\n\n管理 VSDD 流程中的所有文档：\n- 文档存储和检索\n- 版本管理\n- 文档格式验证\n\"\"\"\n\nimport json\nfrom pathlib import Path\nfrom typing import Dict, Any, List, Optional\nfrom datetime import datetime\nimport shutil\n\n\nclass DocumentManager:\n    \"\"\"文档管理器\n    \n    管理项目文档的存储、检索和版本控制。\n    \"\"\"\n    \n    def __init__(self, workspace: Path, project_name: str):\n        \"\"\"初始化文档管理器\n        \n        Args:\n            workspace: 工作空间路径\n            project_name: 项目名称\n        \"\"\"\n        self.workspace = Path(workspace)\n        self.project_name = project_name\n        self.docs_dir = self.workspace / 'docs'\n        self.versions_dir = self.workspace / '.vsdd' / 'versions'\n        \n        # 创建目录\n        self.docs_dir.mkdir(parents=True, exist_ok=True)\n        self.versions_dir.mkdir(parents=True, exist_ok=True)\n    \n    def save_document(\n        self,\n        phase: str,\n        content: str,\n        create_version: bool = True\n    ) -> Path:\n        \"\"\"保存文档\n        \n        Args:\n            phase: Phase 名称\n            content: 文档内容\n            create_version: 是否创建版本\n        \n        Returns:\n            文档路径\n        \"\"\"\n        # 确定文档名\n        doc_names = {\n            'spec': 'spec.md',\n            'test_design': 'test_design.md',\n            'test_impl': 'test_impl.md',\n            'design': 'design.md',\n            'code_impl': 'code_impl.md',\n            'adversarial': 'review_report.md',\n            'verify': 'verification_report.md',\n            'docs': 'README.md'\n        }\n        \n        doc_name = doc_names.get(phase, f'{phase}.md')\n        doc_path = self.docs_dir / doc_name\n        \n        # 如果已存在，先创建版本备份\n        if create_version and doc_path.exists():\n            self._create_version(doc_name)\n        \n        # 写入文档\n        doc_path.write_text(content, encoding='utf-8')\n        \n        return doc_path\n    \n    def read_document(self, doc_name: str) -> Optional[str]:\n        \"\"\"读取文档\n        \n        Args:\n            doc_name: 文档名称\n        \"\"\"\n        # 处理不带后缀的情况\n        if not doc_name.endswith('.md'):\n            doc_name = f\"{doc_name}.md\"\n        \n        doc_path = self.docs_dir / doc_name\n        \n        if not doc_path.exists():\n            return None\n        \n        return doc_path.read_text(encoding='utf-8')\n    \n    def get_document_path(self, phase: str) -> Path:\n        \"\"\"获取文档路径\n        \n        Args:\n            phase: Phase 名称\n        \"\"\"\n        doc_names = {\n            'spec': 'spec.md',\n            'test_design': 'test_design.md',\n            'test_impl': 'test_impl.md',\n            'design': 'design.md',\n            'code_impl': 'code_impl.md',\n            'adversarial': 'review_report.md',\n            'verify': 'verification_report.md',\n            'docs': 'README.md'\n        }\n        \n        doc_name = doc_names.get(phase, f'{phase}.md')\n        return self.docs_dir / doc_name\n    \n    def list_documents(self) -> List[Dict[str, Any]]:\n        \"\"\"列出所有文档\"\"\"\n        documents = []\n        \n        for doc_path in self.docs_dir.glob('*.md'):\n            stat = doc_path.stat()\n            documents.append({\n                'name': doc_path.name,\n                'path': str(doc_path),\n                'size': stat.st_size,\n                'modified': datetime.fromtimestamp(stat.st_mtime).isoformat()\n            })\n        \n        return documents\n    \n    def document_exists(self, phase: str) -> bool:\n        \"\"\"检查文档是否存在\n        \n        Args:\n            phase: Phase 名称\n        \"\"\"\n        doc_path = self.get_document_path(phase)\n        return doc_path.exists()\n    \n    def _create_version(self, doc_name: str):\n        \"\"\"创建文档版本\n        \n        Args:\n            doc_name: 文档名称\n        \"\"\"\n        doc_path = self.docs_dir / doc_name\n        \n        if not doc_path.exists():\n            return\n        \n        # 生成版本名\n        timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')\n        version_name = f\"{doc_name}.{timestamp}\"\n        version_path = self.versions_dir / version_name\n        \n        # 复制文件\n        shutil.copy2(doc_path, version_path)\n    \n    def list_versions(self, doc_name: str) -> List[Dict[str, Any]]:\n        \"\"\"列出文档版本\n        \n        Args:\n            doc_name: 文档名称\n        \"\"\"\n        if not doc_name.endswith('.md'):\n            doc_name = f\"{doc_name}.md\"\n        \n        versions = []\n        \n        for version_path in self.versions_dir.glob(f\"{doc_name}.*\"):\n            if version_path.name == doc_name:\n                continue\n            \n            stat = version_path.stat()\n            versions.append({\n                'name': version_path.name,\n                'path': str(version_path),\n                'size': stat.st_size,\n                'created': datetime.fromtimestamp(stat.st_mtime).isoformat()\n            })\n        \n        # 按时间排序\n        versions.sort(key=lambda x: x['created'], reverse=True)\n        \n        return versions\n    \n    def restore_version(self, doc_name: str, version_name: str) -> bool:\n        \"\"\"恢复文档版本\n        \n        Args:\n            doc_name: 文档名称\n            version_name: 版本名称\n        \"\"\"\n        version_path = self.versions_dir / version_name\n        doc_path = self.docs_dir / doc_name\n        \n        if not version_path.exists():\n            return False\n        \n        # 先备份当前版本\n        if doc_path.exists():\n            self._create_version(doc_name)\n        \n        # 恢复版本\n        shutil.copy2(version_path, doc_path)\n        \n        return True\n    \n    def delete_document(self, phase: str) -> bool:\n        \"\"\"删除文档\n        \n        Args:\n            phase: Phase 名称\n        \"\"\"\n        doc_path = self.get_document_path(phase)\n        \n        if not doc_path.exists():\n            return False\n        \n        # 创建版本备份\n        self._create_version(doc_path.name)\n        \n        # 删除文档\n        doc_path.unlink()\n        \n        return True\n    \n    def export_documents(self, output_dir: Path) -> Path:\n        \"\"\"导出所有文档\n        \n        Args:\n            output_dir: 输出目录\n        \"\"\"\n        output_path = Path(output_dir)\n        output_path.mkdir(parents=True, exist_ok=True)\n        \n        for doc_path in self.docs_dir.glob('*.md'):\n            shutil.copy2(doc_path, output_path / doc_path.name)\n        \n        return output_path\n    \n    def get_document_summary(self) -> Dict[str, Any]:\n        \"\"\"获取文档摘要\"\"\"\n        documents = self.list_documents()\n        \n        summary = {\n            'project': self.project_name,\n            'total_documents': len(documents),\n            'documents': {},\n            'completed_phases': []\n        }\n        \n        # Phase 到文档名的映射\n        phase_doc_map = {\n            'spec': 'spec.md',\n            'test_design': 'test_design.md',\n            'test_impl': 'test_impl.md',\n            'design': 'design.md',\n            'code_impl': 'code_impl.md',\n            'adversarial': 'review_report.md',\n            'verify': 'verification_report.md',\n            'docs': 'README.md'\n        }\n        \n        for phase, doc_name in phase_doc_map.items():\n            doc_info = next((d for d in documents if d['name'] == doc_name), None)\n            \n            if doc_info:\n                summary['documents'][phase] = doc_info\n                summary['completed_phases'].append(phase)\n            else:\n                summary['documents'][phase] = None\n        \n        return summary\nENDOFFILE"}}],"api":"openai-completions","provider":"bailian","model":"glm-5","usage":{"input":2319,"output":1701,"cacheRead":28741,"cacheWrite":0,"totalTokens":32761,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772353186427}}
