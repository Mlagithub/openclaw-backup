{"type":"message","id":"39ff6b80","parentId":"f0793fe0","timestamp":"2026-03-01T08:18:50.589Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"继续创建 agent_dispatcher.py","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"tool-18b713b2c9744f2fa640988fe0f8fb97","name":"exec","arguments":{"command":"cat > /home/one/.openclaw/skills/team-vsdd/core/agent_dispatcher.py << 'ENDOFFILE'\n\"\"\"\nAgent 调度器\n\n负责调度和执行各阶段对应的 Agent：\n- Agent 映射和配置\n- Prompt 构建\n- 结果处理\n\"\"\"\n\nimport json\nimport subprocess\nimport os\nfrom pathlib import Path\nfrom typing import Dict, Any, Optional\nfrom dataclasses import dataclass\nimport time\n\n\n@dataclass\nclass AgentConfig:\n    \"\"\"Agent 配置\"\"\"\n    model: str\n    timeout: int = 3600\n    temperature: float = 0.7\n    max_tokens: int = 8192\n\n\nclass AgentDispatcher:\n    \"\"\"Agent 调度器\n    \n    负责调度各阶段对应的 Agent 执行任务。\n    \"\"\"\n    \n    # 默认 Agent 配置\n    DEFAULT_AGENTS = {\n        'design-agent': AgentConfig(\n            model='bailian/qwen3.5-max',\n            timeout=3600\n        ),\n        'test-agent': AgentConfig(\n            model='bailian/glm-5',\n            timeout=3600\n        ),\n        'code-agent': AgentConfig(\n            model='bailian/glm-5',\n            timeout=7200\n        ),\n        'review-agent': AgentConfig(\n            model='bailian/qwen3.5-plus',\n            timeout=3600\n        ),\n        'verify-agent': AgentConfig(\n            model='bailian/qwen3.5-plus',\n            timeout=7200\n        ),\n        'docs-agent': AgentConfig(\n            model='bailian/qwen3.5-flash',\n            timeout=3600\n        )\n    }\n    \n    def __init__(self, config: Optional[Dict[str, Any]] = None):\n        \"\"\"初始化 Agent 调度器\n        \n        Args:\n            config: Agent 配置字典\n        \"\"\"\n        self.config = {}\n        \n        # 合并默认配置和用户配置\n        for agent_id, default_cfg in self.DEFAULT_AGENTS.items():\n            user_cfg = (config or {}).get(agent_id, {})\n            self.config[agent_id] = AgentConfig(\n                model=user_cfg.get('model', default_cfg.model),\n                timeout=user_cfg.get('timeout', default_cfg.timeout),\n                temperature=user_cfg.get('temperature', default_cfg.temperature),\n                max_tokens=user_cfg.get('max_tokens', default_cfg.max_tokens)\n            )\n    \n    def dispatch(self, agent_id: str, prompt: str, context: Optional[Dict[str, Any]] = None) -> Optional[str]:\n        \"\"\"调度 Agent 执行任务\n        \n        Args:\n            agent_id: Agent 标识\n            prompt: 任务 prompt\n            context: 额外上下文\n        \n        Returns:\n            Agent 输出，失败返回 None\n        \"\"\"\n        if agent_id not in self.config:\n            print(f\"未知的 Agent: {agent_id}\")\n            return None\n        \n        agent_config = self.config[agent_id]\n        \n        # 构建完整的任务描述\n        full_prompt = self._build_full_prompt(agent_id, prompt, context)\n        \n        # 执行 Agent\n        try:\n            output = self._execute_agent(agent_id, agent_config, full_prompt)\n            return output\n        except Exception as e:\n            print(f\"Agent {agent_id} 执行失败: {e}\")\n            return None\n    \n    def _build_full_prompt(self, agent_id: str, prompt: str, context: Optional[Dict[str, Any]] = None) -> str:\n        \"\"\"构建完整 prompt\"\"\"\n        # Agent 角色描述\n        role_descriptions = {\n            'design-agent': '''你是一个专业的软件架构师和设计师。\n你的职责是根据需求文档创建功能规格和详细设计文档。\n输出应该是完整的 Markdown 文档，包含清晰的结构和详细的技术描述。''',\n            \n            'test-agent': '''你是一个专业的测试工程师。\n你的职责是设计全面的测试用例和测试策略，确保软件质量。\n输出应该是完整的测试文档，包含测试用例、边界条件和异常情况。''',\n            \n            'code-agent': '''你是一个专业的软件工程师。\n你的职责是实现代码和编写高质量的测试代码。\n输出应该是完整的实现文档，包含代码片段和设计对应关系。''',\n            \n            'review-agent': '''你是一个严格的代码审查专家。\n你的职责是发现代码和设计中的问题，包括安全漏洞、性能问题和设计缺陷。\n输出应该是完整的审查报告，按优先级分类列出发现的问题。''',\n            \n            'verify-agent': '''你是一个形式化验证专家。\n你的职责是验证代码的正确性、安全性和性能。\n输出应该是完整的验证报告，包含静态分析结果和测试覆盖率。''',\n            \n            'docs-agent': '''你是一个技术文档撰写专家。\n你的职责是整合项目文档，创建清晰易读的 README 和 API 文档。\n输出应该是完整的项目文档，便于用户理解和使用。'''\n        }\n        \n        role = role_descriptions.get(agent_id, '你是一个专业的软件工程师。')\n        \n        full_prompt = f\"\"\"# 角色\n\n{role}\n\n---\n\n{prompt}\n\n---\n\n请按照指定的输出模板格式生成完整的文档。确保输出是有效的 Markdown 格式。\"\"\"\n        \n        return full_prompt\n    \n    def _execute_agent(self, agent_id: str, config: AgentConfig, prompt: str) -> Optional[str]:\n        \"\"\"执行 Agent\n        \n        在实际实现中，这里会调用 OpenClaw 的 Agent 系统。\n        当前版本模拟 Agent 执行。\n        \"\"\"\n        # 检查是否在 OpenClaw 环境中\n        # 实际实现应该调用 OpenClaw 的 subagent 机制\n        \n        # 模拟输出 - 实际应该由真实 Agent 生成\n        print(f\"\\n[Agent: {agent_id}]\")\n        print(f\"[Model: {config.model}]\")\n        print(f\"[Timeout: {config.timeout}s]\")\n        print(f\"[Prompt length: {len(prompt)} chars]\")\n        \n        # 返回一个模拟输出，实际实现应该等待真实 Agent 完成\n        # 这里返回一个占位符，实际使用时需要集成真实的 Agent 系统\n        return self._generate_mock_output(agent_id)\n    \n    def _generate_mock_output(self, agent_id: str) -> str:\n        \"\"\"生成模拟输出（用于测试）\"\"\"\n        mock_outputs = {\n            'design-agent': '''# Spec: [模块名称]\n\n## 1. 功能描述\n[待填写：这个模块做什么]\n\n## 2. 接口设计\n\n### 2.1 函数/接口签名\n```\n[待填写：接口定义]\n```\n\n### 2.2 参数说明\n| 参数 | 类型 | 说明 | 约束 |\n|------|------|------|------|\n| ... | ... | ... | ... |\n\n## 3. 输入/输出\n[待填写]\n\n## 4. 约束条件\n[待填写]\n\n## 5. 验证属性\n[待填写]\n\n---\n*此为模拟输出，实际应由 Agent 生成*\n''',\n            \n            'test-agent': '''# Test Design: [模块名称]\n\n## 1. 测试策略\n[待填写]\n\n## 2. 测试用例\n\n### 2.1 正常用例\n| ID | 描述 | 输入 | 期望输出 |\n|----|------|------|----------|\n| ... | ... | ... | ... |\n\n---\n*此为模拟输出，实际应由 Agent 生成*\n''',\n            \n            'code-agent': '''# Code Implementation: [模块名称]\n\n## 1. 修改文件清单\n[待填写]\n\n## 2. 关键代码实现\n[待填写]\n\n---\n*此为模拟输出，实际应由 Agent 生成*\n''',\n            \n            'review-agent': '''# Adversarial Review: [模块名称]\n\n## 1. 审查范围\n[待填写]\n\n## 2. 发现的问题\n[待填写]\n\n---\n*此为模拟输出，实际应由 Agent 生成*\n''',\n            \n            'verify-agent': '''# Verification Report: [模块名称]\n\n## 1. 验证范围\n[待填写]\n\n## 2. 验证结果\n[待填写]\n\n---\n*此为模拟输出，实际应由 Agent 生成*\n''',\n            \n            'docs-agent': '''# README: [项目名称]\n\n## 简介\n[待填写]\n\n## 功能特性\n[待填写]\n\n---\n*此为模拟输出，实际应由 Agent 生成*\n'''\n        }\n        \n        return mock_outputs.get(agent_id, '# [输出文档]\\n\\n[待填写]\\n')\n    \n    def get_agent_config(self, agent_id: str) -> Optional[AgentConfig]:\n        \"\"\"获取 Agent 配置\"\"\"\n        return self.config.get(agent_id)\n    \n    def list_agents(self) -> Dict[str, AgentConfig]:\n        \"\"\"列出所有 Agent 配置\"\"\"\n        return self.config.copy()\nENDOFFILE"}}],"api":"openai-completions","provider":"bailian","model":"glm-5","usage":{"input":1500,"output":1887,"cacheRead":25361,"cacheWrite":0,"totalTokens":28748,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772353083218}}
