{"type":"message","id":"1b7bc21d","parentId":"fe8f3314","timestamp":"2026-03-01T06:16:58.247Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"目录结构创建完成。现在开始实现核心层文件。","thinkingSignature":"reasoning_content"},{"type":"text","text":"目录结构已创建。现在开始实现核心层："},{"type":"toolCall","id":"tool-48e1c8515a1b40a08063df36fa237bec","name":"write","arguments":{"file_path":"/home/one/.openclaw/skills/team-vsdd/core/__init__.py","content":"\"\"\"\nteam-vsdd Core Module\n\nVSDD (Verification-Driven Software Development) 核心层\n提供领域无关的流程编排、Phase 管理、Agent 调度、追踪和文档管理功能\n\"\"\"\n\nfrom .orchestrator import VSDDOrchestrator\nfrom .phase_manager import PhaseManager\nfrom .agent_dispatcher import AgentDispatcher\nfrom .traceability import TraceabilitySystem\nfrom .document_manager import DocumentManager\nfrom .validator_base import BaseValidator, DomainValidator\n\n__all__ = [\n    'VSDDOrchestrator',\n    'PhaseManager', \n    'AgentDispatcher',\n    'TraceabilitySystem',\n    'DocumentManager',\n    'BaseValidator',\n    'DomainValidator'\n]"}},{"type":"toolCall","id":"tool-83b5a7d5cf3647aba01a88c37ddd8a73","name":"write","arguments":{"file_path":"/home/one/.openclaw/skills/team-vsdd/core/orchestrator.py","content":"\"\"\"\nVSDD 流程编排器\n\n负责协调整个 VSDD 开发流程，管理 Phase 执行、Agent 调度和文档流转\n\"\"\"\n\nimport json\nimport os\nfrom pathlib import Path\nfrom typing import Dict, List, Optional, Any\nfrom dataclasses import dataclass, field\n\nfrom .phase_manager import PhaseManager\nfrom .agent_dispatcher import AgentDispatcher\nfrom .traceability import TraceabilitySystem\nfrom .document_manager import DocumentManager\n\n\n@dataclass\nclass DomainConfig:\n    \"\"\"领域配置管理\"\"\"\n    name: str\n    path: Path\n    config: Dict[str, Any] = field(default_factory=dict)\n    \n    @classmethod\n    def load(cls, domain_name: str, skills_path: str = None) -> 'DomainConfig':\n        \"\"\"加载领域配置\n        \n        Args:\n            domain_name: 领域名称或完整路径\n            skills_path: 技能安装路径（用于定位内置领域）\n        \"\"\"\n        if domain_name.startswith('/') or domain_name.startswith('./'):\n            # 自定义领域路径\n            path = Path(domain_name)\n        else:\n            # 内置领域\n            if skills_path is None:\n                skills_path = Path(__file__).parent.parent\n            path = Path(skills_path) / 'domains' / domain_name\n        \n        config_file = path / 'domain_config.json'\n        if not config_file.exists():\n            raise FileNotFoundError(f\"Domain config not found: {config_file}\")\n        \n        with open(config_file, 'r', encoding='utf-8') as f:\n            config = json.load(f)\n        \n        return cls(\n            name=config.get('domain', domain_name),\n            path=path,\n            config=config\n        )\n    \n    def get_phases(self) -> List[str]:\n        \"\"\"获取启用的 Phase 列表\"\"\"\n        return self.config.get('phases', [\n            'spec', 'test_design', 'test_impl', 'design',\n            'code_impl', 'adversarial', 'verify', 'docs'\n        ])\n    \n    def get_template(self, phase_name: str) -> str:\n        \"\"\"获取领域模板内容\"\"\"\n        templates = self.config.get('templates', {})\n        template_path = templates.get(phase_name)\n        if template_path:\n            full_path = self.path / template_path\n            if full_path.exists():\n                return full_path.read_text(encoding='utf-8')\n        return \"\"\n    \n    def get_input_docs(self, phase_name: str) -> List[str]:\n        \"\"\"获取 Phase 的输入文档列表\"\"\"\n        # 从配置获取，如果没有则使用默认映射\n        input_mapping = self.config.get('phase_inputs', {})\n        if phase_name in input_mapping:\n            return input_mapping[phase_name]\n        \n        # 默认映射\n        default_inputs = {\n            'spec': [],\n            'test_design': ['spec.md'],\n            'test_impl': ['spec.md', 'test_design.md'],\n            'design': ['spec.md', 'test_design.md'],\n            'code_impl': ['design.md', 'test_impl.md'],\n            'adversarial': ['spec.md', 'test_design.md', 'test_impl.md',\n                           'design.md', 'code_impl.md'],\n            'verify': ['design.md', 'code_impl.md', 'spec.md'],\n            'docs': ['spec.md', 'design.md', 'code_impl.md', 'review_report.md']\n        }\n        return default_inputs.get(phase_name, [])\n    \n    def get_output_doc(self, phase_name: str) -> str:\n        \"\"\"获取 Phase 的输出文档名\"\"\"\n        output_mapping = {\n            'spec': 'spec.md',\n            'test_design': 'test_design.md',\n            'test_impl': 'test_impl.md',\n            'design': 'design.md',\n            'code_impl': 'code_impl.md',\n            'adversarial': 'review_report.md',\n            'verify': 'verification_report.md',\n            'docs': 'README.md'\n        }\n        return output_mapping.get(phase_name, f'{phase_name}.md')\n    \n    def get_agent(self, phase_name: str) -> str:\n        \"\"\"获取 Phase 对应的 Agent\"\"\"\n        agent_mapping = self.config.get('phase_agents', {})\n        if phase_name in agent_mapping:\n            return agent_mapping[phase_name]\n        \n        # 默认映射\n        default_agents = {\n            'spec': 'design-agent',\n            'test_design': 'test-agent',\n            'test_impl': 'code-agent',\n            'design': 'design-agent',\n            'code_impl': 'code-agent',\n            'adversarial': 'review-agent',\n            'verify': 'verify-agent',\n            'docs': 'docs-agent'\n        }\n        return default_agents.get(phase_name, 'design-agent')\n    \n    def get_validation_rules(self) -> Dict[str, Any]:\n        \"\"\"获取验证规则\"\"\"\n        return self.config.get('validation_rules', {})\n    \n    def is_formal_verification_enabled(self) -> bool:\n        \"\"\"检查是否启用形式化验证\"\"\"\n        formal = self.config.get('formal_verification', {})\n        return formal.get('enabled', False)\n\n\nclass VSDDOrchestrator:\n    \"\"\"VSDD 流程编排器 - 领域无关\"\"\"\n    \n    def __init__(self, project_name: str, domain: str, config: Dict[str, Any]):\n        \"\"\"\n        初始化编排器\n        \n        Args:\n            project_name: 项目名称\n            domain: 领域名称或路径\n            config: 配置字典\n        \"\"\"\n        self.project_name = project_name\n        self.config = config\n        \n        # 加载领域配置\n        self.domain = DomainConfig.load(domain)\n        \n        # 设置工作空间\n        self.workspace = Path(config.get('workspace', f'.vsdd/projects/{project_name}'))\n        self.vsdd_dir = self.workspace / '.vsdd'\n        \n        # 初始化组件\n        self.phase_manager = PhaseManager(self.domain)\n        self.agent_dispatcher = AgentDispatcher(config.get('agents', {}))\n        self.traceability = TraceabilitySystem(\n            self.vsdd_dir / 'traceability.json',\n            enabled=config.get('traceability', {}).get('enabled', True)\n        )\n        self.document_manager = DocumentManager(self.workspace)\n        \n        # 状态\n        self.current_phase = None\n        self.completed_phases: List[str] = []\n    \n    @classmethod\n    def from_config_file(cls, config_path: str) -> 'VSDDOrchestrator':\n        \"\"\"从配置文件创建编排器\"\"\"\n        with open(config_path, 'r', encoding='utf-8') as f:\n            config = json.load(f)\n        \n        project_name = config.get('project_name', 'unnamed')\n        domain = config.get('domain', 'industrial')\n        \n        return cls(project_name, domain, config)\n    \n    def init_project(self, goal: str) -> bool:\n        \"\"\"\n        初始化项目\n        \n        Args:\n            goal: 项目目标描述\n        \"\"\"\n        # 创建工作目录\n        self.workspace.mkdir(parents=True, exist_ok=True)\n        self.vsdd_dir.mkdir(parents=True, exist_ok=True)\n        \n        # 创建项目配置\n        project_config = {\n            'name': self.project_name,\n            'domain': self.domain.name,\n            'goal': goal,\n            'status': 'initialized',\n            'phases': {}\n        }\n        \n        config_path = self.vsdd_dir / 'project.json'\n        with open(config_path, 'w', encoding='utf-8') as f:\n            json.dump(project_config, f, indent=2, ensure_ascii=False)\n        \n        # 初始化追踪系统\n        self.traceability.init_project(self.project_name, goal)\n        \n        # 保存初始目标文档\n        goal_doc = self.workspace / 'goal.md'\n        goal_doc.write_text(f'# Project Goal\\n\\n{goal}\\n', encoding='utf-8')\n        \n        return True\n    \n    def run_pipeline(self, start_phase: str = None, end_phase: str = None) -> bool:\n        \"\"\"\n        执行完整或部分 VSDD 流程\n        \n        Args:\n            start_phase: 起始 Phase（None 表示从头开始）\n            end_phase: 结束 Phase（None 表示到最后）\n        \"\"\"\n        phases = self.domain.get_phases()\n        \n        # 确定执行范围\n        start_idx = phases.index(start_phase) if start_phase else 0\n        end_idx = phases.index(end_phase) + 1 if end_phase else len(phases)\n        phases_to_run = phases[start_idx:end_idx]\n        \n        for phase_name in phases_to_run:\n            if not self.should_run_phase(phase_name):\n                print(f\"[SKIP] Phase {phase_name} - dependencies not satisfied\")\n                continue\n            \n            print(f\"[RUN] Phase: {phase_name}\")\n            success = self.run_phase(phase_name)\n            \n            if not success:\n                print(f\"[FAIL] Phase {phase_name} failed\")\n                return False\n            \n            self.completed_phases.append(phase_name)\n            print(f\"[DONE] Phase: {phase_name}\")\n        \n        return True\n    \n    def run_phase(self, phase_name: str) -> bool:\n        \"\"\"\n        执行单个 Phase\n        \n        Args:\n            phase_name: Phase 名称\n        \"\"\"\n        # 1. 准备 Phase 输入\n        phase_info = self.phase_manager.prepare_phase(phase_name)\n        \n        # 2. 读取输入文档\n        input_docs = {}\n        for doc_name in self.domain.get_input_docs(phase_name):\n            doc_path = self.workspace / doc_name\n            if doc_path.exists():\n                input_docs[doc_name] = doc_path.read_text(encoding='utf-8')\n        \n        # 3. 获取模板\n        template = self.domain.get_template(phase_name)\n        \n        # 4. 构造 prompt\n        prompt = self.build_prompt(phase_name, input_docs, template)\n        \n        # 5. 调用 Agent\n        agent_id = self.domain.get_agent(phase_name)\n        output = self.agent_dispatcher.dispatch(\n            agent_id=agent_id,\n            prompt=prompt,\n            phase_name=phase_name,\n            workspace=str(self.workspace)\n        )\n        \n        if output is None:\n            return False\n        \n        # 6. 保存文档\n        output_doc = self.domain.get_output_doc(phase_name)\n        doc_path = self.document_manager.save(output_doc, output)\n        \n        # 7. 领域验证\n        if not self.phase_manager.validate(phase_name, doc_path):\n            return False\n        \n        # 8. 记录追踪\n        self.traceability.record(\n            phase_name=phase_name,\n            input_docs=list(input_docs.keys()),\n            output_doc=output_doc,\n            agent_id=agent_id\n        )\n        \n        return True\n    \n    def build_prompt(self, phase_name: str, input_docs: Dict[str, str], \n                     template: str) -> str:\n        \"\"\"\n        构建 Agent prompt\n        \n        Args:\n            phase_name: Phase 名称\n            input_docs: 输入文档字典\n            template: 模板内容\n        \"\"\"\n        phase_desc = self.phase_manager.get_phase_description(phase_name)\n        \n        parts = [\n            f\"# VSDD Phase: {phase_name}\",\n            f\"\",\n            f\"## Project: {self.project_name}\",\n            f\"## Domain: {self.domain.name}\",\n            f\"\",\n            f\"## Phase Description\",\n            phase_desc,\n            f\"\",\n        ]\n        \n        # 添加输入文档\n        if input_docs:\n            parts.append(\"## Input Documents\\n\")\n            for doc_name, content in input_docs.items():\n                parts.append(f\"### {doc_name}\\n\")\n                parts.append(\"```markdown\")\n                parts.append(content)\n                parts.append(\"```\\n\")\n        \n        # 添加模板\n        if template:\n            parts.append(\"## Output Template\\n\")\n            parts.append(\"Use the following template for your output:\\n\")\n            parts.append(template)\n        \n        # 添加验证规则提示\n        rules = self.domain.get_validation_rules()\n        if rules:\n            parts.append(\"\\n## Validation Requirements\\n\")\n            test_focus = rules.get('test_focus', [])\n            if test_focus:\n                parts.append(\"Focus areas:\")\n                for focus in test_focus:\n                    parts.append(f\"- {focus}\")\n        \n        return \"\\n\".join(parts)\n    \n    def should_run_phase(self, phase_name: str) -> bool:\n        \"\"\"检查 Phase 是否应该运行\"\"\"\n        # 检查依赖是否满足\n        input_docs = self.domain.get_input_docs(phase_name)\n        for doc_name in input_docs:\n            doc_path = self.workspace / doc_name\n            if not doc_path.exists():\n                return False\n        return True\n    \n    def get_status(self) -> Dict[str, Any]:\n        \"\"\"获取项目状态\"\"\"\n        status = {\n            'project': self.project_name,\n            'domain': self.domain.name,\n            'phases': {}\n        }\n        \n        phases = self.domain.get_phases()\n        for phase in phases:\n            output_doc = self.domain.get_output_doc(phase)\n            doc_path = self.workspace / output_doc\n            \n            status['phases'][phase] = {\n                'completed': doc_path.exists(),\n                'output': output_doc if doc_path.exists() else None\n            }\n        \n        return status\n    \n    def get_traceability_matrix(self) -> Dict[str, Any]:\n        \"\"\"获取追踪矩阵\"\"\"\n        return self.traceability.get_matrix()"}},{"type":"toolCall","id":"tool-3cf6ade1d5b74985b7a5408f833b24a6","name":"write","arguments":{"file_path":"/home/one/.openclaw/skills/team-vsdd/core/phase_manager.py","content":"\"\"\"\nPhase 管理器\n\n负责管理 VSDD 流程的各个 Phase，包括执行顺序、依赖关系和验证\n\"\"\"\n\nfrom typing import Dict, List, Optional, Any\nfrom dataclasses import dataclass\nfrom pathlib import Path\n\n\n@dataclass\nclass PhaseInfo:\n    \"\"\"Phase 信息\"\"\"\n    name: str\n    description: str\n    inputs: List[str]\n    outputs: List[str]\n    agent: str\n    optional: bool = False\n    validation_required: bool = True\n\n\n# 默认 Phase 定义\nDEFAULT_PHASES: Dict[str, PhaseInfo] = {\n    'spec': PhaseInfo(\n        name='spec',\n        description='编写功能规格文档，定义模块功能、接口、约束和验证属性',\n        inputs=[],\n        outputs=['spec.md'],\n        agent='design-agent'\n    ),\n    'test_design': PhaseInfo(\n        name='test_design',\n        description='设计测试策略和测试用例，包括单元测试、集成测试和边界测试',\n        inputs=['spec.md'],\n        outputs=['test_design.md'],\n        agent='test-agent'\n    ),\n    'test_impl': PhaseInfo(\n        name='test_impl',\n        description='实现测试代码，包括测试框架、测试数据和测试辅助工具',\n        inputs=['spec.md', 'test_design.md'],\n        outputs=['test_impl.md'],\n        agent='code-agent'\n    ),\n    'design': PhaseInfo(\n        name='design',\n        description='编写详细设计文档，包括架构设计、模块设计和接口设计',\n        inputs=['spec.md', 'test_design.md'],\n        outputs=['design.md'],\n        agent='design-agent'\n    ),\n    'code_impl': PhaseInfo(\n        name='code_impl',\n        description='实现代码，包括核心功能、测试和文档',\n        inputs=['design.md', 'test_impl.md'],\n        outputs=['code_impl.md'],\n        agent='code-agent'\n    ),\n    'adversarial': PhaseInfo(\n        name='adversarial',\n        description='对抗性审查，检查潜在问题、边界情况和安全漏洞',\n        inputs=['spec.md', 'test_design.md', 'test_impl.md', 'design.md', 'code_impl.md'],\n        outputs=['review_report.md'],\n        agent='review-agent'\n    ),\n    'verify': PhaseInfo(\n        name='verify',\n        description='形式化验证，验证代码正确性和安全性',\n        inputs=['design.md', 'code_impl.md', 'spec.md'],\n        outputs=['verification_report.md'],\n        agent='verify-agent',\n        optional=True\n    ),\n    'docs': PhaseInfo(\n        name='docs',\n        description='整合文档，生成 README 和最终文档',\n        inputs=['spec.md', 'design.md', 'code_impl.md', 'review_report.md'],\n        outputs=['README.md'],\n        agent='docs-agent'\n    )\n}\n\n\nclass PhaseManager:\n    \"\"\"Phase 管理器\"\"\"\n    \n    def __init__(self, domain_config: Any = None):\n        \"\"\"\n        初始化 Phase 管理器\n        \n        Args:\n            domain_config: 领域配置对象（可选）\n        \"\"\"\n        self.domain_config = domain_config\n        self.phases = self._load_phases()\n    \n    def _load_phases(self) -> Dict[str, PhaseInfo]:\n        \"\"\"加载 Phase 定义\"\"\"\n        phases = dict(DEFAULT_PHASES)\n        \n        # 如果有领域配置，合并领域特定的 Phase 定义\n        if self.domain_config and hasattr(self.domain_config, 'config'):\n            domain_phases = self.domain_config.config.get('phase_definitions', {})\n            for name, info in domain_phases.items():\n                phases[name] = PhaseInfo(\n                    name=name,\n                    description=info.get('description', ''),\n                    inputs=info.get('inputs', []),\n                    outputs=info.get('outputs', []),\n                    agent=info.get('agent', 'design-agent'),\n                    optional=info.get('optional', False),\n                    validation_required=info.get('validation_required', True)\n                )\n        \n        return phases\n    \n    def get_phase(self, phase_name: str) -> Optional[PhaseInfo]:\n        \"\"\"获取 Phase 信息\"\"\"\n        return self.phases.get(phase_name)\n    \n    def get_phase_description(self, phase_name: str) -> str:\n        \"\"\"获取 Phase 描述\"\"\"\n        phase = self.phases.get(phase_name)\n        return phase.description if phase else f\"Unknown phase: {phase_name}\"\n    \n    def get_ordered_phases(self) -> List[str]:\n        \"\"\"获取按执行顺序排列的 Phase 列表\"\"\"\n        if self.domain_config and hasattr(self.domain_config, 'get_phases'):\n            return self.domain_config.get_phases()\n        return list(self.phases.keys())\n    \n    def prepare_phase(self, phase_name: str) -> Dict[str, Any]:\n        \"\"\"\n        准备 Phase 执行\n        \n        返回执行所需的信息\n        \"\"\"\n        phase = self.phases.get(phase_name)\n        if not phase:\n            raise ValueError(f\"Unknown phase: {phase_name}\")\n        \n        return {\n            'name': phase.name,\n            'description': phase.description,\n            'inputs': phase.inputs,\n            'outputs': phase.outputs,\n            'agent': phase.agent,\n            'optional': phase.optional\n        }\n    \n    def validate(self, phase_name: str, output_path: str) -> bool:\n        \"\"\"\n        验证 Phase 输出\n        \n        Args:\n            phase_name: Phase 名称\n            output_path: 输出文档路径\n        \"\"\"\n        phase = self.phases.get(phase_name)\n        if not phase:\n            return False\n        \n        # 检查文件是否存在\n        path = Path(output_path)\n        if not path.exists():\n            return False\n        \n        # 基本验证：检查文件不为空\n        content = path.read_text(encoding='utf-8')\n        if len(content.strip()) == 0:\n            return False\n        \n        # 可以添加更多验证逻辑\n        return True\n    \n    def get_dependencies(self, phase_name: str) -> List[str]:\n        \"\"\"获取 Phase 的依赖（输入文档）\"\"\"\n        phase = self.phases.get(phase_name)\n        return phase.inputs if phase else []\n    \n    def is_phase_optional(self, phase_name: str) -> bool:\n        \"\"\"检查 Phase 是否可选\"\"\"\n        phase = self.phases.get(phase_name)\n        return phase.optional if phase else False\n    \n    def get_phase_outputs(self, phase_name: str) -> List[str]:\n        \"\"\"获取 Phase 的输出文档\"\"\"\n        phase = self.phases.get(phase_name)\n        return phase.outputs if phase else []"}},{"type":"toolCall","id":"tool-828b7de29cc84a3185e4d4b9f7ccf0e1","name":"write","arguments":{"file_path":"/home/one/.openclaw/skills/team-vsdd/core/agent_dispatcher.py","content":"\"\"\"\nAgent 调度器\n\n负责调度和调用各个 Agent（设计、测试、代码、审查、验证、文档）\n\"\"\"\n\nimport json\nimport subprocess\nimport os\nfrom typing import Dict, Any, Optional\nfrom pathlib import Path\nfrom dataclasses import dataclass\n\n\n@dataclass\nclass AgentConfig:\n    \"\"\"Agent 配置\"\"\"\n    model: str\n    timeout: int = 3600\n    temperature: float = 0.7\n    max_tokens: int = 4096\n    system_prompt: str = \"\"\n\n\nclass AgentDispatcher:\n    \"\"\"Agent 调度器\"\"\"\n    \n    def __init__(self, agents_config: Dict[str, Any]):\n        \"\"\"\n        初始化调度器\n        \n        Args:\n            agents_config: Agent 配置字典\n        \"\"\"\n        self.agents = self._load_agents(agents_config)\n    \n    def _load_agents(self, config: Dict[str, Any]) -> Dict[str, AgentConfig]:\n        \"\"\"加载 Agent 配置\"\"\"\n        agents = {}\n        \n        # 默认 Agent 配置\n        default_agents = {\n            'design-agent': AgentConfig(\n                model='bailian/qwen3.5-max',\n                timeout=3600,\n                system_prompt='你是设计专家，负责编写功能规格和详细设计文档。'\n            ),\n            'test-agent': AgentConfig(\n                model='bailian/glm-5',\n                timeout=3600,\n                system_prompt='你是测试专家，负责设计测试策略和测试用例。'\n            ),\n            'code-agent': AgentConfig(\n                model='bailian/glm-5',\n                timeout=7200,\n                system_prompt='你是代码专家，负责实现代码和测试。'\n            ),\n            'review-agent': AgentConfig(\n                model='bailian/qwen3.5-plus',\n                timeout=3600,\n                system_prompt='你是审查专家，负责对抗性审查和发现问题。'\n            ),\n            'verify-agent': AgentConfig(\n                model='bailian/qwen3.5-plus',\n                timeout=7200,\n                system_prompt='你是验证专家，负责形式化验证和正确性证明。'\n            ),\n            'docs-agent': AgentConfig(\n                model='bailian/qwen3.5-flash',\n                timeout=3600,\n                system_prompt='你是文档专家，负责整合文档和编写 README。'\n            )\n        }\n        \n        # 合并用户配置\n        for name, cfg in default_agents.items():\n            if name in config:\n                user_cfg = config[name]\n                agents[name] = AgentConfig(\n                    model=user_cfg.get('model', cfg.model),\n                    timeout=user_cfg.get('timeout', cfg.timeout),\n                    temperature=user_cfg.get('temperature', cfg.temperature),\n                    max_tokens=user_cfg.get('max_tokens', cfg.max_tokens),\n                    system_prompt=user_cfg.get('system_prompt', cfg.system_prompt)\n                )\n            else:\n                agents[name] = cfg\n        \n        return agents\n    \n    def dispatch(self, agent_id: str, prompt: str, phase_name: str = \"\",\n                 workspace: str = \"\") -> Optional[str]:\n        \"\"\"\n        调度 Agent 执行任务\n        \n        Args:\n            agent_id: Agent ID\n            prompt: 提示词\n            phase_name: Phase 名称（用于日志）\n            workspace: 工作空间路径\n        \n        Returns:\n            Agent 输出内容，失败返回 None\n        \"\"\"\n        config = self.agents.get(agent_id)\n        if not config:\n            print(f\"[ERROR] Unknown agent: {agent_id}\")\n            return None\n        \n        print(f\"[DISPATCH] Agent: {agent_id}, Phase: {phase_name}\")\n        \n        # 保存 prompt 到工作空间\n        if workspace:\n            prompt_file = Path(workspace) / '.vsdd' / f'prompt_{phase_name}.md'\n            prompt_file.parent.mkdir(parents=True, exist_ok=True)\n            prompt_file.write_text(prompt, encoding='utf-8')\n        \n        # 调用 Agent\n        try:\n            output = self._call_agent(config, prompt)\n            \n            if output and workspace:\n                output_file = Path(workspace) / '.vsdd' / f'output_{phase_name}.md'\n                output_file.write_text(output, encoding='utf-8')\n            \n            return output\n        except Exception as e:\n            print(f\"[ERROR] Agent call failed: {e}\")\n            return None\n    \n    def _call_agent(self, config: AgentConfig, prompt: str) -> Optional[str]:\n        \"\"\"\n        调用 Agent（内部方法）\n        \n        这个方法可以根据实际环境实现不同的调用方式：\n        1. 调用 OpenClaw 的 Agent 系统\n        2. 调用外部 LLM API\n        3. 调用本地模型\n        \"\"\"\n        # 方式1：通过 openclaw agent 命令调用\n        # 这里我们生成一个任务文件，供外部系统读取和执行\n        \n        task = {\n            'model': config.model,\n            'system_prompt': config.system_prompt,\n            'prompt': prompt,\n            'temperature': config.temperature,\n            'max_tokens': config.max_tokens,\n            'timeout': config.timeout\n        }\n        \n        # 在实际实现中，这里应该：\n        # 1. 调用 OpenClaw 的 Agent API\n        # 2. 或者返回一个占位符，让外部系统处理\n        \n        # 返回一个指示文档，让用户知道需要调用 Agent\n        return self._generate_agent_instruction(task)\n    \n    def _generate_agent_instruction(self, task: Dict[str, Any]) -> str:\n        \"\"\"\n        生成 Agent 调用指令文档\n        \n        在实际集成时，这里应该返回 Agent 的真实输出\n        \"\"\"\n        return f\"\"\"# Agent Task Instruction\n\nThis document should be processed by the Agent system.\n\n## Model: {task['model']}\n\n## System Prompt\n```\n{task['system_prompt']}\n```\n\n## Task Prompt\n```\n{task['prompt']}\n```\n\n## Configuration\n- Temperature: {task['temperature']}\n- Max Tokens: {task['max_tokens']}\n- Timeout: {task['timeout']}s\n\n---\n*This is a placeholder for Agent output. In production, this should be replaced with actual Agent response.*\n\"\"\"\n    \n    def get_agent_config(self, agent_id: str) -> Optional[AgentConfig]:\n        \"\"\"获取 Agent 配置\"\"\"\n        return self.agents.get(agent_id)\n    \n    def list_agents(self) -> list:\n        \"\"\"列出所有可用 Agent\"\"\"\n        return list(self.agents.keys())"}},{"type":"toolCall","id":"tool-ecb1f23533a1486fbbe3f839baec4c67","name":"write","arguments":{"file_path":"/home/one/.openclaw/skills/team-vsdd/core/traceability.py","content":"\"\"\"\n追踪系统\n\n负责记录和管理需求→测试→代码→验证的全链路追踪\n\"\"\"\n\nimport json\nfrom pathlib import Path\nfrom typing import Dict, List, Any, Optional\nfrom datetime import datetime\nfrom dataclasses import dataclass, field, asdict\n\n\n@dataclass\nclass TraceRecord:\n    \"\"\"追踪记录\"\"\"\n    phase: str\n    timestamp: str\n    input_docs: List[str]\n    output_doc: str\n    agent_id: str\n    status: str = \"completed\"\n    metadata: Dict[str, Any] = field(default_factory=dict)\n\n\nclass TraceabilitySystem:\n    \"\"\"追踪系统\"\"\"\n    \n    def __init__(self, db_path: str, enabled: bool = True):\n        \"\"\"\n        初始化追踪系统\n        \n        Args:\n            db_path: 追踪数据库路径\n            enabled: 是否启用追踪\n        \"\"\"\n        self.db_path = Path(db_path)\n        self.enabled = enabled\n        self.data = self._load_data()\n    \n    def _load_data(self) -> Dict[str, Any]:\n        \"\"\"加载追踪数据\"\"\"\n        if not self.enabled:\n            return {'projects': {}, 'matrix': {}}\n        \n        if self.db_path.exists():\n            try:\n                with open(self.db_path, 'r', encoding='utf-8') as f:\n                    return json.load(f)\n            except (json.JSONDecodeError, IOError):\n                pass\n        \n        return {'projects': {}, 'matrix': {}}\n    \n    def _save_data(self):\n        \"\"\"保存追踪数据\"\"\"\n        if not self.enabled:\n            return\n        \n        self.db_path.parent.mkdir(parents=True, exist_ok=True)\n        with open(self.db_path, 'w', encoding='utf-8') as f:\n            json.dump(self.data, f, indent=2, ensure_ascii=False)\n    \n    def init_project(self, project_name: str, goal: str):\n        \"\"\"\n        初始化项目追踪\n        \n        Args:\n            project_name: 项目名称\n            goal: 项目目标\n        \"\"\"\n        if not self.enabled:\n            return\n        \n        self.data['projects'][project_name] = {\n            'goal': goal,\n            'created': datetime.now().isoformat(),\n            'phases': {},\n            'links': []\n        }\n        self._save_data()\n    \n    def record(self, phase_name: str, input_docs: List[str], \n               output_doc: str, agent_id: str, \n               metadata: Dict[str, Any] = None) -> str:\n        \"\"\"\n        记录 Phase 执行\n        \n        Args:\n            phase_name: Phase 名称\n            input_docs: 输入文档列表\n            output_doc: 输出文档\n            agent_id: Agent ID\n            metadata: 额外元数据\n        \n        Returns:\n            记录 ID\n        \"\"\"\n        if not self.enabled:\n            return \"\"\n        \n        record = TraceRecord(\n            phase=phase_name,\n            timestamp=datetime.now().isoformat(),\n            input_docs=input_docs,\n            output_doc=output_doc,\n            agent_id=agent_id,\n            metadata=metadata or {}\n        )\n        \n        # 存储记录\n        record_id = f\"{phase_name}_{datetime.now().strftime('%Y%m%d%H%M%S')}\"\n        \n        if 'records' not in self.data:\n            self.data['records'] = {}\n        self.data['records'][record_id] = asdict(record)\n        \n        # 更新链接矩阵\n        self._update_matrix(phase_name, input_docs, output_doc)\n        \n        self._save_data()\n        return record_id\n    \n    def _update_matrix(self, phase: str, inputs: List[str], output: str):\n        \"\"\"更新追踪矩阵\"\"\"\n        if 'matrix' not in self.data:\n            self.data['matrix'] = {}\n        \n        # 为每个输入文档创建链接\n        for inp in inputs:\n            link_key = f\"{inp} -> {output}\"\n            if link_key not in self.data['matrix']:\n                self.data['matrix'][link_key] = []\n            self.data['matrix'][link_key].append({\n                'phase': phase,\n                'timestamp': datetime.now().isoformat()\n            })\n    \n    def get_matrix(self) -> Dict[str, Any]:\n        \"\"\"获取追踪矩阵\"\"\"\n        return self.data.get('matrix', {})\n    \n    def get_trace_chain(self, doc_name: str) -> List[Dict[str, Any]]:\n        \"\"\"\n        获取文档的追踪链\n        \n        Args:\n            doc_name: 文档名称\n        \n        Returns:\n            追踪链列表\n        \"\"\"\n        chain = []\n        matrix = self.get_matrix()\n        \n        # 查找所有涉及该文档的链接\n        for link, records in matrix.items():\n            if doc_name in link:\n                for record in records:\n                    chain.append({\n                        'link': link,\n                        **record\n                    })\n        \n        # 按时间排序\n        chain.sort(key=lambda x: x.get('timestamp', ''))\n        return chain\n    \n    def get_requirements_trace(self, spec_file: str = 'spec.md') -> Dict[str, List[str]]:\n        \"\"\"\n        获取需求追踪（从 spec 到所有相关文档）\n        \n        Args:\n            spec_file: 规格文档名称\n        \n        Returns:\n            追踪字典 {文档: [依赖链]}\n        \"\"\"\n        trace = {}\n        matrix = self.get_matrix()\n        \n        def find_downstream(doc: str, path: List[str]) -> List[List[str]]:\n            \"\"\"递归查找下游文档\"\"\"\n            results = []\n            for link, records in matrix.items():\n                if link.startswith(f\"{doc} ->\"):\n                    downstream = link.split(\" -> \")[1]\n                    new_path = path + [downstream]\n                    results.append(new_path)\n                    results.extend(find_downstream(downstream, new_path))\n            return results\n        \n        traces = find_downstream(spec_file, [spec_file])\n        for path in traces:\n            trace[path[-1]] = path\n        \n        return trace\n    \n    def get_test_coverage(self, spec_file: str = 'spec.md') -> Dict[str, Any]:\n        \"\"\"\n        获取测试覆盖信息\n        \n        Args:\n            spec_file: 规格文档名称\n        \n        Returns:\n            覆盖信息字典\n        \"\"\"\n        trace = self.get_requirements_trace(spec_file)\n        \n        coverage = {\n            'has_test_design': 'test_design.md' in trace,\n            'has_test_impl': 'test_impl.md' in trace,\n            'has_code': 'code_impl.md' in trace,\n            'has_review': 'review_report.md' in trace,\n            'has_verification': 'verification_report.md' in trace,\n            'trace_paths': trace\n        }\n        \n        return coverage\n    \n    def export_report(self, output_path: str, format: str = 'markdown'):\n        \"\"\"\n        导出追踪报告\n        \n        Args:\n            output_path: 输出文件路径\n            format: 输出格式 (markdown, json)\n        \"\"\"\n        if format == 'json':\n            with open(output_path, 'w', encoding='utf-8') as f:\n                json.dump(self.data, f, indent=2, ensure_ascii=False)\n        else:\n            # Markdown 格式\n            lines = [\n                \"# Traceability Report\",\n                \"\",\n                f\"Generated: {datetime.now().isoformat()}\",\n                \"\",\n                \"## Trace Matrix\",\n                \"\"\n            ]\n            \n            for link, records in self.get_matrix().items():\n                lines.append(f\"### {link}\")\n                for record in records:\n                    lines.append(f\"- Phase: {record['phase']}\")\n                    lines.append(f\"  Time: {record['timestamp']}\")\n                lines.append(\"\")\n            \n            with open(output_path, 'w', encoding='utf-8') as f:\n                f.write('\\n'.join(lines))\n    \n    def list_records(self, phase: str = None) -> List[Dict[str, Any]]:\n        \"\"\"\n        列出记录\n        \n        Args:\n            phase: 可选，按 Phase 过滤\n        \"\"\"\n        records = self.data.get('records', {})\n        result = []\n        \n        for record_id, record in records.items():\n            if phase is None or record.get('phase') == phase:\n                result.append({'id': record_id, **record})\n        \n        return result"}},{"type":"toolCall","id":"tool-a764ffca2358400486a574cc88f94da5","name":"write","arguments":{"file_path":"/home/one/.openclaw/skills/team-vsdd/core/document_manager.py","content":"\"\"\"\n文档管理器\n\n负责管理 VSDD 流程中所有文档的读写、版本和格式\n\"\"\"\n\nimport json\nfrom pathlib import Path\nfrom typing import Dict, List, Optional, Any\nfrom datetime import datetime\nfrom dataclasses import dataclass, field\n\n\n@dataclass\nclass DocumentInfo:\n    \"\"\"文档信息\"\"\"\n    name: str\n    path: Path\n    created: str\n    modified: str\n    phase: str = \"\"\n    size: int = 0\n    metadata: Dict[str, Any] = field(default_factory=dict)\n\n\nclass DocumentManager:\n    \"\"\"文档管理器\"\"\"\n    \n    def __init__(self, workspace: str):\n        \"\"\"\n        初始化文档管理器\n        \n        Args:\n            workspace: 工作空间路径\n        \"\"\"\n        self.workspace = Path(workspace)\n        self.vsdd_dir = self.workspace / '.vsdd'\n        self.vsdd_dir.mkdir(parents=True, exist_ok=True)\n        \n        self.index_file = self.vsdd_dir / 'document_index.json'\n        self.index = self._load_index()\n    \n    def _load_index(self) -> Dict[str, Any]:\n        \"\"\"加载文档索引\"\"\"\n        if self.index_file.exists():\n            try:\n                with open(self.index_file, 'r', encoding='utf-8') as f:\n                    return json.load(f)\n            except (json.JSONDecodeError, IOError):\n                pass\n        return {'documents': {}}\n    \n    def _save_index(self):\n        \"\"\"保存文档索引\"\"\"\n        with open(self.index_file, 'w', encoding='utf-8') as f:\n            json.dump(self.index, f, indent=2, ensure_ascii=False)\n    \n    def save(self, doc_name: str, content: str, phase: str = \"\",\n             metadata: Dict[str, Any] = None) -> Path:\n        \"\"\"\n        保存文档\n        \n        Args:\n            doc_name: 文档名称\n            content: 文档内容\n            phase: 所属 Phase\n            metadata: 额外元数据\n        \n        Returns:\n            文档路径\n        \"\"\"\n        doc_path = self.workspace / doc_name\n        doc_path.parent.mkdir(parents=True, exist_ok=True)\n        \n        # 写入文档\n        doc_path.write_text(content, encoding='utf-8')\n        \n        # 更新索引\n        now = datetime.now().isoformat()\n        doc_info = {\n            'name': doc_name,\n            'path': str(doc_path),\n            'created': self.index['documents'].get(doc_name, {}).get('created', now),\n            'modified': now,\n            'phase': phase,\n            'size': len(content),\n            'metadata': metadata or {}\n        }\n        \n        self.index['documents'][doc_name] = doc_info\n        self._save_index()\n        \n        return doc_path\n    \n    def read(self, doc_name: str) -> Optional[str]:\n        \"\"\"\n        读取文档内容\n        \n        Args:\n            doc_name: 文档名称\n        \n        Returns:\n            文档内容，不存在返回 None\n        \"\"\"\n        doc_path = self.workspace / doc_name\n        if doc_path.exists():\n            return doc_path.read_text(encoding='utf-8')\n        return None\n    \n    def exists(self, doc_name: str) -> bool:\n        \"\"\"检查文档是否存在\"\"\"\n        return (self.workspace / doc_name).exists()\n    \n    def delete(self, doc_name: str) -> bool:\n        \"\"\"\n        删除文档\n        \n        Args:\n            doc_name: 文档名称\n        \n        Returns:\n            是否成功删除\n        \"\"\"\n        doc_path = self.workspace / doc_name\n        if doc_path.exists():\n            doc_path.unlink()\n            if doc_name in self.index['documents']:\n                del self.index['documents'][doc_name]\n                self._save_index()\n            return True\n        return False\n    \n    def list_documents(self, phase: str = None) -> List[DocumentInfo]:\n        \"\"\"\n        列出文档\n        \n        Args:\n            phase: 可选，按 Phase 过滤\n        \"\"\"\n        result = []\n        for doc_name, info in self.index['documents'].items():\n            if phase is None or info.get('phase') == phase:\n                result.append(DocumentInfo(\n                    name=doc_name,\n                    path=Path(info['path']),\n                    created=info.get('created', ''),\n                    modified=info.get('modified', ''),\n                    phase=info.get('phase', ''),\n                    size=info.get('size', 0),\n                    metadata=info.get('metadata', {})\n                ))\n        return result\n    \n    def get_document_info(self, doc_name: str) -> Optional[DocumentInfo]:\n        \"\"\"获取文档信息\"\"\"\n        if doc_name in self.index['documents']:\n            info = self.index['documents'][doc_name]\n            return DocumentInfo(\n                name=doc_name,\n                path=Path(info['path']),\n                created=info.get('created', ''),\n                modified=info.get('modified', ''),\n                phase=info.get('phase', ''),\n                size=info.get('size', 0),\n                metadata=info.get('metadata', {})\n            )\n        return None\n    \n    def validate_document(self, doc_name: str, required_sections: List[str] = None) -> Dict[str, Any]:\n        \"\"\"\n        验证文档\n        \n        Args:\n            doc_name: 文档名称\n            required_sections: 必需的章节列表\n        \n        Returns:\n            验证结果字典\n        \"\"\"\n        result = {\n            'valid': True,\n            'errors': [],\n            'warnings': []\n        }\n        \n        content = self.read(doc_name)\n        if content is None:\n            result['valid'] = False\n            result['errors'].append(f\"Document not found: {doc_name}\")\n            return result\n        \n        # 检查文档不为空\n        if len(content.strip()) == 0:\n            result['valid'] = False\n            result['errors'].append(\"Document is empty\")\n            return result\n        \n        # 检查必需章节\n        if required_sections:\n            for section in required_sections:\n                if f\"## {section}\" not in content and f\"# {section}\" not in content:\n                    result['warnings'].append(f\"Missing section: {section}\")\n        \n        return result\n    \n    def create_from_template(self, doc_name: str, template: str, \n                            variables: Dict[str, str] = None) -> Path:\n        \"\"\"\n        从模板创建文档\n        \n        Args:\n            doc_name: 文档名称\n            template: 模板内容\n            variables: 模板变量\n        \n        Returns:\n            文档路径\n        \"\"\"\n        content = template\n        if variables:\n            for key, value in variables.items():\n                content = content.replace(f\"{{{{{key}}}}}\", value)\n        \n        return self.save(doc_name, content)\n    \n    def get_all_documents_content(self) -> Dict[str, str]:\n        \"\"\"获取所有文档内容\"\"\"\n        result = {}\n        for doc_name in self.index['documents']:\n            content = self.read(doc_name)\n            if content:\n                result[doc_name] = content\n        return result\n    \n    def export_workspace(self, output_dir: str) -> bool:\n        \"\"\"\n        导出工作空间\n        \n        Args:\n            output_dir: 输出目录\n        \"\"\"\n        import shutil\n        \n        output_path = Path(output_dir)\n        output_path.mkdir(parents=True, exist_ok=True)\n        \n        for doc_name in self.index['documents']:\n            src = self.workspace / doc_name\n            dst = output_path / doc_name\n            if src.exists():\n                dst.parent.mkdir(parents=True, exist_ok=True)\n                shutil.copy2(src, dst)\n        \n        return True"}},{"type":"toolCall","id":"tool-8c6be959f4a84c0da34156cdea04b155","name":"write","arguments":{"file_path":"/home/one/.openclaw/skills/team-vsdd/core/validator_base.py","content":"\"\"\"\n验证器基类\n\n提供文档和代码验证的基础框架\n\"\"\"\n\nimport re\nfrom pathlib import Path\nfrom typing import Dict, List, Any, Optional, Callable\nfrom dataclasses import dataclass, field\n\n\n@dataclass\nclass ValidationResult:\n    \"\"\"验证结果\"\"\"\n    valid: bool\n    errors: List[str] = field(default_factory=list)\n    warnings: List[str] = field(default_factory=list)\n    details: Dict[str, Any] = field(default_factory=dict)\n\n\nclass BaseValidator:\n    \"\"\"验证器基类\"\"\"\n    \n    def __init__(self, rules: Dict[str, Any] = None):\n        \"\"\"\n        初始化验证器\n        \n        Args:\n            rules: 验证规则字典\n        \"\"\"\n        self.rules = rules or {}\n    \n    def validate(self, content: str, phase: str = None) -> ValidationResult:\n        \"\"\"\n        验证内容\n        \n        Args:\n            content: 要验证的内容\n            phase: Phase 名称（用于选择特定规则）\n        \n        Returns:\n            验证结果\n        \"\"\"\n        result = ValidationResult(valid=True)\n        \n        # 基本验证\n        if not content or len(content.strip()) == 0:\n            result.valid = False\n            result.errors.append(\"Content is empty\")\n            return result\n        \n        # 检查基本 Markdown 结构\n        if not self._has_valid_markdown_structure(content):\n            result.warnings.append(\"Content may not have valid Markdown structure\")\n        \n        return result\n    \n    def _has_valid_markdown_structure(self, content: str) -> bool:\n        \"\"\"检查是否有有效的 Markdown 结构\"\"\"\n        # 检查是否有标题\n        has_header = bool(re.search(r'^#+\\s+.+', content, re.MULTILINE))\n        return has_header\n    \n    def validate_file(self, file_path: str, phase: str = None) -> ValidationResult:\n        \"\"\"\n        验证文件\n        \n        Args:\n            file_path: 文件路径\n            phase: Phase 名称\n        \"\"\"\n        path = Path(file_path)\n        if not path.exists():\n            return ValidationResult(\n                valid=False,\n                errors=[f\"File not found: {file_path}\"]\n            )\n        \n        content = path.read_text(encoding='utf-8')\n        return self.validate(content, phase)\n\n\nclass DocumentValidator(BaseValidator):\n    \"\"\"文档验证器\"\"\"\n    \n    def validate(self, content: str, phase: str = None) -> ValidationResult:\n        \"\"\"验证文档\"\"\"\n        result = super().validate(content, phase)\n        \n        # 根据不同 Phase 执行特定验证\n        if phase == 'spec':\n            return self._validate_spec(content, result)\n        elif phase == 'design':\n            return self._validate_design(content, result)\n        elif phase == 'test_design':\n            return self._validate_test_design(content, result)\n        elif phase == 'code_impl':\n            return self._validate_code_impl(content, result)\n        elif phase == 'review_report':\n            return self._validate_review_report(content, result)\n        \n        return result\n    \n    def _validate_spec(self, content: str, result: ValidationResult) -> ValidationResult:\n        \"\"\"验证规格文档\"\"\"\n        required_sections = ['功能描述', '接口设计', '约束条件']\n        self._check_sections(content, required_sections, result)\n        return result\n    \n    def _validate_design(self, content: str, result: ValidationResult) -> ValidationResult:\n        \"\"\"验证设计文档\"\"\"\n        required_sections = ['架构设计', '模块设计']\n        self._check_sections(content, required_sections, result)\n        return result\n    \n    def _validate_test_design(self, content: str, result: ValidationResult) -> ValidationResult:\n        \"\"\"验证测试设计文档\"\"\"\n        required_sections = ['测试策略', '测试用例']\n        self._check_sections(content, required_sections, result)\n        return result\n    \n    def _validate_code_impl(self, content: str, result: ValidationResult) -> ValidationResult:\n        \"\"\"验证代码实现文档\"\"\"\n        required_sections = ['修改文件清单', '关键代码实现']\n        self._check_sections(content, required_sections, result)\n        return result\n    \n    def _validate_review_report(self, content: str, result: ValidationResult) -> ValidationResult:\n        \"\"\"验证审查报告\"\"\"\n        required_sections = ['审查结果', '问题清单']\n        self._check_sections(content, required_sections, result)\n        return result\n    \n    def _check_sections(self, content: str, sections: List[str], \n                       result: ValidationResult):\n        \"\"\"检查必需章节\"\"\"\n        for section in sections:\n            if f\"## {section}\" not in content and f\"# {section}\" not in content:\n                result.warnings.append(f\"Missing recommended section: {section}\")\n\n\nclass DomainValidator(BaseValidator):\n    \"\"\"领域验证器\"\"\"\n    \n    def __init__(self, rules: Dict[str, Any] = None):\n        \"\"\"\n        初始化领域验证器\n        \n        Args:\n            rules: 领域验证规则\n        \"\"\"\n        super().__init__(rules)\n        self.phase_validators = self._build_phase_validators()\n    \n    def _build_phase_validators(self) -> Dict[str, List[Callable]]:\n        \"\"\"构建 Phase 特定验证器\"\"\"\n        validators = {}\n        \n        # 从规则构建验证器\n        for phase, rules in self.rules.get('phase_rules', {}).items():\n            validators[phase] = []\n            \n            # 添加验证函数\n            if 'required_sections' in rules:\n                sections = rules['required_sections']\n                validators[phase].append(\n                    lambda c, s=sections: self._check_required_sections(c, s)\n                )\n            \n            if 'required_keywords' in rules:\n                keywords = rules['required_keywords']\n                validators[phase].append(\n                    lambda c, k=keywords: self._check_required_keywords(c, k)\n                )\n        \n        return validators\n    \n    def _check_required_sections(self, content: str, sections: List[str]) -> List[str]:\n        \"\"\"检查必需章节\"\"\"\n        missing = []\n        for section in sections:\n            if f\"## {section}\" not in content and f\"# {section}\" not in content:\n                missing.append(section)\n        return missing\n    \n    def _check_required_keywords(self, content: str, keywords: List[str]) -> List[str]:\n        \"\"\"检查必需关键词\"\"\"\n        missing = []\n        for keyword in keywords:\n            if keyword not in content:\n                missing.append(keyword)\n        return missing\n    \n    def validate(self, content: str, phase: str = None) -> ValidationResult:\n        \"\"\"验证内容\"\"\"\n        result = super().validate(content, phase)\n        \n        if phase and phase in self.phase_validators:\n            for validator in self.phase_validators[phase]:\n                issues = validator(content)\n                if issues:\n                    for issue in issues:\n                        result.warnings.append(f\"Missing: {issue}\")\n        \n        # 验证测试重点\n        test_focus = self.rules.get('test_focus', [])\n        if test_focus and phase in ['test_design', 'test_impl']:\n            for focus in test_focus:\n                if focus not in content:\n                    result.warnings.append(f\"Test focus '{focus}' not addressed\")\n        \n        return result\n    \n    def validate_phase(self, phase: str, doc_path: str) -> ValidationResult:\n        \"\"\"验证 Phase 输出\"\"\"\n        path = Path(doc_path)\n        if not path.exists():\n            return ValidationResult(\n                valid=False,\n                errors=[f\"Document not found: {doc_path}\"]\n            )\n        \n        content = path.read_text(encoding='utf-8')\n        return self.validate(content, phase)\n\n\nclass ValidationRuleBuilder:\n    \"\"\"验证规则构建器\"\"\"\n    \n    def __init__(self):\n        self.rules = {\n            'phase_rules': {},\n            'test_focus': [],\n            'verify_tools': [],\n            'performance_metrics': [],\n            'adversarial_checks': []\n        }\n    \n    def add_phase_rule(self, phase: str, required_sections: List[str] = None,\n                       required_keywords: List[str] = None) -> 'ValidationRuleBuilder':\n        \"\"\"添加 Phase 规则\"\"\"\n        if phase not in self.rules['phase_rules']:\n            self.rules['phase_rules'][phase] = {}\n        \n        if required_sections:\n            self.rules['phase_rules'][phase]['required_sections'] = required_sections\n        if required_keywords:\n            self.rules['phase_rules'][phase]['required_keywords'] = required_keywords\n        \n        return self\n    \n    def add_test_focus(self, focus: str) -> 'ValidationRuleBuilder':\n        \"\"\"添加测试重点\"\"\"\n        self.rules['test_focus'].append(focus)\n        return self\n    \n    def add_verify_tool(self, tool: str) -> 'ValidationRuleBuilder':\n        \"\"\"添加验证工具\"\"\"\n        self.rules['verify_tools'].append(tool)\n        return self\n    \n    def add_performance_metric(self, metric: str) -> 'ValidationRuleBuilder':\n        \"\"\"添加性能指标\"\"\"\n        self.rules['performance_metrics'].append(metric)\n        return self\n    \n    def add_adversarial_check(self, check: str) -> 'ValidationRuleBuilder':\n        \"\"\"添加对抗审查检查项\"\"\"\n        self.rules['adversarial_checks'].append(check)\n        return self\n    \n    def build(self) -> Dict[str, Any]:\n        \"\"\"构建规则字典\"\"\"\n        return self.rules"}}],"api":"openai-completions","provider":"bailian","model":"glm-5","usage":{"input":94,"output":11115,"cacheRead":14203,"cacheWrite":0,"totalTokens":25412,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772345588641}}
