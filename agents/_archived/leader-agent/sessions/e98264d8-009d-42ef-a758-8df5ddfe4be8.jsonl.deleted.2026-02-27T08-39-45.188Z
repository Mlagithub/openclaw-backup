{"type":"message","id":"557cb7d0","parentId":"d47f3c66","timestamp":"2026-02-27T07:48:50.553Z","message":{"role":"toolResult","toolCallId":"call_2d80d99fbc1c453d9ebeeedf","toolName":"exec","content":[{"type":"text","text":"451 web/server.js\n    const previews = {};\n    for (let rating = 1; rating <= 5; rating++) {\n      const result = FSRSEngine.previewIntervals(card, rating);\n      if (result) {\n        previews[rating] = formatInterval(result.interval);\n      }\n    }\n    \n    res.json({ success: true, data: previews });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Review card with FSRS rating\napp.post('/api/review/:id', (req, res) => {\n  try {\n    const { rating } = req.body;\n    if (!rating || rating < 1 || rating > 5) {\n      return res.status(400).json({ success: false, error: 'Rating must be 1-5' });\n    }\n    \n    const card = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    if (!card) {\n      return res.status(404).json({ success: false, error: 'Card not found' });\n    }\n    \n    // Use FSRS engine for scheduling\n    const fsrsCard = FSRSEngine.dbToCard(card);\n    const result = FSRSEngine.repeat(fsrsCard, rating);\n    \n    if (!result) {\n      return res.status(500).json({ success: false, error: 'Failed to calculate FSRS' });\n    }\n    \n    // Update card\n    const now = new Date();\n    db.prepare(`\n      UPDATE cards SET\n        due_date = ?,\n        interval = ?,\n        ease_factor = ?,\n        repetitions = ?,\n        lapses = ?,\n        state = ?,\n        last_review = ?\n      WHERE id = ?\n    `).run(\n      result.due_date,\n      result.interval,\n      result.ease_factor,\n      result.repetitions,\n      result.lapses,\n      result.state,\n      now.toISOString(),\n      req.params.id\n    );\n    \n    const updatedCard = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    res.json({ \n      success: true, \n      data: updatedCard, \n      nextInterval: formatInterval(result.interval)\n    });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Helper function to format interval - properly handles minutes\nfunction formatInterval(days) {\n  if (days < 1) {\n    // Convert to minutes (days * 24 * 60)\n    const minutes = Math.round(days * 24 * 60);\n    if (minutes < 60) {\n      return `${minutes}m`;\n    } else {\n      // If more than 60 minutes, show hours\n      return `${Math.round(minutes / 60)}h`;\n    }\n  } else if (days < 30) {\n    return `${Math.round(days)}d`;\n  } else if (days < 365) {\n    return `${Math.round(days / 30)}mo`;\n  } else {\n    return `${Math.round(days / 365)}y`;\n  }\n}\n\n// Serve SPA for all other routes\napp.get('*', (req, res) => {\n  res.sendFile(path.join(__dirname, 'public', 'index.html'));\n});\n\n// Start server\napp.listen(PORT, () => {\n  console.log(`FSRS Web UI server running on http://localhost:${PORT}`);\n});\n\nmodule.exports = app;"}],"details":{"status":"completed","exitCode":0,"durationMs":7,"aggregated":"451 web/server.js\n    const previews = {};\n    for (let rating = 1; rating <= 5; rating++) {\n      const result = FSRSEngine.previewIntervals(card, rating);\n      if (result) {\n        previews[rating] = formatInterval(result.interval);\n      }\n    }\n    \n    res.json({ success: true, data: previews });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Review card with FSRS rating\napp.post('/api/review/:id', (req, res) => {\n  try {\n    const { rating } = req.body;\n    if (!rating || rating < 1 || rating > 5) {\n      return res.status(400).json({ success: false, error: 'Rating must be 1-5' });\n    }\n    \n    const card = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    if (!card) {\n      return res.status(404).json({ success: false, error: 'Card not found' });\n    }\n    \n    // Use FSRS engine for scheduling\n    const fsrsCard = FSRSEngine.dbToCard(card);\n    const result = FSRSEngine.repeat(fsrsCard, rating);\n    \n    if (!result) {\n      return res.status(500).json({ success: false, error: 'Failed to calculate FSRS' });\n    }\n    \n    // Update card\n    const now = new Date();\n    db.prepare(`\n      UPDATE cards SET\n        due_date = ?,\n        interval = ?,\n        ease_factor = ?,\n        repetitions = ?,\n        lapses = ?,\n        state = ?,\n        last_review = ?\n      WHERE id = ?\n    `).run(\n      result.due_date,\n      result.interval,\n      result.ease_factor,\n      result.repetitions,\n      result.lapses,\n      result.state,\n      now.toISOString(),\n      req.params.id\n    );\n    \n    const updatedCard = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    res.json({ \n      success: true, \n      data: updatedCard, \n      nextInterval: formatInterval(result.interval)\n    });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Helper function to format interval - properly handles minutes\nfunction formatInterval(days) {\n  if (days < 1) {\n    // Convert to minutes (days * 24 * 60)\n    const minutes = Math.round(days * 24 * 60);\n    if (minutes < 60) {\n      return `${minutes}m`;\n    } else {\n      // If more than 60 minutes, show hours\n      return `${Math.round(minutes / 60)}h`;\n    }\n  } else if (days < 30) {\n    return `${Math.round(days)}d`;\n  } else if (days < 365) {\n    return `${Math.round(days / 30)}mo`;\n  } else {\n    return `${Math.round(days / 365)}y`;\n  }\n}\n\n// Serve SPA for all other routes\napp.get('*', (req, res) => {\n  res.sendFile(path.join(__dirname, 'public', 'index.html'));\n});\n\n// Start server\napp.listen(PORT, () => {\n  console.log(`FSRS Web UI server running on http://localhost:${PORT}`);\n});\n\nmodule.exports = app;","cwd":"/home/one/.openclaw/agents/leader-agent"},"isError":false,"timestamp":1772178530549}}
