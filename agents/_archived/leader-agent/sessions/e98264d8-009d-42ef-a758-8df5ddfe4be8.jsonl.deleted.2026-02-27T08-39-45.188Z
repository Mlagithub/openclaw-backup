{"type":"message","id":"e027c988","parentId":"46052e19","timestamp":"2026-02-27T07:43:39.963Z","message":{"role":"toolResult","toolCallId":"call_77c726233b70457eaae2f2f6","toolName":"exec","content":[{"type":"text","text":"[\n\n{\"name\":\"@2anki/csv-to-apkg\",\"keywords\":[\"notion\",\"title\",\"page\",\"title\"],\"version\":\"1.4.9\",\"description\":\"convert CSV files to Anki flashcards (APKG)\",\"sanitized_name\":\"@2anki/csv-to-apkg\",\"publisher\":{\"email\":\"alexander@alemayhu.com\",\"username\":\"aalemayhu\"},\"maintainers\":[{\"email\":\"alexander@alemayhu.com\",\"username\":\"aalemayhu\"}],\"license\":\"MIT\",\"date\":\"2024-10-17T03:38:15.282Z\",\"links\":{\"homepage\":\"https://github.com/2anki/csv-to-apkg#readme\",\"repository\":\"git+https://github.com/2anki/csv-to-apkg.git\",\"bugs\":\"https://github.com/2anki/csv-to-apkg/issues\",\"npm\":\"https://www.npmjs.com/package/@2anki/csv-to-apkg\"}}\n\n,\n\n{\"name\":\"anki-apkg-generator\",\"keywords\":[\"anki\",\"apkg\"],\"version\":\"1.0.7\",\"description\":\"generate anki's apkg file by code\",\"sanitized_name\":\"anki-apkg-generator\",\"publisher\":{\"email\":\"335658202@qq.com\",\"username\":\"fuwanqun_luck\"},\"maintainers\":[{\"email\":\"335658202@qq.com\",\"username\":\"fuwanqun_luck\"}],\"license\":\"MIT\",\"date\":\"2022-03-08T23:43:34.538Z\",\"links\":{\"homepage\":\"https://github.com/babycannotsay/anki-apkg-generator#readme\",\"repository\":\"git+https://github.com/babycannotsay/anki-apkg-generator.git\",\"bugs\":\"https://github.com/babycannotsay/anki-apkg-generator/issues\",\"npm\":\"https://www.npmjs.com/package/anki-apkg-generator\"}}\n\n,\n\n{\"name\":\"anki-reader\",\"keywords\":[\"anki\",\"apkg\",\"collection\",\"reader\",\"anki-reader\",\"flashcards\"],\"version\":\"0.3.0\",\"description\":\"A library for reading Anki apkg and collection files.\",\"sanitized_name\":\"anki-reader\",\"publisher\":{\"email\":\"ewei068@berkeley.edu\",\"username\":\"ewei068\"},\"maintainers\":[{\"email\":\"