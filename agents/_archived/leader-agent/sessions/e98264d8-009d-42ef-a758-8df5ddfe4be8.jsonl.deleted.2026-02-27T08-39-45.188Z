mpleNote = db.prepare('SELECT * FROM notes LIMIT 1').get();\n    console.log('Sample note fields:', Object.keys(sampleNote));\n    console.log('Sample note flds:', sampleNote.flds ? sampleNote.flds.substring(0, 100) : 'N/A');\n    \n    db.close();\n    \n    // Cleanup\n    fs.unlinkSync(tempDb);\n    fs.rmdirSync(tempDir);\n  }\n  \n} catch (error) {\n  console.error('Error:', error.message);\n}\n\" 2>&1"}}],"api":"openai-completions","provider":"bailian","model":"qwen3.5-plus","usage":{"input":42833,"output":613,"cacheRead":0,"cacheWrite":0,"totalTokens":43446,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772178462518}}
