ead\",\"content\":[{\"type\":\"text\",\"text\":\"\\n    const { deckId } = req.body;\\n    const targetDeckId = deckId ? parseInt(deckId) : 1;\\n\\n    const importer = new APKGImporter(db);\\n    const result = await importer.import(req.file.path, targetDeckId);\\n    fs.unlinkSync(req.file.path);\\n\\n    if (!result.success) return res.status(400).json(result);\\n    res.json(result);\\n  } catch (error) {\\n    if (req.file && fs.existsSync(req.file.path)) fs.unlinkSync(req.file.path);\\n    res.status(500).json({ success: false, error: error.message });\\n  }\\n});\\n\\n// ==================== Phase 3 API Routes ====================\\nsetupPhase3API(app, db);\\n\\n// Serve SPA\\napp.get('*', (req, res) => {\\n  res.sendFile(path.join(__dirname, 'public', 'index.html'));\\n});\\n\\n// Start server\\napp.listen(PORT, () => {\\n  console.log(`FSRS Web UI server (Phase 3) running on http://localhost:${PORT}`);\\n});\\n\\nmodule.exports = app;\\n\\n// ==================== Phase 4 API Routes ====================\\n// Run Phase 4 migration first\\ntry {\\n  const { execSync } = require('child_process');\\n  console.log('Running Phase 4 database migration...');\\n  execSync('node \\\"' + path.join(__dirname, '..', 'src', 'migrate-phase4.js') + '\\\"', { stdio: 'inherit' });\\n} catch (error) {\\n  console.error('Phase 4 migration failed:', error.message);\\n}\\n\\n// Setup Phase 4 API\\nconst setupPhase4API = require('../src/api-phase4');\\nsetupPhase4API(app, db);\\n\\nconsole.log('Phase 4 features enabled: Daily Limits & Template Enhancements');\\n\"}],\"isError\":false,\"timestamp\":1772188272272}}\n{\"type\":\"message\",\"id\":\"21822e19\",\"parentId\":\"6359fda3\",\"timestamp\":\"2026-02-27T10:31:15.974Z\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"I identified the root cause - Phase 4 API routes are registered after the catch-all route and module.exports, so I need to fix the server.js file by moving Phase 4 setup befor