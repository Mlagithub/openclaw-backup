r);\\\\n  }\\\\n}\\\\n\\\\nfixCardStates();\\\\n\\\\nfunction getLocalNow() {\\\\n  return new Date().toISOString();\\\\n}\\\\n\\\\n// ==================== Settings API ====================\\\\n\\\\napp.get('/api/settings/theme', (req, res) => {\\\\n  try {\\\\n    const theme = db.prepare(\\\\\\\"SELECT value FROM settings WHERE key = 'theme'\\\\\\\").get();\\\\n    res.json({ success: true, data: theme ? theme.value : 'light' });\\\\n  } catch (error) {\\\\n    res.status(500).json({ success: false, error: error.message });\\\\n  }\\\\n});\\\\n\\\\napp.post('/api/settings/theme', (req, res) => {\\\\n  try {\\\\n    const { theme } = req.body;\\\\n    if (!theme || !['light', 'dark'].includes(theme)) {\\\\n      return res.status(400).json({ success: false, error: 'Invalid theme' });\\\\n    }\\\\n    db.prepare(`\\\\n      INSERT INTO settings (key, value) VALUES ('theme', ?)\\\\n      ON CONFLICT(key) DO UPDATE SET value = excluded.value\\\\n    `).run(theme);\\\\n    res.json({ success: true, data: theme });\\\\n  } catch (error) {\\\\n    res.status(500).json({ success: false, error: error.message });\\\\n  }\\\\n});\\\\n\\\\n// ==================== Deck API ====================\\\\n\\\\napp.get('/api/decks', (req, res) => {\\\\n  try {\\\\n    const decks = db.prepare(`\\\\n      SELECT d.*, \\\\n        (SELECT COUNT(*) FROM cards WHERE deck_id = d.id) as card_count,\\\\n        (SELECT COUNT(*) FROM cards WHERE deck_id = d.id AND strftime('%s', due_date) <= strftime('%s', 'now')) as due_count\\\\n      FROM decks d \\\\n      ORDER BY d.id ASC\\\\n    `).all();\\\\n    res.json({ success: true, data: decks });\\\\n  } catch (error) {\\\\n    res.status(500).json({ success: false, error: error.message });\\\\n  }\\\\n});\\\\n\\\\napp.get('/api/decks/:id', (req, res) => {\\\\n  try {\\\\n    const deck = db.prepare('SELECT * FROM decks WHERE id = ?').get(req.params.id);\\\\n    if (!deck) return res.status(404).json({ success: false, error: 'Deck not found' });\\\\n    res.json({ success: true, data: deck });\\\\n  } catch (error) {\\\\n    res.status(500).json({ success: false, error: error.message });\\\\n  }\\\\n});\\\\n\\\\napp.post('/api/decks', (req, res) => {\\\\n  try {\\\\n    const { name, description } = req.body;\\\\n    if (!name) return res.status(400).json({ success: false, error: 'Deck name required' });\\\\n    \\\\n    const result = db.prepare('INSERT INTO decks (name, description) VALUES (?, ?)').run(name, description || '');\\\\n    const newDeck = db.prepare('SELECT * FROM decks WHERE id = ?').get(result.lastInsertRowid);\\\\n    res.json({ success: true, data: newDeck });\\\\n  } catch (error) {\\\\n    if (error.message.includes('UNIQUE')) {\\\\n      return res.status(400).json({ success: false, error: 'Deck name already exists' });\\\\n    }\\\\n    res.status(500).json({ success: false, error: error.message });\\\\n  }\\\\n});\\\\n\\\\napp.put('/api/decks/:id', (req, res) => {\\\\n  try {\\\\n    const { name, description } = req.body;\\\\n    const deckId = parseInt(req.params.id);\\\\n    \\\\n    if (deckId === 1) return res.status(400).json({ success: false, error: 'Cannot modify default deck' });\\\\n    \\\\n    db.prepare(`UPDATE decks SET name = ?, description = ?, updated_at = datetime('now') WHERE id = ?`).run(name, description || '', deckId);\\\\n    const updatedDeck = db.prepare('SELECT * FROM decks WHERE id = ?').get(deckId);\\\\n    res.json({ success: true, data: updatedDeck });\\\\n  } catch (error) {\\\\n    if (error.message.includes('UNIQUE')) {\\\\n      return res.status(400).json({ success: false, error: 'Deck name already exists' });\\\\n    }\\\\n    res.status(500).json({ success: false, error: error.message });\\\\n  }\\\\n});\\\\n\\\\napp.delete('/api/decks/:id', (req, res) => {\\\\n  try {\\\\n    const deckId = parseInt(req.params.id);\\\\n    if (deckId === 1) return res.status(400).json({ success: false, error: 'Cannot delete default deck' });\\\\n    \\\\n    db