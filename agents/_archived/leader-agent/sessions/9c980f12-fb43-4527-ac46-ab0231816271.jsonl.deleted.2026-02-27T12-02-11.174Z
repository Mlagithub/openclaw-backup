\\n    </div>\\\\n  </div>\\\\n\\\\n\\\\n  <!-- Template Modal -->\\\\n  <div class=\\\\\\\"modal fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50\\\\\\\" id=\\\\\\\"template-modal\\\\\\\" style=\\\\\\\"display: none;\\\\\\\">\\\\n    <div class=\\\\\\\"modal-content bg-white dark:bg-gray-800 rounded-xl p-8 max-w-2xl w-full mx-4\\\\\\\">\\\\n      <h3 class=\\\\\\\"text-xl font-bold mb-4\\\\\\\">新建/编辑模板</h3>\\\\n      <div class=\\\\\\\"grid grid-cols-2 gap-4 mb-4\\\\\\\">\\\\n        <div>\\\\n          <label class=\\\\\\\"block text-sm font-medium mb-2\\\\\\\">模板名称</label>\\\\n          <input type=\\\\\\\"text\\\\\\\" id=\\\\\\\"template-name\\\\\\\" class=\\\\\\\"w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700\\\\\\\" placeholder=\\\\\\\"基础卡\\\\\\\">\\\\n        </div>\\\\n        <div>\\\\n          <label class=\\\\\\\"block text-sm font-medium mb-2\\\\\\\">类型</label>\\\\n          <select id=\\\\\\\"template-type\\\\\\\" class=\\\\\\\"w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700\\\\\\\">\\\\n            <option value=\\\\\\\"basic\\\\\\\">基础卡</option>\\\\n            <option value=\\\\\\\"reverse\\\\\\\">反向卡</option>\\\\n            <option value=\\\\\\\"cloze\\\\\\\">填空卡</option>\\\\n          </select>\\\\n        </div>\\\\n      </div>\\\\n      <div class=\\\\\\\"mb-4\\\\\\\">\\\\n        <label class=\\\\\\\"block text-sm font-medium mb-2\\\\\\\">正面模板</label>\\\\n        <textarea id=\\\\\\\"template-front\\\\\\\" rows=\\\\\\\"3\\\\\\\" class=\\\\\\\"w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 font-mono text-sm\\\\\\\" placeholder=\\\\\\\"{{question}}\\\\\\\"></textarea>\\\\n      </div>\\\\n      <div class=\\\\\\\"mb-4\\\\\\\">\\\\n        <label class=\\\\\\\"block text-sm font-medium mb-2\\\\\\\">背面模板</label>\\\\n        <textarea id=\\\\\\\"template-back\\\\\\\" rows=\\\\\\\"3\\\\\\\" class=\\\\\\\"w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 font-mono text-sm\\\\\\\" placeholder=\\\\\\\"{{question}}&#10;<hr>&#10;{{answer}}\\\\\\\"></textarea>\\\\n      </div>\\\\n      <div class=\\\\\\\"mb-6\\\\\\\">\\\\n        <label class=\\\\\\\"block text-sm font-medium mb-2\\\\\\\">CSS 样式</label>\\\\n        <textarea id=\\\\\\\"template-css\\\\\\\" rows=\\\\\\\"3\\\\\\\" class=\\\\\\\"w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 font-mono text-sm\\\\\\\" placeholder=\\\\\\\".card { font-family: Arial; }\\\\\\\"></textarea>\\\\n      </div>\\\\n      <div class=\\\\\\\"modal-actions flex gap-3 justify-end\\\\\\\">\\\\n        <button class=\\\\\\\"px-4 py-2 border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg\\\\\\\" onclick=\\\\\\\"document.getElementById('template-modal').style.display='none'\\\\\\\">取消</button>\\\\n        <button class=\\\\\\\"px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg\\\\\\\" onclick=\\\\\\\"saveTemplate()\\\\\\\">保存</button>\\\\n      </div>\\\\n    </div>\\\\n  </div>\\\\n\\\\n  <!-- Toast -->\\\\n  <div class=\\\\\\\"toast fixed bottom-6 right-6 px-6 py-4 rounded-lg shadow-lg transform translate-y-20 opacity-0 transition-all duration-300 z-50 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700\\\\\\\" id=\\\\\\\"toast\\\\\\\"></div>\\\\n\\\\n  <script src=\\\\\\\"app.js\\\\\\\"></script>\\\\n</body>\\\\n</html>\\\"}],\\\"details\\\":{\\\"status\\\":\\\"completed\\\",\\\"exitCode\\\":0,\\\"durationMs\\\":13,\\\"aggregated\\\":\\\"<!DOCTYPE html>\\\\n<html lang=\\\\\\\"zh-CN\\\\\\\">\\\\n<head>\\\\n  <meta charset=\\\\\\\"UTF-8\\\\\\\">\\\\n  <meta name=\\\\\\\"viewport\\\\\\\" content=\\\\\\\"width=device-width, initial-scale=1.0\\\\\\\">\\\\n  <title>FSRS Memory - 智能记忆卡片</title>\\\\n  \\\\n  <!-- Tailwind CSS -->\\\\n  <script src=\\\\\\\"https://cdn.tailwindcss.com\\\\\\\"></script>\\\\n  \\\\n  <!-- Phosphor Icons -->\\\\n  <script src=\\\\\\\"https://unpkg.com/@phosphor-icons/web\\\\\\\"></script>\\\\n  <script src=\\\\\\\"https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js\\\\\\\"></script>\\\\n  \\\\n  <!-- Custom Config -->\\\\n  <script>\\\\n    tailwind.config = {\\\\n      darkMode: 'class',\\\\n      theme: {\\\\n        extend: {\\\\n          colors: {\\\\n            primary: {\\\\n              50: '#eff6ff',\\\\n              100: '#dbeafe',\\\\n              200: '#bfdbfe',\\\\n              300: '#93c5fd',\\\\n              400: '#60a5fa',\\\\n              500: '#3b82f6',\\\\n              600: '#2563eb',\\\\n              700: '#1d4ed8',\\\\n              800: '#1e40af',\\\\n              900: '#1e3a8a',\\\\n            }\\\\n          }\\\\n        }\\\\n      }\\\\n    }\\\\n  </script>\\\\n  \\\\n  <style>\\\\n    .card-flip { perspective: 1000px; }\\\\n    .card-inner { transition: transform 0.6s; transform-style: preserve-3d; }\\\\n    .card-flipped .card-inner { transform: rotateY(180deg); }\\\\n    .card-front, .card-back { backface-visibility: hidden; }\\\\n    .card-back { transform: rotateY(180deg); }\\\\n    .fade-in { animation: fadeIn 0.3s ease-in; }\\\\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }\\\\n    ::-webkit-scrollbar { width: 8px; height: 8px; }\\\\n    ::-webkit-scrollbar-track { background: transparent; }\\\\n    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }\\\\n    .dark ::-webkit-scrollbar-thumb { background: #475569; }\\\\n    .mobile-menu { display: none; }\\\\n    @media (max-width: 768px) {\\\\n      .sidebar { transform: translateX(-100%); position: fixed; z-index: 50; transition: transform 0.3s ease; }\\\\n      .sidebar.open { transform: translateX(0); }\\\\n      .mobile-menu { display: flex; }\\\\n      .main-content { margin-left: 0 !important; }\\\\n    }\\\\n  </style>\\\\n</head>\\\\n<body class=\\\\\\\"bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors duration-200\\\\\\\">\\\\n  <div id=\\\\\\\"app\\\\\\\" class=\\\\\\\"flex h-screen overflow-hidden\\\\\\\">\\\\n    \\\\n    <!-- Mobile Menu Button -->\\\\n    <button class=\\\\\\\"mobile-menu fixed top-4 left-4 z-50 p-2 bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-700\\\\\\\" onclick=\\\\\\\"toggleMobileMenu()\\\\\\\">\\\\n      <i class=\\\\\\\"ph ph-list text-2xl\\\\\\\"></i>\\\\n    </button>\\\\n    \\\\n    <!-- Sidebar -->\\\\n    <aside class=\\\\\\\"sidebar w-64 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 flex flex-col transition-all duration-300\\\\\\\">\\\\n      <div class=\\\\\\\"p-6 border-b border-gray-200 dark:border-gray-700\\\\\\\">\\\\n        <div class=\\\\\\\"flex items-center gap-3\\\\\\\">\\\\n          <i class=\\\\\\\"ph ph-brain text-3xl text-primary-600\\\\\\\"></i>\\\\n          <h1 class=\\\\\\\"text-xl font-bold\\\\\\\">FSRS Memory</h1>\\\\n        </div>\\\\n      </div>\\\\n      \\\\n      <nav class=\\\\\\\"flex-1 p-4 space-y-1 overflow-y-auto\\\\\\\">\\\\n        <button class=\\\\\\\"nav-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors\\\\\\\" data-view=\\\\\\\"study\\\\\\\">\\\\n          <i class=\\\\\\\"ph ph-book-open text-xl\\\\\\\"></i>\\\\n          <span>学习</span>\\\\n          <span class=\\\\\\\"ml-auto badge bg-primary-100 dark:bg-primary-900 text-primary-700 dark:text-primary-300 px-2 py-0.5 rounded-full text-xs font-medium\\\\\\\" id=\\\\\\\"due-badge\\\\\\\">0</span>\\\\n        </button>\\\\n        <button class=\\\\\\\"nav-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors\\\\\\\" data-view=\\\\\\\"cards\\\\\\\">\\\\n          <i class=\\\\\\\"ph ph-cards text-xl\\\\\\\"></i>\\\\n          <span>卡片</span>\\\\n        </button>\\\\n        <button class=\\\\\\\"nav-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors\\\\\\\" data-view=\\\\\\\"decks\\\\\\\">\\\\n          <i class=\\\\\\\"ph ph-folder-open text-xl\\\\\\\"></i>\\\\n          <span>牌组</span>\\\\n        </button>\\\\n        <button class=\\\\\\\"nav-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors\\\\\\\" data-view=\\\\\\\"add\\\\\\\">\\\\n          <i class=\\\\\\\"ph ph-plus-circle text-xl\\\\\\\"></i>\\\\n          <span>添加</span>\\\\n        </button>\\\\n        <button class=\\\\\\\"nav-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors\\\\\\\" data-view=\\\\\\\"import\\\\\\\">\\\\n          <i class=\\\\\\\"ph ph-download-simple text-xl\\\\\\\"></i>\\\\n          <span>导入</span>\\\\n        </button>\\\\n        <button class=\\\\\\\"nav-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors\\\\\\\" data-view=\\\\\\\"stats\\\\\\\">\\\\n          <i class=\\\\\\\"ph ph-chart-bar text-xl\\\\\\\"></i>\\\\n          <span>统计</span>\\\\n        </button>\\\\n      </nav>\\\\n        <button class=\\\\\\\"nav-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors\\\\\\\" data-view=\\\\\\\"templates\\\\\\\">\\\\n          <i class=\\\\\\\"ph ph-palette text-xl\\\\\\\"></i>\\\\n          <span>模板</span>\\\\n        </button>\\\\n        <button class=\\\\\\\"nav-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors\\\\\\\" data-view=\\\\\\\"media\\\\\\\">\\\\n          <i class=\\\\\\\"ph ph-image text-xl\\\\\\\"></i>\\\\n          <span>媒体</span>\\\\n        </button>\\\\n        <button class=\\\\\\\"nav-item w-full flex items-center gap-3 px-4 py-3 rounded-lg text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors\\\\\\\" data-view=\\\\\\\"export\\\\\\\">\\\\n          <i class=\\\\\\\"ph ph-export text-xl\\\\\\\"></i>\\\\n          <span>导出</span>\\\\n        </button>\\\\n      \\\\n      <div class=\\\\\\\"p-4 border-t border-gray-200 dark:border-gray-700\\\\\\\">\\\\n        <div class=\\\\\\\"grid grid-cols-2 gap-2\\\\\\\">\\\\n          <div class=\\\\\\\"text-center p-2 bg-gray-50 dark:bg-gray-700 rounded-lg\\\\\\\">\\\\n            <div class=\\\\\\\"text-lg font-bold text-primary-600\\\\\\\" id=\\\\\\\"total-cards\\\\\\\">0</div>\\\\n            <div class=\\\\\\\"text-xs text-gray-500 dark:text-gray-400\\\\\\\">总卡片</div>\\\\n          </div>\\\\n          <div class=\\\\\\\"text-center p-2 bg-gray-50 dark:bg-gray-700 rounded-lg\\\\\\\">\\\\n            <div class=\\\\\\\"text-lg font-bold text-orange-600\\\\\\\" id=\\\\\\\"due-cards\\\\\\\">0</div>\\\\n            <div class=\\\\\\\"text-xs text-gray-500 dark:text-gray-400\\\\\\\">待复习</div>\\\\n          </div>\\\\n        </div>\\\\n      </div>\\\\n      \\\\n      <div class=\\\\\\\"p-4 border-t border-gray-200 dark:border-gray-700\\\\\\\">\\\\n        <button id=\\\\\\\"theme-toggle-btn\\\\\\\" onclick=\\\\\\\"toggleTheme()\\\\\\\" class=\\\\\\\"w-full flex items-center justify-center gap-2 px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors\\\\\\\">\\\\n          <i class=\\\\\\\"ph ph-moon text-lg\\\\\\\" id=\\\\\\\"theme-icon\\\\\\\"></i>\\\\n          <span id=\\\\\\\"theme-text\\\\\\\">暗色模式</span>\\\\n        </button>\\\\n      </div>\\\\n    </aside>\\\\n    \\\\n    <main class=\\\\\\\"main-content flex-1 overflow-y-auto ml-64 transition-all duration-300\\\\\\\">\\\\n      <header class=\\\\\\\"bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 px-6 py-4\\\\\\\">\\\\n        <div class=\\\\\\\"flex items-center justify-between\\\\\\\">\\\\n          <div>\\\\n            <h2 class=\\\\\\\"text-2xl font-bold\\\\\\\" id=\\\\\\\"page-title\\\\\\\">今日学习</h2>\\\\n            <p class=\\\\\\\"text-sm text-gray-500 dark:text-gray-400 mt-1\\\\\\\" id=\\\\\\\"page-subtitle\\\\\\\">开始你的复习之旅</p>\\\\n          </div>\\\\n          <div class=\\\\\\\"flex items-center gap-4\\\\\\\">\\\\n            <select id=\\\\\\\"deck-select\\\\\\\" onchange=\\\\\\\"changeDeck(this.value)\\\\\\\" class=\\\\\\\"px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-500\\\\\\\">\\\\n              <option value=\\\\\\\"\\\\\\\">全部牌组</option>\\\\n            </select>\\\\n          </div>\\\\n        </div>\\\\n      </header>\\\\n      \\\\n      <div class=\\\\\\\"p-6\\\\\\\">\\\\n        <!-- Study View -->\\\\n        <section id=\\\\\\\"study-view\\\\\\\" class=\\\\\\\"view active fade-in\\\\\\\">\\\\n          <div class=\\\\\\\"max-w-2xl mx-auto\\\\\\\">\\\\n            <div class=\\\\\\\"mb-6 flex items-center justify-between\\\\\\\">\\\\n              <div class=\\\\\\\"text-sm text-gray-500 dark:text-gray-400\\\\\\\">进度：<span id=\\\\\\\"study-progress\\\\\\\" class=\\\\\\\"font-medium\\\\\\\">0 / 0</span></div>\\\\n              <span class=\\\\\\\"text-xs px-2 py-1 bg-green-100 dark:bg-green-900 text-green-700 dark:text-green-300 rounded\\\\\\\">快捷键：1-5</span>\\\\n            </div>\\\\n            <div class=\\\\\\\"card-flip mb-6\\\\\\\" id=\\\\\\\"card-flip-area\\\\\\\">\\\\n              <div class=\\\\\\\"card-inner relative bg-white dark:bg-gray-800 rounded-2xl shadow-lg border border-gray-200 dark:border-gray-700 min-h-[400px] cursor-pointer\\\\\\\" onclick=\\\\\\\"toggleCardFlip()\\\\\\\">\\\\n                <div class=\\\\\\\"card-front absolute inset-0 p-8 flex flex-col\\\\\\\">\\\\n                  <div class=\\\\\\\"flex-1 flex items-center justify-center\\\\\\\">\\\\n                    <div class=\\\\\\\"text-center\\\\\\\">\\\\n                      <div class=\\\\\\\"text-sm text-gray-500 dark:text-gray-400 mb-4\\\\\\\">问题</div>\\\\n                      <div class=\\\\\\\"text-2xl font-medium\\\\\\\" id=\\\\\\\"question-text\\\\\\\">加载中...</div>\\\\n                    </div>\\\\n                  </div>\\\\n                  <div class=\\\\\\\"text-center\\\\\\\">\\\\n                    <button class=\\\\\\\"px-6 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-colors\\\\\\\" onclick=\\\\\\\"event.stopPropagation(); showAnswer()\\\\\\\">显示答案</button>\\\\n                  </div>\\\\n                </div>\\\\n                <div class=\\\\\\\"card-back absolute inset-0 p-8 flex flex-col\\\\\\\">\\\\n                  <div class=\\\\\\\"flex-1 flex items-center justify-center\\\\\\\">\\\\n                    <div class=\\\\\\\"text-center\\\\\\\">\\\\n                      <div class=\\\\\\\"text-sm text-gray-500 dark:text-gray-400 mb-4\\\\\\\">答案</div>\\\\n                      <div class=\\\\\\\"text-2xl font-medium\\\\\\\" id=\\\\\\\"answer-text\\\\\\\">加载中...</div>\\\\n                    </div>\\\\n                  </div>\\\\n                </div>\\\\n              </div>\\\\n            </div>\\\\n            <div class=\\\\\\\"grid grid-cols-5 gap-2\\\\\\\" id=\\\\\\\"rating-buttons\\\\\\\" style=\\\\\\\"display: none;\\\\\\\">\\\\n              <button class=\\\\\\\"rating-btn px-4 py-3 rounded-lg border-2 border-red-200 dark:border-red-900 hover:bg-red-50 dark:hover:bg-red-900/30 transition-colors\\\\\\\" onclick=\\\\\\\"rateCard(1)\\\\\\\">\\\\n                <div class=\\\\\\\"text-sm font-medium text-red-600 dark:text-red-400\\\\\\\">Again</div>\\\\n                <div class=\\\\\\\"text-xs text-gray-500\\\\\\\" id=\\\\\\\"interval-1\\\\\\\">1m</div>\\\\n              </button>\\\\n              <button class=\\\\\\\"rating-btn px-4 py-3 rounded-lg border-2 border-orange-200 dark:border-orange-900 hover:bg-orange-50 dark:hover:bg-orange-900/30 transition-colors\\\\\\\" onclick=\\\\\\\"rateCard(2)\\\\\\\">\\\\n                <div class=\\\\\\\"text-sm font-medium text-orange-600 dark:text-orange-400\\\\\\\">Hard</div>\\\\n                <div class=\\\\\\\"text-xs text-gray-500\\\\\\\" id=\\\\\\\"interval-2\\\\\\\">10m</div>\\\\n              </button>\\\\n              <button class=\\\\\\\"rating-btn px-4 py-3 rounded-lg border-2 border-blue-200 dark:border-blue-900 hover:bg-blue-50 dark:hover:bg-blue-900/30 transition-colors\\\\\\\" onclick=\\\\\\\"rateCard(3)\\\\\\\">\\\\n                <div class=\\\\\\\"text-sm font-medium text-blue-600 dark:text-blue-400\\\\\\\">Good</div>\\\\n                <div class=\\\\\\\"text-xs text-gray-500\\\\\\\" id=\\\\\\\"interval-3\\\\\\\">1d</div>\\\\n              </button>\\\\n              <button class=\\\\\\\"rating-btn px-4 py-3 rounded-lg border-2 border-green-200 dark:border-green-900 hover:bg-green-50 dark:hover:bg-green-900/30 transition-colors\\\\\\\" onclick=\\\\\\\"rateCard(4)\\\\\\\">\\\\n                <div class=\\\\\\\"text-sm font-medium text-green-600 dark:text-green-400\\\\\\\">Easy</div>\\\\n                <div class=\\\\\\\"text-xs text-gray-500\\\\\\\" id=\\\\\\\"interval-4\\\\\\\">4d</div>\\\\n              </button>\\\\n              <button class=\\\\\\\"rating-btn px-4 py-3 rounded-lg border-2 border-purple-200 dark:border-purple-900 hover:bg-purple-50 dark:hover:bg-purple-900/30 transition-colors\\\\\\\" onclick=\\\\\\\"rateCard(5)\\\\\\\">\\\\n                <div class=\\\\\\\"text-sm font-medium text-purple-600 dark:text-purple-400\\\\\\\">Perfect</div>\\\\n                <div class=\\\\\\\"text-xs text-gray-500\\\\\\\" id=\\\\\\\"interval-5\\\\\\\">10d</div>\\\\n              </button>\\\\n            </div>\\\\n            <div class=\\\\\\\"empty-state text-center py-16\\\\\\\" id=\\\\\\\"no-cards-message\\\\\\\" style=\\\\\\\"display: none;\\\\\\\">\\\\n              <i class=\\\\\\\"ph ph-check-circle text-6xl text-green-500 mb-4\\\\\\\"></i>\\\\n              <h3 class=\\\\\\\"text-2xl font-bold mb-2\\\\\\\">太棒了！</h3>\\\\n              <p class=\\\\\\\"text-gray-500 dark:text-gray-400 mb-6\\\\\\\">今天没有需要复习的卡片了</p>\\\\n              <button class=\\\\\\\"px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-colors\\\\\\\" onclick=\\\\\\\"showView('add')\\\\\\\">添加新卡片</button>\\\\n            </div>\\\\n          </div>\\\\n        </section>\\\\n        \\\\n        <!-- Cards View -->\\\\n        <section id=\\\\\\\"cards-view\\\\\\\" class=\\\\\\\"view fade-in\\\\\\\" style=\\\\\\\"display: none;\\\\\\\">\\\\n          <div class=\\\\\\\"view-header flex justify-between items-center mb-6\\\\\\\">\\\\n            <h1 class=\\\\\\\"text-2xl font-bold\\\\\\\">所有卡片</h1>\\\\n            <input type=\\\\\\\"text\\\\\\\" id=\\\\\\\"card-search\\\\\\\" placeholder=\\\\\\\"搜索卡片...\\\\\\\" oninput=\\\\\\\"filterCards()\\\\\\\" class=\\\\\\\"px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-500 w-64\\\\\\\">\\\\n          </div>\\\\n          <div class=\\\\\\\"cards-list space-y-3\\\\\\\" id=\\\\\\\"cards-list\\\\\\\"></div>\\\\n        </section>\\\\n\\\\n        <!-- Decks View -->\\\\n        <section id=\\\\\\\"decks-view\\\\\\\" class=\\\\\\\"view fade-in\\\\\\\" style=\\\\\\\"display: none;\\\\\\\">\\\\n          <div class=\\\\\\\"view-header flex justify-between items-center mb-6\\\\\\\">\\\\n            <h1 class=\\\\\\\"text-2xl font-bold\\\\\\\">牌组管理</h1>\\\\n            <button class=\\\\\\\"px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-colors\\\\\\\" onclick=\\\\\\\"showCreateDeckModal()\\\\\\\">\\\\n              <i class=\\\\\\\"ph ph-plus mr-2\\\\\\\"></i>新建牌组\\\\n            </button>\\\\n          </div>\\\\n          <div class=\\\\\\\"decks-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\\\\\\\" id=\\\\\\\"decks-grid\\\\\\\"></div>\\\\n        </section>\\\\n\\\\n        <!-- Add View -->\\\\n        <section id=\\\\\\\"add-view\\\\\\\" class=\\\\\\\"view fade-in\\\\\\\" style=\\\\\\\"display: none;\\\\\\\">\\\\n          <div class=\\\\\\\"view-header mb-6\\\\\\\"><h1 class=\\\\\\\"text-2xl font-bold\\\\\\\">添加卡片</h1></div>\\\\n          <div class=\\\\\\\"add-form max-w-2xl\\\\\\\">\\\\n            <div class=\\\\\\\"form-group mb-6\\\\\\\">\\\\n              <label for=\\\\\\\"deck-select-add\\\\\\\" class=\\\\\\\"block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2\\\\\\\">选择牌组</label>\\\\n              <select id=\\\\\\\"deck-select-add\\\\\\\" class=\\\\\\\"w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-500\\\\\\\"></select>\\\\n            </div>\\\\n            <div class=\\\\\\\"form-group mb-6\\\\\\\">\\\\n              <label for=\\\\\\\"question-input\\\\\\\" class=\\\\\\\"block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2\\\\\\\">问题</label>\\\\n              <textarea id=\\\\\\\"question-input\\\\\\\" placeholder=\\\\\\\"输入问题...\\\\\\\" rows=\\\\\\\"3\\\\\\\" class=\\\\\\\"w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-500\\\\\\\"></textarea>\\\\n            </div>\\\\n            <div class=\\\\\\\"form-group mb-6\\\\\\\">\\\\n              <label for=\\\\\\\"answer-input\\\\\\\" class=\\\\\\\"block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2\\\\\\\">答案</label>\\\\n              <textarea id=\\\\\\\"answer-input\\\\\\\" placeholder=\\\\\\\"输入答案...\\\\\\\" rows=\\\\\\\"5\\\\\\\" class=\\\\\\\"w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-500\\\\\\\"></textarea>\\\\n            </div>\\\\n            <button class=\\\\\\\"px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-colors\\\\\\\" onclick=\\\\\\\"addCard()\\\\\\\">添加卡片</button>\\\\n            <div class=\\\\\\\"quick-add mt-10 pt-10 border-t border-gray-200 dark:border-gray-700\\\\\\\">\\\\n              <h3 class=\\\\\\\"text-lg font-medium mb-4\\\\\\\">快速添加 (格式：问题::答案)</h3>\\\\n              <textarea id=\\\\\\\"quick-add-input\\\\\\\" placeholder=\\\\\\\"每行一个卡片，格式：问题::答案\\\\\\\" rows=\\\\\\\"5\\\\\\\" class=\\\\\\\"w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-500 mb-4\\\\\\\"></textarea>\\\\n              <button class=\\\\\\\"px-4 py-2 border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-colors\\\\\\\" onclick=\\\\\\\"quickAdd()\\\\\\\">批量添加</button>\\\\n            </div>\\\\n          </div>\\\\n        </section>\\\\n\\\\n        <!-- Import View -->\\\\n        <section id=\\\\\\\"import-view\\\\\\\" class=\\\\\\\"view fade-in\\\\\\\" style=\\\\\\\"display: none;\\\\\\\">\\\\n          <div class=\\\\\\\"view-header mb-6\\\\\\\"><h1 class=\\\\\\\"text-2xl font-bold\\\\\\\">导入 ANKI 卡包</h1></div>\\\\n          <div class=\\\\\\\"import-form max-w-2xl\\\\\\\">\\\\n            <div class=\\\\\\\"import-description bg-white dark:bg-gray-800 rounded-lg p-6 mb-6 border-l-4 border-primary-600\\\\\\\">\\\\n              <p class=\\\\\\\"font-semibold mb-3\\\\\\\">📦 导入 .apkg 格式的 Anki 卡包文件</p>\\\\n              <ul class=\\\\\\\"list-disc list-inside text-gray-600 dark:text-gray-400 space-y-1\\\\\\\">\\\\n                <li>支持所有标准 .apkg 文件</li>\\\\n                <li>自动保留卡片内容和字段</li>\\\\n                <li>可选择导入到指定牌组</li>\\\\n              </ul>\\\\n            </div>\\\\n            <div class=\\\\\\\"form-group mb-6\\\\\\\">\\\\n              <label for=\\\\\\\"import-deck-select\\\\\\\" class=\\\\\\\"block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2\\\\\\\">导入到牌组</label>\\\\n              <select id=\\\\\\\"import-deck-select\\\\\\\" class=\\\\\\\"w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-500\\\\\\\">\\\\n                <option value=\\\\\\\"1\\\\\\\">默认牌组</option>\\\\n              </select>\\\\n            </div>\\\\n            <div class=\\\\\\\"form-group mb-6\\\\\\\">\\\\n              <label for=\\\\\\\"apkg-file\\\\\\\" class=\\\\\\\"file-label flex items-center gap-3 p-5 bg-white dark:bg-gray-800 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg cursor-pointer hover:border-primary-500 transition-colors\\\\\\\">\\\\n                <i class=\\\\\\\"ph ph-folder text-3xl\\\\\\\"></i>\\\\n                <span class=\\\\\\\"text-gray-600 dark:text-gray-400\\\\\\\">选择 .apkg 文件</span>\\\\n              </label>\\\\n              <input type=\\\\\\\"file\\\\\\\" id=\\\\\\\"apkg-file\\\\\\\" accept=\\\\\\\".apkg\\\\\\\" style=\\\\\\\"display: none;\\\\\\\" onchange=\\\\\\\"onFileSelected()\\\\\\\">\\\\n              <div id=\\\\\\\"file-info\\\\\\\" class=\\\\\\\"file-info mt-3 p-3 bg-white dark:bg-gray-800 rounded-lg flex gap-4 text-sm\\\\\\\" style=\\\\\\\"display: none;\\\\\\\">\\\\n                <span id=\\\\\\\"file-name\\\\\\\" class=\\\\\\\"font-medium\\\\\\\"></span>\\\\n                <span id=\\\\\\\"file-size\\\\\\\" class=\\\\\\\"text-gray-500\\\\\\\"></span>\\\\n              </div>\\\\n            </div>\\\\n            <div id=\\\\\\\"preview-area\\\\\\\" class=\\\\\\\"preview-area mt-6 p-5 bg-white dark:bg-gray-800 rounded-lg\\\\\\\" style=\\\\\\\"display: none;\\\\\\\">\\\\n              <h3 class=\\\\\\\"font-semibold mb-4\\\\\\\">📋 卡包预览</h3>\\\\n              <div class=\\\\\\\"preview-stats grid grid-cols-3 gap-4 mb-4\\\\\\\">\\\\n                <div class=\\\\\\\"preview-stat text-center p-4 bg-gray-50 dark:bg-gray-700 rounded-lg\\\\\\\">\\\\n                  <span class=\\\\\\\"preview-stat-value text-3xl font-bold text-primary-600\\\\\\\" id=\\\\\\\"preview-cards\\\\\\\">0</span>\\\\n                  <span class=\\\\\\\"preview-stat-label text-xs text-gray-500 dark:text-gray-400 block mt-1\\\\\\\">卡片数</span>\\\\n                </div>\\\\n                <div class=\\\\\\\"preview-stat text-center p-4 bg-gray-50 dark:bg-gray-700 rounded-lg\\\\\\\">\\\\n                  <span class=\\\\\\\"preview-stat-value text-3xl font-bold text-primary-600\\\\\\\" id=\\\\\\\"preview-decks\\\\\\\">0</span>\\\\n                  <span class=\\\\\\\"preview-stat-label text-xs text-gray-500 dark:text-gray-400 block mt-1\\\\\\\">牌组数</span>\\\\n                </div>\\\\n                <div class=\\\\\\\"preview-stat text-center p-4 bg-gray-50 dark:bg-gray-700 rounded-lg\\\\\\\">\\\\n                  <span class=\\\\\\\"preview-stat-value text-3xl font-bold text-primary-600\\\\\\\" id=\\\\\\\"preview-models\\\\\\\">0</span>\\\\n                  <span class=\\\\\\\"preview-stat-label text-xs text-gray-500 dark:text-gray-400 block mt-1\\\\\\\">模型数</span>\\\\n                </div>\\\\n              </div>\\\\n              <div id=\\\\\\\"preview-details\\\\\\\" class=\\\\\\\"preview-details mt-4\\\\\\\"></div>\\\\n            </div>\\\\n            <button class=\\\\\\\"btn btn-primary btn-large w-full px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-lg transition-colors\\\\\\\" id=\\\\\\\"import-btn\\\\\\\" onclick=\\\\\\\"importAPKG()\\\\\\\" disabled>📥 开始导入</button>\\\\n            <div id=\\\\\\\"import-progress\\\\\\\" class=\\\\\\\"import-progress mt-6\\\\\\\" style=\\\\\\\"display: none;\\\\\\\">\\\\n              <div class=\\\\\\\"progress-bar h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden mb-3\\\\\\\">\\\\n                <div class=\\\\\\\"progress-fill h-full bg-gradient-to-r from-primary-500 to-primary-400 w-0 transition-all duration-300\\\\\\\" id=\\\\\\\"progress-fill\\\\\\\"></div>\\\\n              </div>\\\\n              <p class=\\\\\\\"text-center text-gray-600 dark:text-gray-400 text-sm\\\\\\\" id=\\\\\\\"progress-text\\\\\\\">正在导入...</p>\\\\n            </div>\\\\n            <div id=\\\\\\\"import-result\\\\\\\" class=\\\\\\\"import-result mt-6 p-6 rounded-lg text-center\\\\\\\" style=\\\\\\\"display: none;\\\\\\\"></div>\\\\n          </div>\\\\n        </section>\\\\n\\\\n\\\\n        <!-- Templates View -->\\\\n        <section id=\\\\\\\"templates-view\\\\\\\" class=\\\\\\\"view fade-in\\\\\\\" style=\\\\\\\"display: none;\\\\\\\">\\\\n          <div class=\\\\\\\"view-header mb-6 flex justify-between items-center\\\\\\\">\\\\n            <div><h1 class=\\\\\\\"text-2xl font-bold\\\\\\\">卡片模板</h1><p class=\\\\\\\"text-gray-500 dark:text-gray-400 mt-1\\\\\\\">管理和自定义卡片显示样式</p></div>\\\\n            <button class=\\\\\\\"btn-primary px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg\\\\\\\" onclick=\\\\\\\"showTemplateModal()\\\\\\\"><i class=\\\\\\\"ph ph-plus mr-2\\\\\\\"></i>新建模板</button>\\\\n          </div>\\\\n          <div id=\\\\\\\"templates-grid\\\\\\\" class=\\\\\\\"grid grid-cols-1 lg:grid-cols-2 gap-6\\\\\\\"></div>\\\\n        </section>\\\\n\\\\n        <!-- Media View -->\\\\n        <section id=\\\\\\\"media-view\\\\\\\" class=\\\\\\\"view fade-in\\\\\\\" style=\\\\\\\"display: none;\\\\\\\">\\\\n          <div class=\\\\\\\"view-header mb-6 flex justify-between items-center\\\\\\\">\\\\n            <div><h1 class=\\\\\\\"text-2xl font-bold\\\\\\\">媒体文件</h1><p class=\\\\\\\"text-gray-500 dark:text-gray-400 mt-1\\\\\\\">管理卡片中的图片和音频</p></div>\\\\n            <label class=\\\\\\\"btn-primary px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg cursor-pointer\\\\\\\">\\\\n              <i class=\\\\\\\"ph ph-upload-simple mr-2\\\\\\\"></i>上传文件<input type=\\\\\\\"file\\\\\\\" id=\\\\\\\"media-upload\\\\\\\" accept=\\\\\\\"image/*,audio/*\\\\\\\" class=\\\\\\\"hidden\\\\\\\" onchange=\\\\\\\"uploadMedia(this)\\\\\\\">\\\\n            </label>\\\\n          </div>\\\\n          <div id=\\\\\\\"media-grid\\\\\\\" class=\\\\\\\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4\\\\\\\"></div>\\\\n        </section>\\\\n\\\\n        <!-- Export View -->\\\\n        <section id=\\\\\\\"export-view\\\\\\\" class=\\\\\\\"view fade-in\\\\\\\" style=\\\\\\\"display: none;\\\\\\\">\\\\n          <div class=\\\\\\\"view-header mb-6\\\\\\\"><h1 class=\\\\\\\"text-2xl font-bold\\\\\\\">导出卡片</h1><p class=\\\\\\\"text-gray-500 dark:text-gray-400 mt-1\\\\\\\">导出为 APKG、CSV 或 JSON 格式</p></div>\\\\n          <div class=\\\\\\\"export-options bg-white dark:bg-gray-800 rounded-xl p-8 border border-gray-200 dark:border-gray-700 max-w-2xl\\\\\\\">\\\\n            <div class=\\\\\\\"form-group mb-6\\\\\\\">\\\\n              <label class=\\\\\\\"block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2\\\\\\\">选择格式</label>\\\\n              <div class=\\\\\\\"flex gap-4\\\\\\\">\\\\n                <label class=\\\\\\\"flex items-center gap-2 p-4 border rounded-lg cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700\\\\\\\"><input type=\\\\\\\"radio\\\\\\\" name=\\\\\\\"export-format\\\\\\\" value=\\\\\\\"apkg\\\\\\\" checked class=\\\\\\\"w-4 h-4\\\\\\\"><div><div class=\\\\\\\"font-medium\\\\\\\">APKG</div><div class=\\\\\\\"text-xs text-gray-500\\\\\\\">Anki 卡包格式</div></div></label>\\\\n                <label class=\\\\\\\"flex items-center gap-2 p-4 border rounded-lg cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700\\\\\\\"><input type=\\\\\\\"radio\\\\\\\" name=\\\\\\\"export-format\\\\\\\" value=\\\\\\\"csv\\\\\\\" class=\\\\\\\"w-4 h-4\\\\\\\"><div><div class=\\\\\\\"font-medium\\\\\\\">CSV</div><div class=\\\\\\\"text-xs text-gray-500\\\\\\\">电子表格格式</div></div></label>\\\\n                <label class=\\\\\\\"flex items-center gap-2 p-4 border rounded-lg cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700\\\\\\\"><input type=\\\\\\\"radio\\\\\\\" name=\\\\\\\"export-format\\\\\\\" value=\\\\\\\"json\\\\\\\" class=\\\\\\\"w-4 h-4\\\\\\\"><div><div class=\\\\\\\"font-medium\\\\\\\">JSON</div><div class=\\\\\\\"text-xs text-gray-500\\\\\\\">数据交换格式</div></div></label>\\\\n              </div>\\\\n            </div>\\\\n            <div class=\\\\\\\"form-group mb-6\\\\\\\">\\\\n              <label class=\\\\\\\"block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2\\\\\\\">选择牌组</label>\\\\n              <select id=\\\\\\\"export-deck-select\\\\\\\" class=\\\\\\\"w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700\\\\\\\"><option value=\\\\\\\"\\\\\\\">全部牌组</option></select>\\\\n            </div>\\\\n            <button class=\\\\\\\"btn-primary w-full py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-lg\\\\\\\" onclick=\\\\\\\"exportCards()\\\\\\\"><i class=\\\\\\\"ph ph-download-simple mr-2\\\\\\\"></i>开始导出</button>\\\\n            <div id=\\\\\\\"export-result\\\\\\\" class=\\\\\\\"mt-4 p-4 rounded-lg\\\\\\\" style=\\\\\\\"display: none;\\\\\\\"></div>\\\\n          </div>\\\\n        </section>\\\\n\\\\n        <!-- Stats View -->\\\\n        <section id=\\\\\\\"stats-view\\\\\\\" class=\\\\\\\"view fade-in\\\\\\\" style=\\\\\\\"display: none;\\\\\\\">\\\\n          <div class=\\\\\\\"view-header mb-6\\\\\\\"><h1 class=\\\\\\\"text-2xl font-bold\\\\\\\">学习统计</h1></div>\\\\n          <div class=\\\\\\\"stats-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10\\\\\\\">\\\\n            <div class=\\\\\\\"stat-card bg-white dark:bg-gray-800 rounded-xl p-6 text-center border border-gray-200 dark:border-gray-700 hover:shadow-lg transition-shadow\\\\\\\">\\\\n              <div class=\\\\\\\"stat-icon text-4xl mb-3\\\\\\\">📚</div>\\\\n              <div class=\\\\\\\"stat-number text-4xl font-bold text-primary-600\\\\\\\" id=\\\\\\\"stat-total\\\\\\\">0</div>\\\\n              <div class=\\\\\\\"stat-title text-sm text-gray-500 dark:text-gray-400 mt-2\\\\\\\">总卡片数</div>\\\\n            </div>\\\\n            <div class=\\\\\\\"stat-card stat-due bg-white dark:bg-gray-800 rounded-xl p-6 text-center border border-gray-200 dark:border-gray-700 hover:shadow-lg transition-shadow\\\\\\\">\\\\n              <div class=\\\\\\\"stat-icon text-4xl mb-3\\\\\\\">⏰</div>\\\\n              <div class=\\\\\\\"stat-number text-4xl font-bold text-orange-600\\\\\\\" id=\\\\\\\"stat-due\\\\\\\">0</div>\\\\n              <div class=\\\\\\\"stat-title text-sm text-gray-500 dark:text-gray-400 mt-2\\\\\\\">待复习</div>\\\\n            </div>\\\\n            <div class=\\\\\\\"stat-card stat-done bg-white dark:bg-gray-800 rounded-xl p-6 text-center border border-gray-200 dark:border-gray-700 hover:shadow-lg transition-shadow\\\\\\\">\\\\n              <div class=\\\\\\\"stat-icon text-4xl mb-3\\\\\\\">✅</div>\\\\n              <div class=\\\\\\\"stat-number text-4xl font-bold text-green-600\\\\\\\" id=\\\\\\\"stat-reviewed\\\\\\\">0</div>\\\\n              <div class=\\\\\\\"stat-title text-sm text-gray-500 dark:text-gray-400 mt-2\\\\\\\">已复习</div>\\\\n            </div>\\\\n            <div class=\\\\\\\"stat-card bg-white dark:bg-gray-800 rounded-xl p-6 text-center border border-gray-200 dark:border-gray-700 hover:shadow-lg transition-shadow\\\\\\\">\\\\n              <div class=\\\\\\\"stat-icon text-4xl mb-3\\\\\\\">🆕</div>\\\\n              <div class=\\\\\\\"stat-number text-4xl font-bold text-blue-600\\\\\\\" id=\\\\\\\"stat-new\\\\\\\">0</div>\\\\n              <div class=\\\\\\\"stat-title text-sm text-gray-500 dark:text-gray-400 m