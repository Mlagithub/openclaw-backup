{"type":"message","id":"53369cf0","parentId":"47e8342c","timestamp":"2026-03-04T08:43:33.914Z","message":{"role":"toolResult","toolCallId":"tool-845bb809c87640d2bbf1b06135ea2112","toolName":"read","content":[{"type":"text","text":"#include <algorithm>\n#include <cmath>\n#include <cstring>\n#include <ctime>\n#include <numeric>\n\n#include <cgns_io.h>\n#include <parmetis.h>\n\n#include \"cmdLine.h\"\n#include \"metisCutter.h\"\n#include \"mpiAdapter.h\"\n#include \"stringUtil.h\"\n\nstatic const int DataTAG = 1000;\n\nstatic std::vector<idx_t> distribute(const idx_t len, const int n, idx_t &nCellThisRank)\n{\n    vector<idx_t> dist(n + 1, 0);\n    // P0-1 fix: Use floor division + remainder distribution for better load balancing\n    auto base = len / n;        // Base allocation for each process\n    auto remainder = len % n;   // Remainder to distribute\n    // Get current rank for load balancing decision\n    int currentRank;\n    MPI_Comm_rank(MPI_COMM_WORLD, &currentRank);\n    // First 'remainder' processes get base+1, rest get base\n    nCellThisRank = (currentRank < remainder) ? base + 1 : base;\n    MPI_Allgather(&nCellThisRank, 1, GetMPIDataType<idx_t>(), dist.data() + 1, 1, GetMPIDataType<idx_t>(), MPI_COMM_WORLD);\n    for (int iProc = 1; iProc < n + 1; ++iProc) { dist[iProc] += dist[iProc - 1]; }\n    return dist;\n}\n\nnamespace MeshCut\n{\nMetisCutter::MetisCutter() : bigMesh_(nullptr) {}\n\nMetisCutter::~MetisCutter() {}\n\nvoid MetisCutter::cut(int argc, char **argv)\n{\n    CmdLine cl{};\n    cl.regist<std::string, CmdLine::MustOffer>(\"m\", \"mesh\", \"mesh file name.\", \" \");\n    cl.regist<size_t, CmdLine::MustOffer>(\"np\", \"npart\", \"part number of sub-mesh.\", \" \");\n    cl.parse(argc, argv);\n\n    MPIAdapter::Initialize(&argc, &argv);\n#ifdef DEBUG_MODE\n    if (!MPIAdapter::isParallel() || (MPIAdapter::isParallel() && MPIAdapter::isMaster()))\n    {\n        std::cout << \"DEBUG_MODE: type any char to continue\\n\";\n        auto a = std::getchar();\n    }\n    MPIAdapter::Barrier();\n#endif\n    MPIAdapter::isParallel() ? this->cut_parmetis(cl.get<std::string>(\"mesh\"), cl.get<size_t>(\"npart\")) : this->cut_metis(cl.get<std::string>(\"mesh\"), cl.get<size_t>(\"npart\"));\n}\n\n// collect interface from all other threads\n// P0-2: Optimized with sparse point-to-point communication and binary serialization\nvoid MetisCutter::collect_interface()\n{\n    // 1. Identify target ranks (processes we need to communicate with)\n    std::set<int> targetRanks;\n    for (const auto& [nbrFile, faces] : outerFace_)\n    {\n        if (!faces.empty() && ownerThread_.size() > static_cast<size_t>(nbrFile))\n        {\n            int ownerRank = ownerThread_[nbrFile];\n            if (ownerRank != RANK)\n                targetRanks.insert(ownerRank);\n        }\n    }\n\n    // 2. Exchange target rank lists using Allgather (small data, O(SIZE) cost)\n    vector<int> myTargets(targetRanks.begin(), targetRanks.end());\n    int myTargetCount = static_cast<int>(myTargets.size());\n    vector<int> allTargetCounts(SIZE, 0);\n    MPI_Allgather(&myTargetCount, 1, MPI_INT, allTargetCounts.data(), 1, MPI_INT, MPI_COMM_WORLD);\n\n    // Calculate displacements for Allgatherv\n    vector<int> targetDisps(SIZE, 0);\n    int totalTargets = 0;\n    for (int i = 0; i < SIZE; ++i)\n    {\n        targetDisps[i] = totalTargets;\n        totalTargets += allTargetCounts[i];\n    }\n\n    // Gather all target ranks\n    vector<int> allTargets(totalTargets, 0);\n    MPI_Allgatherv(myTargets.data(), myTargetCount, MPI_INT,\n                   allTargets.data(), allTargetCounts.data(), targetDisps.data(), MPI_INT, MPI_COMM_WORLD);\n\n    // 3. Build list of source ranks (ranks that will send to us)\n    std::set<int> sourceRanks;\n    for (int i = 0; i < SIZE; ++i)\n    {\n        if (i == RANK) continue;\n        int start = targetDisps[i];\n        int end = start + allTargetCounts[i];\n        for (int j = start; j < end; ++j)\n        {\n            if (allTargets[j] == RANK)\n            {\n                sourceRanks.insert(i);\n                break;\n            }\n        }\n    }\n\n    // 4. Binary serialization of interface data (P1-3: using hash keys)\n    auto packInterfaceBinary = [&, this]() -> std::vector<char>\n    {\n        std::vector<char> buffer;\n        \n        // Count files with data\n        int fileCount = 0;\n        for (const auto& [nbrFile, faces] : outerFace_)\n        {\n            if (!faces.empty() && ownerThread_.size() > static_cast<size_t>(nbrFile) && ownerThread_[nbrFile] != RANK)\n                ++fileCount;\n        }\n        \n        // Write file count\n        size_t pos = 0;\n        buffer.resize(sizeof(int));\n        std::memcpy(buffer.data(), &fileCount, sizeof(int));\n        pos = sizeof(int);\n        \n        for (const auto& [nbrFile, faces] : outerFace_)\n        {\n            if (faces.empty()) continue;\n            if (ownerThread_.size() <= static_cast<size_t>(nbrFile)) continue;\n            if (ownerThread_[nbrFile] == RANK) continue;  // Skip own files\n            \n            // Write file ID\n            size_t needed = pos + sizeof(int) + sizeof(int);\n            if (buffer.size() < needed) buffer.resize(needed);\n            int fid = nbrFile;\n            std::memcpy(buffer.data() + pos, &fid, sizeof(int));\n            pos += sizeof(int);\n            \n            // Write face count\n            int faceCount = static_cast<int>(faces.size());\n            std::memcpy(buffer.data() + pos, &faceCount, sizeof(int));\n            pos += sizeof(int);\n            \n            // Write each face (P1-3: serialize face hash and face nodes for interface matching)\n            for (const auto& [faceHash, faceNodes] : faces)\n            {\n\n[741 more lines in file. Use offset=151 to continue.]"}],"isError":false,"timestamp":1772613813913}}
