{"type":"message","id":"0bfb2d0a","parentId":"13dde390","timestamp":"2026-03-03T09:02:11.804Z","message":{"role":"toolResult","toolCallId":"call_7f0d8bc80e7b4b79acd1ac86","toolName":"read","content":[{"type":"text","text":"#pragma once\n\n#include <limits>\n#include <vector>\n#include <string>\n#include <unordered_map>\n#include <map>\n#include <set>\n#include <iostream>\n\n#include <cgnslib.h>\n\n#include \"vec.h\"\n#include \"meshCutter.h\"\n#include \"format.h\"\n#include \"cgFile.h\"\n\nusing std::set;\nusing std::map;\nusing std::string;\nusing std::vector;\nusing std::unordered_map;\n\nnamespace MeshCut\n{\nclass CartesianCutter : public MeshCutter\n{\npublic:\n    void cut(int argc, char** argv) override;\n\n    struct BoundBox\n    {\n        double max_x = -std::numeric_limits<double>::max();\n        double max_y = -std::numeric_limits<double>::max();\n        double max_z = -std::numeric_limits<double>::max();\n        double min_x = std::numeric_limits<double>::max();\n        double min_y = std::numeric_limits<double>::max();\n        double min_z = std::numeric_limits<double>::max();\n        double range_x() const { return max_x - min_x; }\n        double range_y() const { return max_y - min_y; }\n        double range_z() const { return max_z - min_z; }\n        double min(const int i)\n        {\n            switch (i)\n            {\n            case 1:\n                return min_x;\n                break;\n            case 2:\n                return min_y;\n                break;\n            case 3:\n                return min_z;\n                break;\n            default:\n                std::cout << format(\"error to get min of bbox.\\n\");\n                break;\n            }\n        }\n        double max(const int i)\n        {\n            switch (i)\n            {\n            case 1:\n                return max_x;\n                break;\n            case 2:\n                return max_y;\n                break;\n            case 3:\n                return max_z;\n                break;\n            default:\n                std::cout << format(\"error to get max of bbox.\\n\");\n                break;\n            }\n        }\n    };\n\nprivate:\n    struct Location\n    {\n        Location(){}\n        Location(int i, int j, int k) : i(i), j(j), k(k) {}\n        int i, j, k;\n    };\n\n    struct Section\n    {\n        int id = 1;\n        char name[33];\n        ElementType_t cellType;\n        cgsize_t start=1, end=1, dataSize=0;\n        int nBdy=0, flag;\n        vector<vector<cgsize_t>> data;\n        vector<cgsize_t> offset, typeFlag;\n    };\n    \n    struct Face\n    {\n        Face(const vector<cgsize_t>& val);\n        Face(vector<cgsize_t>&& val) noexcept;\n        \n        Face(const Face& other);\n        Face(Face&& other) noexcept;\n\n        Face& operator=(const Face& other);\n        Face& operator=(Face&& other) noexcept;\n\n        vector<cgsize_t> nodeList; \n        bool operator==(const Face &other) const;\n        bool operator<(const Face& rhs) const;\n    };\n\n    struct CellLoader\n    {\n        CellLoader(Section& curS, vector<cgsize_t>& data, vector<cgsize_t>& offset, const int fp);\n        bool nextCell(vector<cgsize_t>& nodes);\n        Section& curS;\n        vector<cgsize_t>& data;\n        vector<cgsize_t>& offset;\n        cgsize_t len;\n        int npe, flag = -1;\n        cgsize_t id = 0;\n    };\n\n    struct Weight\n    {\n    public:\n        Weight(const int nx, const int ny, const int nz);\n\n        // weight value of each sub-mesh at X/Y/Z directions\n        // wx_mesh0, wx_mesh1, wx_mesh2, ... wx_meshN\n        // wy_mesh0, wy_mesh1, wy_mesh2, ... wy_meshN\n        // wz_mesh0, wz_mesh1, wz_mesh2, ... wz_meshN\n        Weight(string fname, const int nx, const int ny, const int nz);\n\n        double x(const Location& loc) const;\n        double y(const Location& loc) const;\n        double z(const Location& loc) const;\n        double sumX(const Location& loc) const;\n        double sumY(const Location& loc) const;\n        double sumZ(const Location& loc) const;\n    private:\n        void updateSumWeight();\n        void normalize();\n\n    private:\n        vector<vector<double>> weights_, sumWeights_;\n    };\n\nprivate:\n    int nx_, ny_, nz_, n_;\n    int bigFile_;\n    map<int, int> smallFiles_;\n    map<int, BoundBox> bbox_;\n\n    int cell_dim_, ibase=1, izone=1, igrid=1;\n    cgsize_t zoneInfo[3];\n    DataType_t coordDataType_;\n    vector<string> coordname_;\n    string interiorFacePrefix_;\n\n    map<int, cgsize_t> globalNumber_;\n    map<int, cgsize_t> globalOffset_;\n    map<int, Section> sections_;\n    map<int, map<cgsize_t, cgsize_t>> nodeIdMap_;\n    vector<vector<double>> nodesData_;\n    set<cgsize_t> nodeIdInBox_;\n    map<int, map<string, vector<cgsize_t>>> outerFace_;\n    vector<int> bodySection_, bdySection_, interiorSection_;\n    vector<cgsize_t> idOffset_;\n\nprivate:\n    vector<vector<cgsize_t>> allFaceInCell(const vector<cgsize_t>& idList, ElementType_t type);\n\n    vector<double> boundingBoxBigMesh();\n\n    void boundingBoxSmallMesh(string weightFilename);\n\n    void checkFile(string filename);\n\n    Vector<double> cellCenter(const vector<cgsize_t>& cell, const ElementType_t type);\n\n    void cut(\n        const std::string &mesh, \n        const int npart, \n        const int nx = 1, \n        const int ny = 1, \n        const int nz = 1, \n        const string weightFilename = \"\",\n        bool multiZone = false, \n        vector<string> fluidDomainNameRule={},\n        string interiorSection = \"\"\n        );\n        \n    bool isBodySection(const Section& section);\n\n    bool isFluidDomain(const string& name, const vector<string>& fluidDomainNameRule);\n\n    bool inBox(const BoundBox& box, const vector<cgsize_t>& cell, const ElementType_t type);\n\n    Location id2Location(const int x) const;\n\n    int location2Id(const Location& loc) const;\n\n    int 