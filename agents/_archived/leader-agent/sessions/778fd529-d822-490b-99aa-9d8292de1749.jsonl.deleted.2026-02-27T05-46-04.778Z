{"type":"message","id":"58e07650","parentId":"d1188138","timestamp":"2026-02-27T04:45:23.700Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"让我查看项目的核心文件：server.js, package.json, 和前端 app.js","thinkingSignature":"0518508ccc463a379fdac38481996782abf8f2671135c019d2c32bd1cd06baf2"},{"type":"toolCall","id":"call_function_2fz7eb9os12f_1","name":"read","arguments":{"path":"/home/one/.openclaw/skills/fsrs-memory/web/server.js"}},{"type":"toolCall","id":"call_function_2fz7eb9os12f_2","name":"read","arguments":{"path":"/home/one/.openclaw/skills/fsrs-memory/web/package.json"}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M2.5","usage":{"input":1350,"output":92,"cacheRead":7949,"cacheWrite":0,"totalTokens":9391,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772167521232}}
{"type":"message","id":"160b243e","parentId":"58e07650","timestamp":"2026-02-27T04:45:23.715Z","message":{"role":"toolResult","toolCallId":"call_function_2fz7eb9os12f_1","toolName":"read","content":[{"type":"text","text":"// server.js - Express Backend for FSRS Web UI with Multi-deck & Theme support\nconst express = require('express');\nconst cors = require('cors');\nconst path = require('path');\nconst Database = require('better-sqlite3');\n\nconst app = express();\nconst PORT = process.env.PORT || 3001;\n\n// Middleware\napp.use(cors());\napp.use(express.json());\napp.use(express.static(path.join(__dirname, 'public')));\n\n// Database setup - connect to existing cards.db\nconst DB_PATH = process.env.DB_PATH || path.join(__dirname, '..', 'data', 'cards.db');\nconst db = new Database(DB_PATH);\n\n// Import FSRS engine\nconst FSRSEngine = require('../src/fsrs');\n\n// ==================== Database Helper Functions ====================\n\n// Fix inconsistent state values in database\nfunction fixCardStates() {\n  try {\n    // Fix \"2.0\" state to \"review\" (this was a bug where State.Review = 2 was stored as string)\n    const result = db.prepare(\"UPDATE cards SET state = 'review' WHERE state = '2.0'\").run();\n    if (result.changes > 0) {\n      console.log(`Fixed ${result.changes} cards with invalid state '2.0'`);\n    }\n    \n    // Fix empty or null states to \"new\"\n    db.prepare(\"UPDATE cards SET state = 'new' WHERE state IS NULL OR state = ''\").run();\n  } catch (error) {\n    console.error('Error fixing card states:', error);\n  }\n}\n\n// Run state fix on startup\nfixCardStates();\n\n// Get current local time for database queries\nfunction getLocalNow() {\n  return new Date().toISOString();\n}\n\n// ==================== Settings API ====================\n\n// Get theme\napp.get('/api/settings/theme', (req, res) => {\n  try {\n    const theme = db.prepare(\"SELECT value FROM settings WHERE key = 'theme'\").get();\n    res.json({ success: true, data: theme ? theme.value : 'light' });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Set theme\napp.post('/api/settings/theme', (req, res) => {\n  try {\n    const { theme } = req.body;\n    if (!theme || !['light', 'dark'].includes(theme)) {\n      return res.status(400).json({ success: false, error: 'Invalid theme' });\n    }\n    db.prepare(`\n      INSERT INTO settings (key, value) VALUES ('theme', ?)\n      ON CONFLICT(key) DO UPDATE SET value = excluded.value\n    `).run(theme);\n    res.json({ success: true, data: theme });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// ==================== Deck API ====================\n\n// Get all decks\napp.get('/api/decks', (req, res) => {\n  try {\n    // Use localtime for due_date comparison to match user timezone\n    const decks = db.prepare(`\n      SELECT d.*, \n        (SELECT COUNT(*) FROM cards WHERE deck_id = d.id) as card_count,\n        (SELECT COUNT(*) FROM cards WHERE deck_id = d.id AND strftime('%s', due_date) <= strftime('%s', 'now')) as due_count\n      FROM decks d \n      ORDER BY d.id ASC\n    `).all();\n    res.json({ success: true, data: decks });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Get single deck\napp.get('/api/decks/:id', (req, res) => {\n  try {\n    const deck = db.prepare('SELECT * FROM decks WHERE id = ?').get(req.params.id);\n    if (!deck) {\n      return res.status(404).json({ success: false, error: 'Deck not found' });\n    }\n    res.json({ success: true, data: deck });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Create deck\napp.post('/api/decks', (req, res) => {\n  try {\n    const { name, description } = req.body;\n    if (!name) {\n      return res.status(400).json({ success: false, error: 'Deck name required' });\n    }\n    \n    const stmt = db.prepare('INSERT INTO decks (name, description) VALUES (?, ?)');\n    const result = stmt.run(name, description || '');\n    \n    const newDeck = db.prepare('SELECT * FROM decks WHERE id = ?').get(result.lastInsertRowid);\n    res.json({ success: true, data: newDeck });\n  } catch (error) {\n    if (error.message.includes('UNIQUE')) {\n      return res.status(400).json({ success: false, error: 'Deck name already exists' });\n    }\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Update deck\napp.put('/api/decks/:id', (req, res) => {\n  try {\n    const { name, description } = req.body;\n    const deckId = parseInt(req.params.id);\n    \n    if (deckId === 1) {\n      return res.status(400).json({ success: false, error: 'Cannot modify default deck' });\n    }\n    \n    db.prepare(`\n      UPDATE decks SET name = ?, description = ?, updated_at = datetime('now') WHERE id = ?\n    `).run(name, description || '', deckId);\n    \n    const updatedDeck = db.prepare('SELECT * FROM decks WHERE id = ?').get(deckId);\n    res.json({ success: true, data: updatedDeck });\n  } catch (error) {\n    if (error.message.includes('UNIQUE')) {\n      return res.status(400).json({ success: false, error: 'Deck name already exists' });\n    }\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Delete deck\napp.delete('/api/decks/:id', (req, res) => {\n  try {\n    const deckId = parseInt(req.params.id);\n    \n    if (deckId === 1) {\n      return res.status(400).json({ success: false, error: 'Cannot delete default deck' });\n    }\n    \n    // Move cards to default deck before deleting\n    db.prepare('UPDATE cards SET deck_id = 1 WHERE deck_id = ?').run(deckId);\n    db.prepare('DELETE FROM decks WHERE id = ?').run(deckId);\n    \n    res.json({ success: true });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// ==================== Card API ====================\n\n// Get all cards (with optional deck filter)\napp.get('/api/cards', (req, res) => {\n  try {\n    const deckId = req.query.deck ? parseInt(req.query.deck) : null;\n    let cards;\n    if (deckId) {\n      cards = db.prepare('SELECT * FROM cards WHERE deck_id = ? ORDER BY created_at DESC').all(deckId);\n    } else {\n      cards = db.prepare('SELECT * FROM cards ORDER BY created_at DESC').all();\n    }\n    res.json({ success: true, data: cards });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Get due cards (with optional deck filter)\napp.get('/api/cards/due', (req, res) => {\n  try {\n    const deckId = req.query.deck ? parseInt(req.query.deck) : null;\n    // Use localtime for consistency with deck stats\n    const now = new Date();\n    let cards;\n    if (deckId) {\n      cards = db.prepare(`\n        SELECT * FROM cards \n        WHERE deck_id = ? AND strftime('%s', due_date) <= strftime('%s', 'now')\n        ORDER BY due_date ASC\n      `).all(deckId);\n    } else {\n      cards = db.prepare(`\n        SELECT * FROM cards \n        WHERE strftime('%s', due_date) <= strftime('%s', 'now')\n        ORDER BY due_date ASC\n      `).all();\n    }\n    res.json({ success: true, data: cards });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Get single card\napp.get('/api/cards/:id', (req, res) => {\n  try {\n    const card = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    if (!card) {\n      return res.status(404).json({ success: false, error: 'Card not found' });\n    }\n    res.json({ success: true, data: card });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Add new card (with optional deck)\napp.post('/api/cards', (req, res) => {\n  try {\n    const { question, answer, deck_id } = req.body;\n    if (!question || !answer) {\n      return res.status(400).json({ success: false, error: 'Question and answer required' });\n    }\n    \n    const deckId = deck_id ? parseInt(deck_id) : 1;\n    const now = new Date();\n    const stmt = db.prepare(`\n      INSERT INTO cards (deck_id, question, answer, due_date, created_at, state)\n      VALUES (?, ?, ?, ?, ?, 'new')\n    `);\n    const result = stmt.run(deckId, question, answer, now.toISOString(), now.toISOString());\n    \n    const newCard = db.prepare('SELECT * FROM cards WHERE id = ?').get(result.lastInsertRowid);\n    res.json({ success: true, data: newCard });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Move card to different deck\napp.put('/api/cards/:id/deck', (req, res) => {\n  try {\n    const { deck_id } = req.body;\n    db.prepare('UPDATE cards SET deck_id = ? WHERE id = ?').run(deck_id, req.params.id);\n    const updatedCard = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    res.json({ success: true, data: updatedCard });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Update card (after review)\napp.put('/api/cards/:id', (req, res) => {\n  try {\n    const { due_date, interval, ease_factor, repetitions, lapses, state, last_review } = req.body;\n    const stmt = db.prepare(`\n      UPDATE cards SET\n        due_date = ?,\n        interval = ?,\n        ease_factor = ?,\n        repetitions = ?,\n        lapses = ?,\n        state = ?,\n        last_review = ?\n      WHERE id = ?\n    `);\n    stmt.run(due_date, interval, ease_factor, repetitions, lapses, state, last_review, req.params.id);\n    \n    const updatedCard = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    res.json({ success: true, data: updatedCard });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Delete card\napp.delete('/api/cards/:id', (req, res) => {\n  try {\n    db.prepare('DELETE FROM cards WHERE id = ?').run(req.params.id);\n    res.json({ success: true });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// ==================== Statistics API ====================\n\n// Get statistics (with optional deck filter)\napp.get('/api/stats', (req, res) => {\n  try {\n    const deckId = req.query.deck ? parseInt(req.query.deck) : null;\n    \n    let total, due, reviewed, newCards, learning, avgEase;\n    \n    if (deckId) {\n      total = db.prepare('SELECT COUNT(*) as count FROM cards WHERE deck_id = ?').get(deckId).count;\n      due = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE deck_id = ? AND strftime('%s', due_date) <= strftime('%s', 'now')\").get(deckId).count;\n      reviewed = db.prepare('SELECT COUNT(*) as count FROM cards WHERE deck_id = ? AND repetitions > 0').get(deckId).count;\n      // Fixed: Added parentheses around OR condition and handle both 'new' state and repetitions = 0\n      newCards = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE deck_id = ? AND (state = 'new' OR repetitions = 0)\").get(deckId).count;\n      learning = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE deck_id = ? AND (state = 'learning' OR state = 'relearning')\").get(deckId).count;\n      avgEase = db.prepare('SELECT AVG(ease_factor) as avg FROM cards WHERE deck_id = ? AND repetitions > 0').get(deckId).avg || 2.5;\n    } else {\n      total = db.prepare('SELECT COUNT(*) as count FROM cards').get().count;\n      due = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE strftime('%s', due_date) <= strftime('%s', 'now')\").get().count;\n      reviewed = db.prepare('SELECT COUNT(*) as count FROM cards WHERE repetitions > 0').get().count;\n      // Fixed: Added parentheses around OR condition\n      newCards = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE state = 'new' OR repetitions = 0\").get().count;\n      learning = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE state = 'learning' OR state = 'relearning'\").get().count;\n      avgEase = db.prepare('SELECT AVG(ease_factor) as avg FROM cards WHERE repetitions > 0').get().avg || 2.5;\n    }\n    \n    res.json({\n      success: true,\n      data: {\n        total,\n        due,\n        reviewed,\n        new: newCards,\n        learning,\n        avgEase: Math.round(avgEase * 100) / 100\n      }\n    });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// ==================== Review API ====================\n\n// Preview intervals before rating\napp.get('/api/review/:id/preview', (req, res) => {\n  try {\n    const card = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    if (!card) {\n      return res.status(404).json({ success: false, error: 'Card not found' });\n    }\n    \n    const previews = {};\n    for (let rating = 1; rating <= 5; rating++) {\n      const result = FSRSEngine.previewIntervals(card, rating);\n      if (result) {\n        previews[rating] = formatInterval(result.interval);\n      }\n    }\n    \n    res.json({ success: true, data: previews });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Review card with FSRS rating\napp.post('/api/review/:id', (req, res) => {\n  try {\n    const { rating } = req.body;\n    if (!rating || rating < 1 || rating > 5) {\n      return res.status(400).json({ success: false, error: 'Rating must be 1-5' });\n    }\n    \n    const card = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    if (!card) {\n      return res.status(404).json({ success: false, error: 'Card not found' });\n    }\n    \n    // Use FSRS engine for scheduling\n    const fsrsCard = FSRSEngine.dbToCard(card);\n    const result = FSRSEngine.repeat(fsrsCard, rating);\n    \n    if (!result) {\n      return res.status(500).json({ success: false, error: 'Failed to calculate FSRS' });\n    }\n    \n    // Update card\n    const now = new Date();\n    db.prepare(`\n      UPDATE cards SET\n        due_date = ?,\n        interval = ?,\n        ease_factor = ?,\n        repetitions = ?,\n        lapses = ?,\n        state = ?,\n        last_review = ?\n      WHERE id = ?\n    `).run(\n      result.due_date,\n      result.interval,\n      result.ease_factor,\n      result.repetitions,\n      result.lapses,\n      result.state,\n      now.toISOString(),\n      req.params.id\n    );\n    \n    const updatedCard = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    res.json({ \n      success: true, \n      data: updatedCard, \n      nextInterval: formatInterval(result.interval)\n    });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Helper function to format interval - properly handles minutes\nfunction formatInterval(days) {\n  if (days < 1) {\n    // Convert to minutes (days * 24 * 60)\n    const minutes = Math.round(days * 24 * 60);\n    if (minutes < 60) {\n      return `${minutes}m`;\n    } else {\n      // If more than 60 minutes, show hours\n      return `${Math.round(minutes / 60)}h`;\n    }\n  } else if (days < 30) {\n    return `${Math.round(days)}d`;\n  } else if (days < 365) {\n    return `${Math.round(days / 30)}mo`;\n  } else {\n    return `${Math.round(days / 365)}y`;\n  }\n}\n\n// Serve SPA for all other routes\napp.get('*', (req, res) => {\n  res.sendFile(path.join(__dirname, 'public', 'index.html'));\n});\n\n// Start server\napp.listen(PORT, () => {\n  console.log(`FSRS Web UI server running on http://localhost:${PORT}`);\n});\n\nmodule.exports = app;\n"}],"isError":false,"timestamp":1772167523713}}
