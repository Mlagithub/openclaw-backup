{"type":"message","id":"6a196cf6","parentId":"6943dd2d","timestamp":"2026-02-27T02:40:22.932Z","message":{"role":"toolResult","toolCallId":"call_function_or13lnqn4i5v_1","toolName":"read","content":[{"type":"text","text":"// server.js - Express Backend for FSRS Web UI with Multi-deck & Theme support\nconst express = require('express');\nconst cors = require('cors');\nconst path = require('path');\nconst Database = require('better-sqlite3');\n\nconst app = express();\nconst PORT = process.env.PORT || 3001;\n\n// Middleware\napp.use(cors());\napp.use(express.json());\napp.use(express.static(path.join(__dirname, 'public')));\n\n// Database setup - connect to existing cards.db\nconst DB_PATH = process.env.DB_PATH || path.join(__dirname, '..', 'data', 'cards.db');\nconst db = new Database(DB_PATH);\n\n// Import FSRS engine\nconst FSRSEngine = require('../src/fsrs');\n\n// ==================== Database Helper Functions ====================\n\n// Fix inconsistent state values in database\nfunction fixCardStates() {\n  try {\n    // Fix \"2.0\" state to \"review\" (this was a bug where State.Review = 2 was stored as string)\n    const result = db.prepare(\"UPDATE cards SET state = 'review' WHERE state = '2.0'\").run();\n    if (result.changes > 0) {\n      console.log(`Fixed ${result.changes} cards with invalid state '2.0'`);\n    }\n    \n    // Fix empty or null states to \"new\"\n    db.prepare(\"UPDATE cards SET state = 'new' WHERE state IS NULL OR state = ''\").run();\n  } catch (error) {\n    console.error('Error fixing card states:', error);\n  }\n}\n\n// Run state fix on startup\nfixCardStates();\n\n// Get current local time for database queries\nfunction getLocalNow() {\n  return new Date().toISOString();\n}\n\n// ==================== Settings API ====================\n\n// Get theme\napp.get('/api/settings/theme', (req, res) => {\n  try {\n    const theme = db.prepare(\"SELECT value FROM settings WHERE key = 'theme'\").get();\n    res.json({ success: true, data: theme ? theme.value : 'light' });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Set theme\napp.post('/api/settings/theme', (req, res) => {\n  try {\n    const { theme } = req.body;\n    if (!theme || !['light', 'dark'].includes(theme)) {\n      return res.status(400).json({ success: false, error: 'Invalid theme' });\n    }\n    db.prepare(`\n      INSERT INTO settings (key, value) VALUES ('theme', ?)\n      ON CONFLICT(key) DO UPDATE SET value = excluded.value\n    `).run(theme);\n    res.json({ success: true, data: theme });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// ==================== Deck API ====================\n\n// Get all decks\napp.get('/api/decks', (req, res) => {\n  try {\n    // Use localtime for due_date comparison to match user timezone\n    const decks = db.prepare(`\n      SELECT d.*, \n        (SELECT COUNT(*) FROM cards WHERE deck_id = d.id) as card_count,\n        (SELECT COUNT(*) FROM cards WHERE deck_id = d.id AND strftime('%s', due_date) <= strftime('%s', 'now')) as due_count\n      FROM decks d \n      ORDER BY d.id ASC\n    `).all();\n    res.json({ success: true, data: decks });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Get single deck\napp.get('/api/decks/:id', (req, res) => {\n  try {\n    const deck = db.prepare('SELECT * FROM decks WHERE id = ?').get(req.params.id);\n    if (!deck) {\n      return res.status(404).json({ success: false, error: 'Deck not found' });\n    }\n    res.json({ success: true, data: deck });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Create deck\napp.post('/api/decks', (req, res) => {\n  try {\n    const { name, description } = req.body;\n    if (!name) {\n      return res.status(400).json({ success: false, error: 'Deck name required' });\n    }\n    \n    const stmt = db.prepare('INSERT INTO decks (name, description) VALUES (?, ?)');\n    const result = stmt.run(name, description || '');\n    \n    const newDeck = db.prepare('SELECT * FROM decks WHERE id = ?').get(result.lastInsertRowid);\n    res.json({ success: true, data: newDeck });\n  } catch (error) {\n    if (error.message.includes('UNIQUE')) {\n      return res.status(400).json({ success: false, error: 'Deck name already exists' });\n    }\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Update deck\napp.put('/api/decks/:id', (req, res) => {\n  try {\n    const { name, description } = req.body;\n    const deckId = parseInt(req.params.id);\n    \n    if (deckId === 1) {\n      return res.status(400).json({ success: false, error: 'Cannot modify default deck' });\n    }\n    \n    db.prepare(`\n      UPDATE decks SET name = ?, description = ?, updated_at = datetime('now') WHERE id = ?\n    `).run(name, description || '', deckId);\n    \n    const updatedDeck = db.prepare('SELECT * FROM decks WHERE id = ?').get(deckId);\n    res.json({ success: true, data: updatedDeck });\n  } catch (error) {\n    if (error.message.includes('UNIQUE')) {\n      return res.status(400).json({ success: false, error: 'Deck name already exists' });\n    }\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Delete deck\napp.delete('/api/decks/:id', (req, res) => {\n  try {\n    const deckId = parseInt(req.params.id);\n    \n    if (deckId === 1) {\n      return res.status(400).json({ success: false, error: 'Cannot delete default deck' });\n    }\n    \n    // Move cards to default deck before deleting\n    db.prepare('UPDATE cards SET deck_id = 1 WHERE deck_id = ?').run(deckId);\n    db.prepare('DELETE FROM decks WHERE id = ?').run(deckId);\n    \n    res.json({ success: true });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// ==================== Card API ====================\n\n// Get all cards (with optional deck filter)\napp.get('/api/cards', (req, res) => {\n  try {\n    const deckId = req.query.deck ? parseInt(req.query.deck) : null;\n    let cards;\n    if (deckId) {\n      cards = db.prepare('SELECT * FROM cards WHERE deck_id = ? ORDER BY created_at DESC').all(deckId);\n    } else {\n      cards = db.prepare('SELECT * FROM cards ORDER BY created_at DESC').all();\n    }\n    res.json({ success: true, data: cards });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Get due cards (with optional deck filter)\napp.get('/api/cards/due', (req, res) => {\n  try {\n    const deckId = req.query.deck ? parseInt(req.query.deck) : null;\n    // Use localtime for consistency with deck stats\n    const now = new Date();\n    let cards;\n    if (deckId) {\n      cards = db.prepare(`\n        SELECT * FROM cards \n        WHERE deck_id = ? AND strftime('%s', due_date) <= strftime('%s', 'now')\n        ORDER BY due_date ASC\n      `).all(deckId);\n    } else {\n      cards = db.prepare(`\n        SELECT * FROM cards \n        WHERE strftime('%s', due_date) <= strftime('%s', 'now')\n        ORDER BY due_date ASC\n      `).all();\n    }\n    res.json({ success: true, data: cards });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Get single card\napp.get('/api/cards/:id', (req, res) => {\n  try {\n    const card = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    if (!card) {\n      return res.status(404).json({ success: false, error: 'Card not found' });\n    }\n    res.json({ success: true, data: card });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Add new card (with optional deck)\napp.post('/api/cards', (req, res) => {\n  try {\n    const { question, answer, deck_id } = req.body;\n    if (!question || !answer) {\n      return res.status(400).json({ success: false, error: 'Question and answer required' });\n    }\n    \n    const deckId = deck_id ? parseInt(deck_id) : 1;\n    const now = new Date();\n    const stmt = db.prepare(`\n      INSERT INTO cards (deck_id, question, answer, due_date, created_at, state)\n      VALUES (?, ?, ?, ?, ?, 'new')\n    `);\n    const result = stmt.run(deckId, question, answer, now.toISOString(), now.toISOString());\n    \n    const newCard = db.prepare('SELECT * FROM cards WHERE id = ?').get(result.lastInsertRowid);\n    res.json({ success: true, data: newCard });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Move card to different deck\napp.put('/api/cards/:id/deck', (req, res) => {\n  try {\n    const { deck_id } = req.body;\n    db.prepare('UPDATE cards SET deck_id = ? WHERE id = ?').run(deck_id, req.params.id);\n    const updatedCard = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    res.json({ success: true, data: updatedCard });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Update card (after review)\napp.put('/api/cards/:id', (req, res) => {\n  try {\n    const { due_date, interval, ease_factor, repetitions, lapses, state, last_review } = req.body;\n    const stmt = db.prepare(`\n      UPDATE cards SET\n        due_date = ?,\n        interval = ?,\n        ease_factor = ?,\n        repetitions = ?,\n        lapses = ?,\n        state = ?,\n        last_review = ?\n      WHERE id = ?\n    `);\n    stmt.run(due_date, interval, ease_factor, repetitions, lapses, state, last_review, req.params.id);\n    \n    const updatedCard = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    res.json({ success: true, data: updatedCard });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Delete card\napp.delete('/api/cards/:id', (req, res) => {\n  try {\n    db.prepare('DELETE FROM cards WHERE id = ?').run(req.params.id);\n    res.json({ success: true });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// ==================== Statistics API ====================\n\n// Get statistics (with optional deck filter)\napp.get('/api/stats', (req, res) => {\n  try {\n    const deckId = req.query.deck ? parseInt(req.query.deck) : null;\n    \n    let total, due, reviewed, newCards, learning, avgEase;\n    \n    if (deckId) {\n      total = db.prepare('SELECT COUNT(*) as count FROM cards WHERE deck_id = ?').get(deckId).count;\n      due = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE deck_id = ? AND strftime('%s', due_date) <= strftime('%s', 'now')\").get(deckId).count;\n      reviewed = db.prepare('SELECT COUNT(*) as count FROM cards WHERE deck_id = ? AND repetitions > 0').get(deckId).count;\n      // Fixed: Added parentheses around OR condition and handle both 'new' state and repetitions = 0\n      newCards = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE deck_id = ? AND (state = 'new' OR repetitions = 0)\").get(deckId).count;\n      learning = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE deck_id = ? AND (state = 'learning' OR state = 'relearning')\").get(deckId).count;\n      avgEase = db.prepare('SELECT AVG(ease_factor) as avg FROM cards WHERE deck_id = ? AND repetitions > 0').get(deckId).avg || 2.5;\n    } else {\n      total = db.prepare('SELECT COUNT(*) as count FROM cards').get().count;\n      due = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE strftime('%s', due_date) <= strftime('%s', 'now')\").get().count;\n      reviewed = db.prepare('SELECT COUNT(*) as count FROM cards WHERE repetitions > 0').get().count;\n      // Fixed: Added parentheses around OR condition\n      newCards = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE state = 'new' OR repetitions = 0\").get().count;\n      learning = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE state = 'learning' OR state = 'relearning'\").get().count;\n      avgEase = db.prepare('SELECT AVG(ease_factor) as avg FROM cards WHERE repetitions > 0').get().avg || 2.5;\n    }\n    \n    res.json({\n      success: true,\n      data: {\n        total,\n        due,\n        reviewed,\n        new: newCards,\n        learning,\n        avgEase: Math.round(avgEase * 100) / 100\n      }\n    });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// ==================== Review API ====================\n\n// Preview intervals before rating\napp.get('/api/review/:id/preview', (req, res) => {\n  try {\n    const card = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    if (!card) {\n      return res.status(404).json({ success: false, error: 'Card not found' });\n    }\n    \n    const previews = {};\n    for (let rating = 1; rating <= 5; rating++) {\n      const result = FSRSEngine.previewIntervals(card, rating);\n      if (result) {\n        previews[rating] = formatInterval(result.interval);\n      }\n    }\n    \n    res.json({ success: true, data: previews });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Review card with FSRS rating\napp.post('/api/review/:id', (req, res) => {\n  try {\n    const { rating } = req.body;\n    if (!rating || rating < 1 || rating > 5) {\n      return res.status(400).json({ success: false, error: 'Rating must be 1-5' });\n    }\n    \n    const card = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    if (!card) {\n      return res.status(404).json({ success: false, error: 'Card not found' });\n    }\n    \n    // Use FSRS engine for scheduling\n    const fsrsCard = FSRSEngine.dbToCard(card);\n    const result = FSRSEngine.repeat(fsrsCard, rating);\n    \n    if (!result) {\n      return res.status(500).json({ success: false, error: 'Failed to calculate FSRS' });\n    }\n    \n    // Update card\n    const now = new Date();\n    db.prepare(`\n      UPDATE cards SET\n        due_date = ?,\n        interval = ?,\n        ease_factor = ?,\n        repetitions = ?,\n        lapses = ?,\n        state = ?,\n        last_review = ?\n      WHERE id = ?\n    `).run(\n      result.due_date,\n      result.interval,\n      result.ease_factor,\n      result.repetitions,\n      result.lapses,\n      result.state,\n      now.toISOString(),\n      req.params.id\n    );\n    \n    const updatedCard = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    res.json({ \n      success: true, \n      data: updatedCard, \n      nextInterval: formatInterval(result.interval)\n    });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Helper function to format interval\nfunction formatInterval(days) {\n  if (days < 1) {\n    return `${Math.round(days * 24)}m`;\n  } else if (days < 30) {\n    return `${Math.round(days)}d`;\n  } else if (days < 365) {\n    return `${Math.round(days / 30)}mo`;\n  } else {\n    return `${Math.round(days / 365)}y`;\n  }\n}\n\n// Serve SPA for all other routes\napp.get('*', (req, res) => {\n  res.sendFile(path.join(__dirname, 'public', 'index.html'));\n});\n\n// Start server\napp.listen(PORT, () => {\n  console.log(`FSRS Web UI server running on http://localhost:${PORT}`);\n});\n\nmodule.exports = app;\n"}],"isError":false,"timestamp":1772160022930}}
{"type":"message","id":"987d372b","parentId":"6a196cf6","timestamp":"2026-02-27T02:40:28.069Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Now let me read the app.js file to understand how the frontend displays the intervals.","thinkingSignature":"ae9c5785f4e4783294680c8fa231d7a9cac526bff325076d5d1e0030f50980fc"},{"type":"text","text":"Now let me read the frontend app.js to see how it displays the intervals:\n"},{"type":"toolCall","id":"call_function_fn63yl98m1vp_1","name":"read","arguments":{"file_path":"/home/one/.openclaw/skills/fsrs-memory/web/public/app.js"}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M2.5","usage":{"input":5699,"output":76,"cacheRead":7789,"cacheWrite":0,"totalTokens":13564,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772160022932}}
{"type":"message","id":"f486c8ce","parentId":"987d372b","timestamp":"2026-02-27T02:40:28.083Z","message":{"role":"toolResult","toolCallId":"call_function_fn63yl98m1vp_1","toolName":"read","content":[{"type":"text","text":"// FSRS Memory Web UI - Application Logic with Multi-deck & Theme support\n\nconst API_BASE = window.location.origin;\n\n// State\nlet currentView = 'study';\nlet currentDeckId = null;\nlet dueCards = [];\nlet allCards = [];\nlet allDecks = [];\nlet currentCardIndex = 0;\nlet currentCard = null;\nlet isAnswerShown = false;\nlet currentTheme = 'light';\n\n// ==================== Initialization ====================\n\ndocument.addEventListener('DOMContentLoaded', () => {\n  initTheme();\n  initNavigation();\n  initKeyboardShortcuts();\n  loadDecks();\n  loadStats();\n  loadDueCards();\n});\n\n// ==================== Theme ====================\n\nasync function initTheme() {\n  try {\n    const response = await fetch(`${API_BASE}/api/settings/theme`);\n    const result = await response.json();\n    if (result.success) {\n      currentTheme = result.data || 'light';\n      applyTheme(currentTheme);\n    }\n  } catch (error) {\n    console.error('Failed to load theme:', error);\n  }\n}\n\nfunction applyTheme(theme) {\n  document.documentElement.setAttribute('data-theme', theme);\n  document.getElementById('theme-icon').textContent = theme === 'dark' ? '☀️' : '🌙';\n  currentTheme = theme;\n}\n\nasync function toggleTheme() {\n  const newTheme = currentTheme === 'light' ? 'dark' : 'light';\n  try {\n    await fetch(`${API_BASE}/api/settings/theme`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ theme: newTheme })\n    });\n    applyTheme(newTheme);\n    showToast(`已切换到${newTheme === 'dark' ? '暗色' : '亮色'}主题`, 'success');\n  } catch (error) {\n    console.error('Failed to save theme:', error);\n    showToast('主题切换失败', 'error');\n  }\n}\n\n// ==================== Navigation ====================\n\nfunction initNavigation() {\n  const navItems = document.querySelectorAll('.nav-item');\n  navItems.forEach(item => {\n    item.addEventListener('click', () => {\n      const view = item.dataset.view;\n      showView(view);\n    });\n  });\n}\n\nfunction showView(view) {\n  // Update nav\n  document.querySelectorAll('.nav-item').forEach(item => {\n    item.classList.toggle('active', item.dataset.view === view);\n  });\n  \n  // Update view\n  document.querySelectorAll('.view').forEach(v => {\n    v.classList.toggle('active', v.id === `${view}-view`);\n  });\n  \n  currentView = view;\n  \n  // Load data for specific views\n  if (view === 'study') {\n    loadDueCards();\n  } else if (view === 'cards') {\n    loadAllCards();\n  } else if (view === 'decks') {\n    loadDecksGrid();\n  } else if (view === 'stats') {\n    loadStats();\n  }\n}\n\n// ==================== Deck Management ====================\n\nasync function loadDecks() {\n  try {\n    const response = await fetch(`${API_BASE}/api/decks`);\n    const result = await response.json();\n    \n    if (result.success) {\n      allDecks = result.data;\n      updateDeckSelectors();\n    }\n  } catch (error) {\n    console.error('Failed to load decks:', error);\n  }\n}\n\nfunction updateDeckSelectors() {\n  // Update sidebar deck selector\n  const sidebarSelect = document.getElementById('deck-select');\n  const addViewSelect = document.getElementById('deck-select-add');\n  \n  const options = allDecks.map(deck => \n    `<option value=\"${deck.id}\">${deck.name} (${deck.due_count || 0} 待复习)</option>`\n  ).join('');\n  \n  sidebarSelect.innerHTML = '<option value=\"\">全部牌组</option>' + options;\n  addViewSelect.innerHTML = options;\n  \n  // Set default selection\n  if (allDecks.length > 0 && !currentDeckId) {\n    addViewSelect.value = allDecks[0].id;\n  }\n}\n\nasync function changeDeck(deckId) {\n  currentDeckId = deckId ? parseInt(deckId) : null;\n  \n  // Update deck info in study view\n  const deckInfo = document.getElementById('deck-info');\n  if (currentDeckId) {\n    const deck = allDecks.find(d => d.id === currentDeckId);\n    deckInfo.textContent = `当前牌组: ${deck ? deck.name : ''}`;\n  } else {\n    deckInfo.textContent = '';\n  }\n  \n  // Reload data\n  if (currentView === 'study') {\n    loadDueCards();\n  } else if (currentView === 'cards') {\n    loadAllCards();\n  } else if (currentView === 'stats') {\n    loadStats();\n  }\n}\n\nasync function loadDecksGrid() {\n  try {\n    const response = await fetch(`${API_BASE}/api/decks`);\n    const result = await response.json();\n    \n    if (result.success) {\n      renderDecksGrid(result.data);\n    }\n  } catch (error) {\n    console.error('Failed to load decks:', error);\n    showToast('加载失败', 'error');\n  }\n}\n\nfunction renderDecksGrid(decks) {\n  const container = document.getElementById('decks-grid');\n  \n  container.innerHTML = decks.map(deck => `\n    <div class=\"deck-card\">\n      <div class=\"deck-card-header\">\n        <div class=\"deck-card-name\">${escapeHtml(deck.name)}</div>\n        ${deck.id === 1 ? '<span class=\"deck-card-default\">默认</span>' : ''}\n      </div>\n      <div class=\"deck-card-desc\">${escapeHtml(deck.description || '暂无描述')}</div>\n      <div class=\"deck-card-stats\">\n        <div class=\"deck-stat\">\n          <div class=\"deck-stat-value\">${deck.card_count || 0}</div>\n          <div class=\"deck-stat-label\">卡片数</div>\n        </div>\n        <div class=\"deck-stat\">\n          <div class=\"deck-stat-value\">${deck.due_count || 0}</div>\n          <div class=\"deck-stat-label\">待复习</div>\n        </div>\n      </div>\n      <div class=\"deck-card-actions\">\n        <button class=\"btn btn-secondary btn-small\" onclick=\"showEditDeckModal(${deck.id})\">编辑</button>\n        ${deck.id !== 1 ? `<button class=\"btn btn-danger btn-small\" onclick=\"confirmDeleteDeck(${deck.id})\">删除</button>` : ''}\n        <button class=\"btn btn-primary btn-small\" onclick=\"selectDeckAndStudy(${deck.id})\">学习</button>\n      </div>\n    </div>\n  `).join('');\n}\n\nfunction showCreateDeckModal() {\n  document.getElementById('deck-modal-title').textContent = '新建牌组';\n  document.getElementById('deck-name-input').value = '';\n  document.getElementById('deck-desc-input').value = '';\n  document.getElementById('save-deck-btn').onclick = createDeck;\n  document.getElementById('deck-modal').style.display = 'flex';\n}\n\nfunction showEditDeckModal(deckId) {\n  const deck = allDecks.find(d => d.id === deckId);\n  if (!deck) return;\n  \n  document.getElementById('deck-modal-title').textContent = '编辑牌组';\n  document.getElementById('deck-name-input').value = deck.name;\n  document.getElementById('deck-desc-input').value = deck.description || '';\n  document.getElementById('save-deck-btn').onclick = () => updateDeck(deckId);\n  document.getElementById('deck-modal').style.display = 'flex';\n}\n\nfunction closeDeckModal() {\n  document.getElementById('deck-modal').style.display = 'none';\n}\n\nasync function createDeck() {\n  const name = document.getElementById('deck-name-input').value.trim();\n  const description = document.getElementById('deck-desc-input').value.trim();\n  \n  if (!name) {\n    showToast('请输入牌组名称', 'error');\n    return;\n  }\n  \n  try {\n    const response = await fetch(`${API_BASE}/api/decks`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ name, description })\n    });\n    \n    const result = await response.json();\n    \n    if (result.success) {\n      showToast('牌组创建成功', 'success');\n      closeDeckModal();\n      loadDecks();\n      loadDecksGrid();\n    } else {\n      showToast(result.error || '创建失败', 'error');\n    }\n  } catch (error) {\n    console.error('Failed to create deck:', error);\n    showToast('创建失败', 'error');\n  }\n}\n\nasync function updateDeck(deckId) {\n  const name = document.getElementById('deck-name-input').value.trim();\n  const description = document.getElementById('deck-desc-input').value.trim();\n  \n  if (!name) {\n    showToast('请输入牌组名称', 'error');\n    return;\n  }\n  \n  try {\n    const response = await fetch(`${API_BASE}/api/decks/${deckId}`, {\n      method: 'PUT',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ name, description })\n    });\n    \n    const result = await response.json();\n    \n    if (result.success) {\n      showToast('牌组更新成功', 'success');\n      closeDeckModal();\n      loadDecks();\n      loadDecksGrid();\n    } else {\n      showToast(result.error || '更新失败', 'error');\n    }\n  } catch (error) {\n    console.error('Failed to update deck:', error);\n    showToast('更新失败', 'error');\n  }\n}\n\nfunction confirmDeleteDeck(deckId) {\n  if (confirm('确定要删除这个牌组吗？该牌组中的卡片将移动到默认牌组。')) {\n    deleteDeck(deckId);\n  }\n}\n\nasync function deleteDeck(deckId) {\n  try {\n    const response = await fetch(`${API_BASE}/api/decks/${deckId}`, {\n      method: 'DELETE'\n    });\n    \n    const result = await response.json();\n    \n    if (result.success) {\n      showToast('牌组已删除', 'success');\n      loadDecks();\n      loadDecksGrid();\n      loadStats();\n    } else {\n      showToast(result.error || '删除失败', 'error');\n    }\n  } catch (error) {\n    console.error('Failed to delete deck:', error);\n    showToast('删除失败', 'error');\n  }\n}\n\nfunction selectDeckAndStudy(deckId) {\n  document.getElementById('deck-select').value = deckId;\n  changeDeck(deckId);\n  showView('study');\n}\n\n// ==================== Keyboard Shortcuts ====================\n\nfunction initKeyboardShortcuts() {\n  document.addEventListener('keydown', (e) => {\n    // Don't trigger shortcuts when typing in inputs\n    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') {\n      return;\n    }\n    \n    // Study view shortcuts\n    if (currentView === 'study' && dueCards.length > 0) {\n      if (!isAnswerShown) {\n        // Space or Enter to show answer\n        if (e.code === 'Space' || e.code === 'Enter') {\n          e.preventDefault();\n          showAnswer();\n        }\n      } else {\n        // Number keys 1-5 for rating\n        if (e.key >= '1' && e.key <= '5') {\n          e.preventDefault();\n          rateCard(parseInt(e.key));\n        }\n      }\n    }\n    \n    // Navigation shortcuts\n    if (e.altKey) {\n      switch(e.key) {\n        case '1':\n          showView('study');\n          break;\n        case '2':\n          showView('cards');\n          break;\n        case '3':\n          showView('decks');\n          break;\n        case '4':\n          showView('add');\n          break;\n        case '5':\n          showView('stats');\n          break;\n      }\n    }\n  });\n}\n\n// ==================== Study View ====================\n\nasync function loadDueCards() {\n  try {\n    let url = `${API_BASE}/api/cards/due`;\n    if (currentDeckId) {\n      url += `?deck=${currentDeckId}`;\n    }\n    \n    const response = await fetch(url);\n    const result = await response.json();\n    \n    // Handle API error response\n    if (!result.success) {\n      console.error('API error:', result.error);\n      showToast(result.error || '加载失败', 'error');\n      return;\n    }\n    \n    dueCards = result.data;\n    currentCardIndex = 0;\n    isAnswerShown = false;\n    updateStudyProgress();\n    \n    if (dueCards.length > 0) {\n      showCard();\n    } else {\n      showEmptyState();\n    }\n  } catch (error) {\n    console.error('Failed to load due cards:', error);\n    showToast('加载失败', 'error');\n  }\n}\n\nfunction updateStudyProgress() {\n  const studied = currentCardIndex;\n  const total = dueCards.length;\n  document.getElementById('study-progress').textContent = `${studied} / ${total}`;\n  document.getElementById('due-badge').textContent = total;\n}\n\nfunction showCard() {\n  isAnswerShown = false;\n  \n  const emptyState = document.getElementById('no-cards-message');\n  const cardArea = document.getElementById('card-area');\n  \n  emptyState.style.display = 'none';\n  cardArea.style.display = 'flex';\n  cardArea.style.flexDirection = 'column';\n  cardArea.style.alignItems = 'center';\n  \n  currentCard = dueCards[currentCardIndex];\n  \n  // Reset card display with animation\n  const cardFront = document.getElementById('card-front');\n  const cardBack = document.getElementById('card-back');\n  \n  cardFront.style.display = 'block';\n  cardFront.style.animation = 'fadeIn 0.3s ease';\n  cardBack.style.display = 'none';\n  \n  document.getElementById('show-answer-btn').style.display = 'inline-block';\n  document.getElementById('rating-buttons').style.display = 'none';\n  \n  // Set card content\n  document.getElementById('card-id').textContent = currentCard.id;\n  document.getElementById('card-state').textContent = currentCard.state;\n  document.getElementById('card-state').className = `card-state ${currentCard.state}`;\n  document.getElementById('question-text').textContent = currentCard.question;\n  document.getElementById('answer-text').textContent = currentCard.answer;\n  \n  // Update intervals preview\n  updateIntervalPreview();\n  \n  // Focus the show answer button for accessibility\n  document.getElementById('show-answer-btn').focus();\n}\n\nasync function showAnswer() {\n  isAnswerShown = true;\n  \n  // Fetch preview intervals from server\n  try {\n    const response = await fetch(`${API_BASE}/api/review/${currentCard.id}/preview`);\n    const result = await response.json();\n    \n    if (result.success) {\n      const previews = result.data;\n      document.getElementById('interval-1').textContent = previews[1] || '1m';\n      document.getElementById('interval-2').textContent = previews[2] || '10m';\n      document.getElementById('interval-3').textContent = previews[3] || '1d';\n      document.getElementById('interval-4').textContent = previews[4] || '4d';\n      document.getElementById('interval-5').textContent = previews[5] || '10d';\n    }\n  } catch (error) {\n    console.error('Failed to load preview:', error);\n    // Fallback to calculated intervals\n    const intervals = calculateIntervals(currentCard);\n    document.getElementById('interval-1').textContent = intervals[0];\n    document.getElementById('interval-2').textContent = intervals[1];\n    document.getElementById('interval-3').textContent = intervals[2];\n    document.getElementById('interval-4').textContent = intervals[3];\n    document.getElementById('interval-5').textContent = intervals[4];\n  }\n  \n  const cardFront = document.getElementById('card-front');\n  const cardBack = document.getElementById('card-back');\n  \n  cardFront.style.display = 'none';\n  cardBack.style.display = 'flex';\n  cardBack.style.animation = 'fadeIn 0.3s ease';\n  \n  document.getElementById('show-answer-btn').style.display = 'none';\n  document.getElementById('rating-buttons').style.display = 'flex';\n  \n  // Focus first rating button\n  document.querySelector('.rating-btn').focus();\n}\n\nfunction updateIntervalPreview() {\n  // Calculate interval previews based on current card state\n  const intervals = calculateIntervals(currentCard);\n  \n  document.getElementById('interval-1').textContent = intervals[0];\n  document.getElementById('interval-2').textContent = intervals[1];\n  document.getElementById('interval-3').textContent = intervals[2];\n  document.getElementById('interval-4').textContent = intervals[3];\n  document.getElementById('interval-5').textContent = intervals[4];\n}\n\nfunction calculateIntervals(card) {\n  let { interval, ease_factor, repetitions } = card;\n  ease_factor = ease_factor || 2.5;\n  interval = interval || 0;\n  \n  return [\n    '1m',  // Again\n    Math.max(1, Math.round(interval * 1.2)) + 'm',  // Hard\n    repetitions === 0 ? '1d' : (repetitions === 1 ? '6d' : Math.round(interval * ease_factor) + 'd'),  // Good\n    repetitions === 0 ? '4d' : Math.round(interval * ease_factor * 1.3) + 'd',  // Easy\n    repetitions === 0 ? '10d' : Math.round(interval * ease_factor * 1.5) + 'd'  // Perfect\n  ];\n}\n\nasync function rateCard(rating) {\n  try {\n    const response = await fetch(`${API_BASE}/api/review/${currentCard.id}`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ rating })\n    });\n    \n    const result = await response.json();\n    \n    if (result.success) {\n      currentCardIndex++;\n      updateStudyProgress();\n      \n      if (currentCardIndex < dueCards.length) {\n        showCard();\n      } else {\n        // All cards reviewed\n        showCompleteState();\n      }\n      \n      // Update stats in background\n      loadStats();\n      loadDecks(); // Update deck due counts\n      \n      // Show toast with next interval\n      showToast(`已评分 - 下次复习: ${result.nextInterval}`, 'success');\n    }\n  } catch (error) {\n    console.error('Failed to rate card:', error);\n    showToast('评分失败', 'error');\n  }\n}\n\nfunction showEmptyState() {\n  const container = document.getElementById('study-container');\n  container.innerHTML = `\n    <div class=\"empty-state\" id=\"no-cards-message\">\n      <div class=\"empty-icon\">🎉</div>\n      <h2>太棒了！</h2>\n      <p>${currentDeckId ? '这个牌组' : '今天'}没有需要复习的卡片了</p>\n      <button class=\"btn btn-primary\" onclick=\"showView('add')\">添加新卡片</button>\n    </div>\n  `;\n}\n\nfunction showCompleteState() {\n  const container = document.getElementById('study-container');\n  container.innerHTML = `\n    <div class=\"empty-state\">\n      <div class=\"empty-icon\">🏆</div>\n      <h2>完成！</h2>\n      <p>恭喜完成今日复习</p>\n      <button class=\"btn btn-primary\" onclick=\"showView('stats')\">查看统计</button>\n    </div>\n  `;\n}\n\n// ==================== Cards List ====================\n\nasync function loadAllCards() {\n  try {\n    let url = `${API_BASE}/api/cards`;\n    if (currentDeckId) {\n      url += `?deck=${currentDeckId}`;\n    }\n    \n    const response = await fetch(url);\n    const result = await response.json();\n    \n    if (result.success) {\n      allCards = result.data;\n      renderCardsList();\n    }\n  } catch (error) {\n    console.error('Failed to load cards:', error);\n    showToast('加载失败', 'error');\n  }\n}\n\nfunction renderCardsList() {\n  const container = document.getElementById('cards-list');\n  const searchTerm = document.getElementById('card-search').value.toLowerCase();\n  \n  const filteredCards = allCards.filter(card => \n    card.question.toLowerCase().includes(searchTerm) ||\n    card.answer.toLowerCase().includes(searchTerm)\n  );\n  \n  if (filteredCards.length === 0) {\n    container.innerHTML = `\n      <div class=\"empty-state\">\n        <div class=\"empty-icon\">📭</div>\n        <h2>没有找到卡片</h2>\n        <p>${searchTerm ? '尝试其他搜索词' : '添加你的第一张卡片吧'}</p>\n      </div>\n    `;\n    return;\n  }\n  \n  container.innerHTML = filteredCards.map(card => {\n    const deck = allDecks.find(d => d.id === card.deck_id);\n    return `\n      <div class=\"card-item\" data-id=\"${card.id}\">\n        <div class=\"card-item-content\">\n          <div class=\"card-item-header\">\n            <span class=\"card-item-id\">#${card.id}</span>\n            <span class=\"card-item-deck\">${deck ? deck.name : '默认'}</span>\n            <span class=\"card-item-state card-state ${card.state}\">${card.state}</span>\n          </div>\n          <div class=\"card-item-question\">${escapeHtml(card.question)}</div>\n          <div class=\"card-item-answer\">${escapeHtml(card.answer)}</div>\n          <div class=\"card-item-meta\">\n            <span>间隔: ${card.interval || 0}天</span>\n            <span>复习: ${card.repetitions || 0}次</span>\n            <span>难度: ${(card.ease_factor || 2.5).toFixed(2)}</span>\n          </div>\n        </div>\n        <div class=\"card-item-actions\">\n          <button class=\"btn-icon\" onclick=\"editCard(${card.id})\" title=\"编辑\">✏️</button>\n          <button class=\"btn-icon danger\" onclick=\"confirmDelete(${card.id})\" title=\"删除\">🗑️</button>\n        </div>\n      </div>\n    `;\n  }).join('');\n}\n\nfunction filterCards() {\n  renderCardsList();\n}\n\nfunction escapeHtml(text) {\n  const div = document.createElement('div');\n  div.textContent = text;\n  return div.innerHTML;\n}\n\n// ==================== Add Card ====================\n\nasync function addCard() {\n  const question = document.getElementById('question-input').value.trim();\n  const answer = document.getElementById('answer-input').value.trim();\n  const deckId = document.getElementById('deck-select-add').value;\n  \n  if (!question || !answer) {\n    showToast('请填写问题和答案', 'error');\n    return;\n  }\n  \n  // Basic validation\n  if (question.length > 1000 || answer.length > 5000) {\n    showToast('输入内容过长', 'error');\n    return;\n  }\n  \n  try {\n    const response = await fetch(`${API_BASE}/api/cards`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ \n        question, \n        answer,\n        deck_id: deckId || 1\n      })\n    });\n    \n    const result = await response.json();\n    \n    if (result.success) {\n      showToast('卡片添加成功', 'success');\n      document.getElementById('question-input').value = '';\n      document.getElementById('answer-input').value = '';\n      loadStats();\n      loadDecks();\n      // Refresh due cards if in study view to show newly added card\n      if (currentView === 'study') {\n        loadDueCards();\n      }\n    }\n  } catch (error) {\n    console.error('Failed to add card:', error);\n    showToast('添加失败', 'error');\n  }\n}\n\nasync function quickAdd() {\n  const input = document.getElementById('quick-add-input').value.trim();\n  const deckId = document.getElementById('deck-select-add').value;\n  \n  if (!input) {\n    showToast('请输入卡片内容', 'error');\n    return;\n  }\n  \n  const lines = input.split('\\n').filter(line => line.includes('::'));\n  if (lines.length === 0) {\n    showToast('格式错误，请使用 \"问题::答案\" 格式', 'error');\n    return;\n  }\n  \n  let successCount = 0;\n  \n  for (const line of lines) {\n    const [question, answer] = line.split('::').map(s => s.trim());\n    if (question && answer) {\n      try {\n        await fetch(`${API_BASE}/api/cards`, {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({ \n            question, \n            answer,\n            deck_id: deckId || 1\n          })\n        });\n        successCount++;\n      } catch (error) {\n        console.error('Failed to add card:', error);\n      }\n    }\n  }\n  \n  showToast(`成功添加 ${successCount} 张卡片`, 'success');\n  document.getElementById('quick-add-input').value = '';\n  loadStats();\n  loadDecks();\n  // Refresh due cards if in study view to show newly added cards\n  if (currentView === 'study') {\n    loadDueCards();\n  }\n}\n\n// ==================== Stats ====================\n\nasync function loadStats() {\n  try {\n    let url = `${API_BASE}/api/stats`;\n    if (currentDeckId) {\n      url += `?deck=${currentDeckId}`;\n    }\n    \n    const response = await fetch(url);\n    const result = await response.json();\n    \n    if (result.success) {\n      const stats = result.data;\n      \n      // Update sidebar stats\n      document.getElementById('total-cards').textContent = stats.total;\n      document.getElementById('due-cards').textContent = stats.due;\n      \n      // Update stats view\n      document.getElementById('stat-total').textContent = stats.total;\n      document.getElementById('stat-due').textContent = stats.due;\n      document.getElementById('stat-reviewed').textContent = stats.reviewed;\n      document.getElementById('stat-new').textContent = stats.new;\n      document.getElementById('stat-learning').textContent = stats.learning;\n      document.getElementById('stat-ease').textContent = stats.avgEase;\n      \n      // Update progress bar\n      const total = stats.total || 1;\n      const newPercent = (stats.new / total) * 100;\n      const learningPercent = (stats.learning / total) * 100;\n      const reviewPercent = (stats.reviewed / total) * 100;\n      \n      document.getElementById('progress-new').style.width = `${newPercent}%`;\n      document.getElementById('progress-learning').style.width = `${learningPercent}%`;\n      document.getElementById('progress-review').style.width = `${reviewPercent}%`;\n    }\n  } catch (error) {\n    console.error('Failed to load stats:', error);\n  }\n}\n\n// ==================== Delete Card ====================\n\nfunction confirmDelete(cardId) {\n  document.getElementById('delete-modal').style.display = 'flex';\n  document.getElementById('confirm-delete-btn').onclick = () => deleteCard(cardId);\n}\n\nfunction closeModal() {\n  document.getElementById('delete-modal').style.display = 'none';\n}\n\nasync function deleteCard(cardId) {\n  try {\n    const response = await fetch(`${API_BASE}/api/cards/${cardId}`, {\n      method: 'DELETE'\n    });\n    \n    const result = await response.json();\n    \n    if (result.success) {\n      showToast('卡片已删除', 'success');\n      closeModal();\n      loadAllCards();\n      loadStats();\n      loadDecks();\n    }\n  } catch (error) {\n    console.error('Failed to delete card:', error);\n    showToast('删除失败', 'error');\n  }\n}\n\n// ==================== Edit Card ====================\n\nasync function editCard(cardId) {\n  const card = allCards.find(c => c.id === cardId);\n  if (!card) return;\n  \n  // Set deck selector\n  document.getElementById('deck-select-add').value = card.deck_id;\n  \n  // Fill the add form with card data\n  document.getElementById('question-input').value = card.question;\n  document.getElementById('answer-input').value = card.answer;\n  \n  // Delete the old card\n  await deleteCard(cardId);\n  \n  // Switch to add view\n  showView('add');\n  showToast('已复制到编辑区，请修改后重新添加', 'success');\n}\n\n// ==================== Toast ====================\n\nfunction showToast(message, type = 'success') {\n  const toast = document.getElementById('toast');\n  toast.textContent = message;\n  toast.className = `toast ${type} show`;\n  \n  setTimeout(() => {\n    toast.classList.remove('show');\n  }, 3000);\n}\n\n// Make functions available globally\nwindow.showView = showView;\nwindow.showAnswer = showAnswer;\nwindow.rateCard = rateCard;\nwindow.addCard = addCard;\nwindow.quickAdd = quickAdd;\nwindow.filterCards = filterCards;\nwindow.confirmDelete = confirmDelete;\nwindow.closeModal = closeModal;\nwindow.deleteCard = deleteCard;\nwindow.editCard = editCard;\nwindow.showToast = showToast;\nwindow.toggleTheme = toggleTheme;\nwindow.changeDeck = changeDeck;\nwindow.showCreateDeckModal = showCreateDeckModal;\nwindow.showEditDeckModal = showEditDeckModal;\nwindow.closeDeckModal = closeDeckModal;\nwindow.createDeck = createDeck;\nwindow.updateDeck = updateDeck;\nwindow.confirmDeleteDeck = confirmDeleteDeck;\nwindow.deleteDeck = deleteDeck;\nwindow.selectDeckAndStudy = selectDeckAndStudy;\n"}],"isError":false,"timestamp":1772160028081}}
{"type":"message","id":"53c7679e","parentId":"f486c8ce","timestamp":"2026-02-27T02:40:44.845Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Now I can see the issue. Looking at the code:\n\n1. In `server.js`, there's a preview endpoint at `/api/review/:id/preview`:\n```javascript\napp.get('/api/review/:id/preview', (req, res) => {\n  try {\n    const card = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    if (!card) {\n      return res.status(404).json({ success: false, error: 'Card not found' });\n    }\n    \n    const previews = {};\n    for (let rating = 1; rating <= 5; rating++) {\n      const result = FSRSEngine.previewIntervals(card, rating);\n      if (result) {\n        previews[rating] = formatInterval(result.interval);\n      }\n    }\n    \n    res.json({ success: true, data: previews });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n```\n\n2. In `app.js`, the frontend calls this endpoint in `showAnswer()`:\n```javascript\nasync function showAnswer() {\n  isAnswerShown = true;\n  \n  // Fetch preview intervals from server\n  try {\n    const response = await fetch(`${API_BASE}/api/review/${currentCard.id}/preview`);\n    const result = await response.json();\n    \n    if (result.success) {\n      const previews = result.data;\n      document.getElementById('interval-1').textContent = previews[1] || '1m';\n      document.getElementById('interval-2').textContent = previews[2] || '10m';\n      // ...\n    }\n  }\n}\n```\n\n3. There's also a fallback `calculateIntervals()` function in the frontend:\n```javascript\nfunction calculateIntervals(card) {\n  let { interval, ease_factor, repetitions } = card;\n  ease_factor = ease_factor || 2.5;\n  interval = interval || 0;\n  \n  return [\n    '1m',  // Again\n    Math.max(1, Math.round(interval * 1.2)) + 'm',  // Hard\n    repetitions === 0 ? '1d' : (repetitions === 1 ? '6d' : Math.round(interval * ease_factor) + 'd'),  // Good\n    repetitions === 0 ? '4d' : Math.round(interval * ease_factor * 1.3) + 'd',  // Easy\n    repetitions === 0 ? '10d' : Math.round(interval * ease_factor * 1.5) + 'd'  // Perfect\n  ];\n}\n```\n\nThe issue is likely that `previewIntervals()` in the FSRS engine isn't being called correctly, or there's a mismatch between how the server calculates intervals and how the frontend displays them. The fallback function suggests the intervals are calculated based on repetitions, but the server-side calculation might be different.\n\nI need to check the fsrs engine implementation to understand how `previewIntervals` works and verify the calculation.","thinkingSignature":"c37b1fabc6a595ba3ff72dcc175a56529324e6885fe53732c3235ab6dd8001c9"},{"type":"text","text":"Now let me check the FSRS engine implementation:\n"},{"type":"toolCall","id":"call_function_0ha47hr026fm_1","name":"exec","arguments":{"command":"ls -la /home/one/.openclaw/skills/fsrs-memory/src/"}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M2.5","usage":{"input":12444,"output":697,"cacheRead":7789,"cacheWrite":0,"totalTokens":20930,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772160028083}}
