{"type":"message","id":"f4f4bf44","parentId":"bd9fb80b","timestamp":"2026-02-27T08:13:05.225Z","message":{"role":"toolResult","toolCallId":"call_a6d1989386464927912a2746","toolName":"read","content":[{"type":"text","text":"// server.js - Express Backend for FSRS Web UI with Multi-deck & Theme support\nconst express = require('express');\nconst cors = require('cors');\nconst path = require('path');\nconst Database = require('better-sqlite3');\n\nconst app = express();\nconst PORT = process.env.PORT || 3001;\n\n// Middleware\napp.use(cors());\napp.use(express.json());\napp.use(express.static(path.join(__dirname, 'public')));\n\n// Database setup - connect to existing cards.db\nconst DB_PATH = process.env.DB_PATH || path.join(__dirname, '..', 'data', 'cards.db');\nconst db = new Database(DB_PATH);\n\n// Import FSRS engine\nconst FSRSEngine = require('../src/fsrs');\n\n// ==================== Database Helper Functions ====================\n\n// Fix inconsistent state values in database\nfunction fixCardStates() {\n  try {\n    // Fix \"2.0\" state to \"review\" (this was a bug where State.Review = 2 was stored as string)\n    const result = db.prepare(\"UPDATE cards SET state = 'review' WHERE state = '2.0'\").run();\n    if (result.changes > 0) {\n      console.log(`Fixed ${result.changes} cards with invalid state '2.0'`);\n    }\n    \n    // Fix empty or null states to \"new\"\n    db.prepare(\"UPDATE cards SET state = 'new' WHERE state IS NULL OR state = ''\").run();\n  } catch (error) {\n    console.error('Error fixing card states:', error);\n  }\n}\n\n// Run state fix on startup\nfixCardStates();\n\n// Get current local time for database queries\nfunction getLocalNow() {\n  return new Date().toISOString();\n}\n\n// ==================== Settings API ====================\n\n// Get theme\napp.get('/api/settings/theme', (req, res) => {\n  try {\n    const theme = db.prepare(\"SELECT value FROM settings WHERE key = 'theme'\").get();\n    res.json({ success: true, data: theme ? theme.value : 'light' });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Set theme\napp.post('/api/settings/theme', (req, res) => {\n  try {\n    const { theme } = req.body;\n    if (!theme || !['light', 'dark'].includes(theme)) {\n      return res.status(400).json({ success: false, error: 'Invalid theme' });\n    }\n    db.prepare(`\n      INSERT INTO settings (key, value) VALUES ('theme', ?)\n      ON CONFLICT(key) DO UPDATE SET value = excluded.value\n    `).run(theme);\n    res.json({ success: true, data: theme });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// ==================== Deck API ====================\n\n// Get all decks\napp.get('/api/decks', (req, res) => {\n  try {\n    // Use localtime for due_date comparison to match user timezone\n    const decks = db.prepare(`\n      SELECT d.*, \n        (SELECT COUNT(*) FROM cards WHERE deck_id = d.id) as card_count,\n        (SELECT COUNT(*) FROM cards WHERE deck_id = d.id AND strftime('%s', due_date) <= strftime('%s', 'now')) as due_count\n      FROM decks d \n      ORDER BY d.id ASC\n    `).all();\n    res.json({ success: true, data: decks });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Get single deck\napp.get('/api/decks/:id', (req, res) => {\n  try {\n    const deck = db.prepare('SELECT * FROM decks WHERE id = ?').get(req.params.id);\n    if (!deck) {\n      return res.status(404).json({ success: false, error: 'Deck not found' });\n    }\n    res.json({ success: true, data: deck });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Create deck\napp.post('/api/decks', (req, res) => {\n  try {\n    const { name, description } = req.body;\n    if (!name) {\n      return res.status(400).json({ success: false, error: 'Deck name required' });\n    }\n    \n    const stmt = db.prepare('INSERT INTO decks (name, description) VALUES (?, ?)');\n    const result = stmt.run(name, description || '');\n    \n    const newDeck = db.prepare('SELECT * FROM decks WHERE id = ?').get(result.lastInsertRowid);\n    res.json({ success: true, data: newDeck });\n  } catch (error) {\n    if (error.message.includes('UNIQUE')) {\n      return res.status(400).json({ success: false, error: 'Deck name already exists' });\n    }\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Update deck\napp.put('/api/decks/:id', (req, res) => {\n  try {\n    const { name, description } = req.body;\n    const deckId = parseInt(req.params.id);\n    \n    if (deckId === 1) {\n      return res.status(400).json({ success: false, error: 'Cannot modify default deck' });\n    }\n    \n    db.prepare(`\n      UPDATE decks SET name = ?, description = ?, updated_at = datetime('now') WHERE id = ?\n    `).run(name, description || '', deckId);\n    \n    const updatedDeck = db.prepare('SELECT * FROM decks WHERE id = ?').get(deckId);\n    res.json({ success: true, data: updatedDeck });\n  } catch (error) {\n    if (error.message.includes('UNIQUE')) {\n      return res.status(400).json({ success: false, error: 'Deck name already exists' });\n    }\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Delete deck\napp.delete('/api/decks/:id', (req, res) => {\n  try {\n    const deckId = parseInt(req.params.id);\n    \n    if (deckId === 1) {\n      return res.status(400).json({ success: false, error: 'Cannot delete default deck' });\n    }\n    \n    // Move cards to default deck before deleting\n    db.prepare('UPDATE cards SET deck_id = 1 WHERE deck_id = ?').run(deckId);\n    db.prepare('DELETE FROM decks WHERE id = ?').run(deckId);\n    \n    res.json({ success: true });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// ==================== Card API ====================\n\n// Get all cards (with optional deck filter)\napp.get('/api/cards', (req, res) => {\n  try {\n    const deckId = req.query.deck ? parseInt(req.query.deck) : null;\n    let cards;\n    if (deckId) {\n      cards = db.prepare('SELECT * FROM cards WHERE deck_id = ? ORDER BY created_at DESC').all(deckId);\n    } else {\n      cards = db.prepare('SELECT * FROM cards ORDER BY created_at DESC').all();\n    }\n    res.json({ success: true, data: cards });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Get due cards (with optional deck filter)\napp.get('/api/cards/due', (req, res) => {\n  try {\n    const deckId = req.query.deck ? parseInt(req.query.deck) : null;\n    // Use localtime for consistency with deck stats\n    const now = new Date();\n    let cards;\n    if (deckId) {\n      cards = db.prepare(`\n        SELECT * FROM cards \n        WHERE deck_id = ? AND strftime('%s', due_date) <= strftime('%s', 'now')\n        ORDER BY due_date ASC\n      `).all(deckId);\n    } else {\n      cards = db.prepare(`\n        SELECT * FROM cards \n        WHERE strftime('%s', due_date) <= strftime('%s', 'now')\n        ORDER BY due_date ASC\n      `).all();\n    }\n    res.json({ success: true, data: cards });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Get single card\napp.get('/api/cards/:id', (req, res) => {\n  try {\n    const card = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    if (!card) {\n      return res.status(404).json({ success: false, error: 'Card not found' });\n    }\n    res.json({ success: true, data: card });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Add new card (with optional deck)\napp.post('/api/cards', (req, res) => {\n  try {\n    const { question, answer, deck_id } = req.body;\n    if (!question || !answer) {\n      return res.status(400).json({ success: false, error: 'Question and answer required' });\n    }\n    \n    const deckId = deck_id ? parseInt(deck_id) : 1;\n    const now = new Date();\n    const stmt = db.prepare(`\n      INSERT INTO cards (deck_id, question, answer, due_date, created_at, state)\n      VALUES (?, ?, ?, ?, ?, 'new')\n    `);\n    const result = stmt.run(deckId, question, answer, now.toISOString(), now.toISOString());\n    \n    const newCard = db.prepare('SELECT * FROM cards WHERE id = ?').get(result.lastInsertRowid);\n    res.json({ success: true, data: newCard });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Move card to different deck\napp.put('/api/cards/:id/deck', (req, res) => {\n  try {\n    const { deck_id } = req.body;\n    db.prepare('UPDATE cards SET deck_id = ? WHERE id = ?').run(deck_id, req.params.id);\n    const updatedCard = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    res.json({ success: true, data: updatedCard });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Update card (after review)\napp.put('/api/cards/:id', (req, res) => {\n  try {\n    const { due_date, interval, ease_factor, repetitions, lapses, state, last_review } = req.body;\n    const stmt = db.prepare(`\n      UPDATE cards SET\n        due_date = ?,\n        interval = ?,\n        ease_factor = ?,\n        repetitions = ?,\n        lapses = ?,\n        state = ?,\n        last_review = ?\n      WHERE id = ?\n    `);\n    stmt.run(due_date, interval, ease_factor, repetitions, lapses, state, last_review, req.params.id);\n    \n    const updatedCard = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    res.json({ success: true, data: updatedCard });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Delete card\napp.delete('/api/cards/:id', (req, res) => {\n  try {\n    db.prepare('DELETE FROM cards WHERE id = ?').run(req.params.id);\n    res.json({ success: true });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// ==================== Statistics API ====================\n\n// Get statistics (with optional deck filter)\napp.get('/api/stats', (req, res) => {\n  try {\n    const deckId = req.query.deck ? parseInt(req.query.deck) : null;\n    \n    let total, due, reviewed, newCards, learning, avgEase;\n    \n    if (deckId) {\n      total = db.prepare('SELECT COUNT(*) as count FROM cards WHERE deck_id = ?').get(deckId).count;\n      due = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE deck_id = ? AND strftime('%s', due_date) <= strftime('%s', 'now')\").get(deckId).count;\n      reviewed = db.prepare('SELECT COUNT(*) as count FROM cards WHERE deck_id = ? AND repetitions > 0').get(deckId).count;\n      // Fixed: Added parentheses around OR condition and handle both 'new' state and repetitions = 0\n      newCards = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE deck_id = ? AND (state = 'new' OR repetitions = 0)\").get(deckId).count;\n      learning = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE deck_id = ? AND (state = 'learning' OR state = 'relearning')\").get(deckId).count;\n      avgEase = db.prepare('SELECT AVG(ease_factor) as avg FROM cards WHERE deck_id = ? AND repetitions > 0').get(deckId).avg || 2.5;\n    } else {\n      total = db.prepare('SELECT COUNT(*) as count FROM cards').get().count;\n      due = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE strftime('%s', due_date) <= strftime('%s', 'now')\").get().count;\n      reviewed = db.prepare('SELECT COUNT(*) as count FROM cards WHERE repetitions > 0').get().count;\n      // Fixed: Added parentheses around OR condition\n      newCards = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE state = 'new' OR repetitions = 0\").get().count;\n      learning = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE state = 'learning' OR state = 'relearning'\").get().count;\n      avgEase = db.prepare('SELECT AVG(ease_factor) as avg FROM cards WHERE repetitions > 0').get().avg || 2.5;\n    }\n    \n    res.json({\n      success: true,\n      data: {\n        total,\n        due,\n        reviewed,\n        new: newCards,\n        learning,\n        avgEase: Math.round(avgEase * 100) / 100\n      }\n    });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// ==================== Review API ====================\n\n// Preview intervals before rating\napp.get('/api/review/:id/preview', (req, res) => {\n  try {\n    const card = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    if (!card) {\n      return res.status(404).json({ success: false, error: 'Card not found' });\n    }\n    \n    const previews = {};\n    for (let rating = 1; rating <= 5; rating++) {\n      const result = FSRSEngine.previewIntervals(card, rating);\n      if (result) {\n        previews[rating] = formatInterval(result.interval);\n      }\n    }\n    \n    res.json({ success: true, data: previews });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Review card with FSRS rating\napp.post('/api/review/:id', (req, res) => {\n  try {\n    const { rating } = req.body;\n    if (!rating || rating < 1 || rating > 5) {\n      return res.status(400).json({ success: false, error: 'Rating must be 1-5' });\n    }\n    \n    const card = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    if (!card) {\n      return res.status(404).json({ success: false, error: 'Card not found' });\n    }\n    \n    // Use FSRS engine for scheduling\n    const fsrsCard = FSRSEngine.dbToCard(card);\n    const result = FSRSEngine.repeat(fsrsCard, rating);\n    \n    if (!result) {\n      return res.status(500).json({ success: false, error: 'Failed to calculate FSRS' });\n    }\n    \n    // Update card\n    const now = new Date();\n    db.prepare(`\n      UPDATE cards SET\n        due_date = ?,\n        interval = ?,\n        ease_factor = ?,\n        repetitions = ?,\n        lapses = ?,\n        state = ?,\n        last_review = ?\n      WHERE id = ?\n    `).run(\n      result.due_date,\n      result.interval,\n      result.ease_factor,\n      result.repetitions,\n      result.lapses,\n      result.state,\n      now.toISOString(),\n      req.params.id\n    );\n    \n    const updatedCard = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    res.json({ \n      success: true, \n      data: updatedCard, \n      nextInterval: formatInterval(result.interval)\n    });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Helper function to format interval - properly handles minutes\nfunction formatInterval(days) {\n  if (days < 1) {\n    // Convert to minutes (days * 24 * 60)\n    const minutes = Math.round(days * 24 * 60);\n    if (minutes < 60) {\n      return `${minutes}m`;\n    } else {\n      // If more than 60 minutes, show hours\n      return `${Math.round(minutes / 60)}h`;\n    }\n  } else if (days < 30) {\n    return `${Math.round(days)}d`;\n  } else if (days < 365) {\n    return `${Math.round(days / 30)}mo`;\n  } else {\n    return `${Math.round(days / 365)}y`;\n  }\n}\n\n\n// ==================== APKG Import API ====================\n\nconst multer = require('multer');\nconst APKGImporter = require('../src/apkg-import');\nconst fs = require('fs');\n\n// Setup multer for file uploads\nconst UPLOAD_DIR = path.join(__dirname, 'uploads');\nif (!fs.existsSync(UPLOAD_DIR)) {\n  fs.mkdirSync(UPLOAD_DIR, { recursive: true });\n}\n\nconst storage = multer.diskStorage({\n  destination: (req, file, cb) => {\n    cb(null, UPLOAD_DIR);\n  },\n  filename: (req, file, cb) => {\n    cb(null, Date.now() + '-' + file.originalname);\n  }\n});\n\nconst upload = multer({ \n  storage,\n  fileFilter: (req, file, cb) => {\n    if (file.originalname.endsWith('.apkg')) {\n      cb(null, true);\n    } else {\n      cb(new Error('Only .apkg files are allowed'));\n    }\n  },\n  limits: {\n    fileSize: 50 * 1024 * 1024 // 50MB limit\n  }\n});\n\n// Preview APKG file\napp.post('/api/apkg/preview', upload.single('apkg'), async (req, res) => {\n  try {\n    if (!req.file) {\n      return res.status(400).json({ success: false, error: 'No file uploaded' });\n    }\n\n    const importer = new APKGImporter(db);\n    const preview = await importer.preview(req.file.path);\n\n    // Cleanup uploaded file\n    fs.unlinkSync(req.file.path);\n\n    if (!preview.success) {\n      return res.status(400).json(preview);\n    }\n\n    res.json(preview);\n  } catch (error) {\n    if (req.file && fs.existsSync(req.file.path)) {\n      fs.unlinkSync(req.file.path);\n    }\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Import APKG file\napp.post('/api/apkg/import', upload.single('apkg'), async (req, res) => {\n  try {\n    if (!req.file) {\n      return res.status(400).json({ success: false, error: 'No file uploaded' });\n    }\n\n    const { deckId } = req.body;\n    const targetDeckId = deckId ? parseInt(deckId) : 1;\n\n    const importer = new APKGImporter(db);\n    const result = await importer.import(req.file.path, targetDeckId);\n\n    // Cleanup uploaded file\n    fs.unlinkSync(req.file.path);\n\n    if (!result.success) {\n      return res.status(400).json(result);\n    }\n\n    res.json(result);\n  } catch (error) {\n    if (req.file && fs.existsSync(req.file.path)) {\n      fs.unlinkSync(req.file.path);\n    }\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Serve SPA for all other routes\napp.get('*', (req, res) => {\n  res.sendFile(path.join(__dirname, 'public', 'index.html'));\n});\n\n// Start server\napp.listen(PORT, () => {\n  console.log(`FSRS Web UI server running on http://localhost:${PORT}`);\n});\n\nmodule.exports = app;\n"}],"isError":false,"timestamp":1772179985222}}
{"type":"message","id":"210a71d7","parentId":"f4f4bf44","timestamp":"2026-02-27T08:13:07.973Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Good, I have a clear understanding of the current server.js. Now let me check the database schema and the web/public/app.js to understand the frontend structure. Then I'll start implementing Phase 3 features.\n","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"call_2c0c78a56ec94cd1b70e2959","name":"exec","arguments":{"command":"sqlite3 /home/one/.openclaw/skills/fsrs-memory/data/cards.db \".schema\""}},{"type":"toolCall","id":"call_6b97d9503a6d4e0d85521bd7","name":"read","arguments":{"path":"/home/one/.openclaw/skills/fsrs-memory/web/public/app.js","limit":200}}],"api":"openai-completions","provider":"bailian","model":"qwen3.5-plus","usage":{"input":20863,"output":189,"cacheRead":0,"cacheWrite":0,"totalTokens":21052,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772179985226}}
{"type":"message","id":"957824d4","parentId":"210a71d7","timestamp":"2026-02-27T08:13:07.996Z","message":{"role":"toolResult","toolCallId":"call_2c0c78a56ec94cd1b70e2959","toolName":"exec","content":[{"type":"text","text":"{\n  \"status\": \"error\",\n  \"tool\": \"exec\",\n  \"error\": \"/bin/bash: line 1: sqlite3: command not found\\n\\nCommand not found\"\n}"}],"details":{"status":"error","tool":"exec","error":"/bin/bash: line 1: sqlite3: command not found\n\nCommand not found"},"isError":false,"timestamp":1772179987993}}
{"type":"message","id":"7ada1e60","parentId":"957824d4","timestamp":"2026-02-27T08:13:08.005Z","message":{"role":"toolResult","toolCallId":"call_6b97d9503a6d4e0d85521bd7","toolName":"read","content":[{"type":"text","text":"// FSRS Memory Web UI v2 - Application Logic with Tailwind CSS\n\nconst API_BASE = window.location.origin;\n\n// State\nlet currentView = 'study';\nlet currentDeckId = null;\nlet dueCards = [];\nlet allCards = [];\nlet allDecks = [];\nlet currentCardIndex = 0;\nlet currentCard = null;\nlet isAnswerShown = false;\nlet currentTheme = 'light';\n\n// ==================== Initialization ====================\n\ndocument.addEventListener('DOMContentLoaded', () => {\n  initTheme();\n  initNavigation();\n  initKeyboardShortcuts();\n  loadDecks();\n  loadStats();\n  loadDueCards();\n});\n\n// ==================== Theme ====================\n\nasync function initTheme() {\n  try {\n    const response = await fetch(`${API_BASE}/api/settings/theme`);\n    const result = await response.json();\n    if (result.success) {\n      currentTheme = result.data || 'light';\n      applyTheme(currentTheme);\n    }\n  } catch (error) {\n    console.error('Failed to load theme:', error);\n  }\n}\n\nfunction applyTheme(theme) {\n  if (theme === 'dark') {\n    document.documentElement.classList.add('dark');\n  } else {\n    document.documentElement.classList.remove('dark');\n  }\n  const icon = document.getElementById('theme-icon');\n  const text = document.getElementById('theme-text');\n  if (theme === 'dark') {\n    icon.className = 'ph ph-sun text-lg';\n    text.textContent = '亮色模式';\n  } else {\n    icon.className = 'ph ph-moon text-lg';\n    text.textContent = '暗色模式';\n  }\n  currentTheme = theme;\n}\n\nasync function toggleTheme() {\n  const newTheme = currentTheme === 'light' ? 'dark' : 'light';\n  try {\n    await fetch(`${API_BASE}/api/settings/theme`, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ theme: newTheme })\n    });\n    applyTheme(newTheme);\n    showToast(`已切换到${newTheme === 'dark' ? '暗色' : '亮色'}主题`, 'success');\n  } catch (error) {\n    console.error('Failed to save theme:', error);\n    showToast('主题切换失败', 'error');\n  }\n}\n\n// ==================== Mobile Menu ====================\n\nfunction toggleMobileMenu() {\n  document.querySelector('.sidebar').classList.toggle('open');\n}\n\n// ==================== Navigation ====================\n\nfunction initNavigation() {\n  const navItems = document.querySelectorAll('.nav-item');\n  navItems.forEach(item => {\n    item.addEventListener('click', () => {\n      const view = item.dataset.view;\n      showView(view);\n      // Close mobile menu on selection\n      document.querySelector('.sidebar').classList.remove('open');\n    });\n  });\n}\n\nfunction showView(view) {\n  // Update nav\n  document.querySelectorAll('.nav-item').forEach(item => {\n    item.classList.toggle('active', item.dataset.view === view);\n  });\n  \n  // Update view\n  document.querySelectorAll('.view').forEach(v => {\n    v.style.display = v.id === `${view}-view` ? 'block' : 'none';\n  });\n  \n  currentView = view;\n  \n  // Update page title\n  const titles = {\n    study: ['今日学习', '开始你的复习之旅'],\n    cards: ['所有卡片', '管理和搜索你的卡片'],\n    decks: ['牌组管理', '创建和组织牌组'],\n    add: ['添加卡片', '创建新的记忆卡片'],\n    import: ['导入卡包', '从 Anki 导入卡包'],\n    stats: ['学习统计', '查看你的学习进度']\n  };\n  const [title, subtitle] = titles[view] || ['FSRS Memory', ''];\n  document.getElementById('page-title').textContent = title;\n  document.getElementById('page-subtitle').textContent = subtitle;\n  \n  // Load data for specific views\n  if (view === 'study') {\n    loadDueCards();\n  } else if (view === 'cards') {\n    loadAllCards();\n  } else if (view === 'decks') {\n    loadDecksGrid();\n  } else if (view === 'stats') {\n    loadStats();\n  }\n}\n\n// ==================== Deck Management ====================\n\nasync function loadDecks() {\n  try {\n    const response = await fetch(`${API_BASE}/api/decks`);\n    const result = await response.json();\n    \n    if (result.success) {\n      allDecks = result.data;\n      updateDeckSelectors();\n    }\n  } catch (error) {\n    console.error('Failed to load decks:', error);\n  }\n}\n\nfunction updateDeckSelectors() {\n  const selects = ['deck-select', 'deck-select-add', 'import-deck-select'];\n  selects.forEach(id => {\n    const select = document.getElementById(id);\n    if (!select) return;\n    \n    const isImport = id === 'import-deck-select';\n    const options = allDecks.map(deck => \n      `<option value=\"${deck.id}\">${deck.name} (${deck.due_count || 0}${isImport ? '' : ' 待复习'})</option>`\n    ).join('');\n    \n    select.innerHTML = isImport ? '<option value=\"1\">默认牌组</option>' + options : '<option value=\"\">全部牌组</option>' + options;\n  });\n  \n  if (allDecks.length > 0 && !currentDeckId) {\n    const addSelect = document.getElementById('deck-select-add');\n    if (addSelect) addSelect.value = allDecks[0].id;\n  }\n}\n\nasync function changeDeck(deckId) {\n  currentDeckId = deckId ? parseInt(deckId) : null;\n  \n  if (currentView === 'study') {\n    loadDueCards();\n  } else if (currentView === 'cards') {\n    loadAllCards();\n  } else if (currentView === 'stats') {\n    loadStats();\n  }\n}\n\nasync function loadDecksGrid() {\n  try {\n    const response = await fetch(`${API_BASE}/api/decks`);\n    const result = await response.json();\n    \n    if (result.success) {\n      renderDecksGrid(result.data);\n    }\n  } catch (error) {\n    console.error('Failed to load decks:', error);\n    showToast('加载失败', 'error');\n  }\n}\n\nfunction renderDecksGrid(decks) {\n  const container = document.getElementById('decks-grid');\n  \n  container.innerHTML = decks.map(deck => `\n    <div class=\"deck-card bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-200 dark:border-gray-700 hover:shadow-lg transition-shadow\">\n\n[763 more lines in file. Use offset=201 to continue.]"}],"isError":false,"timestamp":1772179988002}}
{"type":"message","id":"5f86150e","parentId":"7ada1e60","timestamp":"2026-02-27T08:14:05.722Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Good, I now have a good understanding of the codebase. Let me start implementing Phase 3 features. I'll create a comprehensive implementation plan and start coding.\n\nLet me first create the research document summarizing what I know about Anki media/templates/export, then proceed with the implementation.","thinkingSignature":"reasoning_content"},{"type":"text","text":"Let me start implementing Phase 3. I'll create the research summary and then implement each feature systematically.\n\n"},{"type":"toolCall","id":"call_12285a6c67ef4eb48e598f14","name":"write","arguments":{"file_path":"/home/one/.openclaw/skills/fsrs-memory/research/phase3_research.md","content":"# Phase 3 Research: Anki Media, Templates & Export\n\n## 1. 媒体文件支持\n\n### Anki 媒体存储方式\n\n**目录结构:**\n```\ncollection.media/\n├── 1234567890abcdef.jpg\n├── 1234567890abcdeg.mp3\n└── _test-file.png\n```\n\n**关键点:**\n- 媒体文件存储在 `collection.media/` 目录\n- 文件名使用哈希值（避免冲突）\n- HTML 中引用：`<img src=\"_test-file.png\">` 或 `<audio src=\"1234567890abcdef.mp3\">`\n- 以 `_` 开头的文件不会被 Anki 的媒体检查删除\n\n**APKG 中的媒体:**\n- APKG 是 ZIP 格式\n- 包含 `collection.anki2` (SQLite 数据库) 和 `media` 文件\n- `media` 文件是 JSON：`{\"1\": \"filename.jpg\", \"2\": \"audio.mp3\"}`\n- Notes 表中的字段引用媒体：`<img src=\"1\">` 或 `<img src=\"filename.jpg\">`\n\n**支持的媒体格式:**\n- 图片：jpg, jpeg, png, gif, webp, svg\n- 音频：mp3, wav, ogg, m4a\n- 视频：mp4, webm, mov（Anki 支持但浏览器有限制）\n\n### 实现方案\n\n**存储路径:** `web/media/`\n\n**数据库表:**\n```sql\nCREATE TABLE IF NOT EXISTS media_files (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  filename TEXT UNIQUE NOT NULL,\n  original_name TEXT NOT NULL,\n  mime_type TEXT NOT NULL,\n  file_size INTEGER NOT NULL,\n  file_hash TEXT,\n  uploaded_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  card_id INTEGER,\n  FOREIGN KEY (card_id) REFERENCES cards(id) ON DELETE SET NULL\n);\n```\n\n**API 端点:**\n- `POST /api/media/upload` - 上传文件（multipart/form-data）\n- `GET /api/media` - 获取媒体文件列表\n- `GET /api/media/:id` - 获取单个文件信息\n- `DELETE /api/media/:id` - 删除文件\n- `GET /media/:filename` - 静态文件服务\n\n---\n\n## 2. 卡片模板系统\n\n### Anki 模板结构\n\n**Note Type (模型):**\n```json\n{\n  \"id\": 1234567890,\n  \"name\": \"基础卡\",\n  \"type\": 0,  // 0=标准，1=填空\n  \"flds\": [\n    {\"name\": \"Front\", \"ord\": 0},\n    {\"name\": \"Back\", \"ord\": 1}\n  ],\n  \"tmpls\": [\n    {\n      \"name\": \"Card 1\",\n      \"ord\": 0,\n      \"qfmt\": \"{{Front}}\",\n      \"afmt\": \"{{FrontSide}}<hr id=\\\"answer\\\">{{Back}}\",\n      \"bfmt\": \"\",\n      \"bqfmt\": \"\",\n      \"css\": \".card { font-family: arial; font-size: 20px; }\"\n    }\n  ]\n}\n```\n\n**字段替换语法:**\n- `{{Front}}` - 替换字段内容\n- `{{FrontSide}}` - 替换为正面内容（用于背面）\n- `{{type:Field}}` - 输入检查\n- `{{#Field}}...{{/Field}}` - 条件显示（如果字段非空）\n\n**预定义模板类型:**\n1. **基础卡 (Basic)**: 正面 → 背面\n2. **反向卡 (Basic + Reverse)**: 正面 → 背面 + 背面 → 正面\n3. **填空卡 (Cloze)**: `{{c1::answer}}` 语法\n\n### 实现方案\n\n**数据库表:**\n```sql\nCREATE TABLE IF NOT EXISTS card_templates (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  name TEXT UNIQUE NOT NULL,\n  type TEXT NOT NULL,  -- 'basic', 'reverse', 'cloze'\n  front_template TEXT NOT NULL,\n  back_template TEXT NOT NULL,\n  css TEXT DEFAULT '',\n  is_default INTEGER DEFAULT 0,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP\n);\n\n-- 牌组模板关联\nCREATE TABLE IF NOT EXISTS deck_templates (\n  deck_id INTEGER NOT NULL,\n  template_id INTEGER NOT NULL,\n  PRIMARY KEY (deck_id, template_id),\n  FOREIGN KEY (deck_id) REFERENCES decks(id) ON DELETE CASCADE,\n  FOREIGN KEY (template_id) REFERENCES card_templates(id) ON DELETE CASCADE\n);\n```\n\n**API 端点:**\n- `GET /api/templates` - 获取所有模板\n- `POST /api/templates` - 创建模板\n- `PUT /api/templates/:id` - 更新模板\n- `DELETE /api/templates/:id` - 删除模板\n- `POST /api/templates/:id/preview` - 预览模板渲染\n- `PUT /api/decks/:id/template` - 设置牌组模板\n\n---\n\n## 3. 导出功能\n\n### APKG 格式\n\n**结构:**\n```\nexport.apkg (ZIP)\n├── collection.anki2  (SQLite 数据库)\n└── media            (JSON 文件，映射媒体 ID 到文件名)\n```\n\n**SQLite 表结构:**\n- `notes`: id, guid, mid, mod, usn, tags, flds (字段内容，用 \\x1f 分隔)\n- `cards`: id, nid, did, ord, mod, usn, type, queue, due, ivl, factor, reps, lapses, left\n- `decks`: id, name, desc\n- `col`: 包含模型、牌组配置等\n\n**导出库选项:**\n- Python: `genanki` (成熟，功能完整)\n- Node.js: `node-apkg` (较新，功能有限)\n- 手动实现：使用 `jszip` + `better-sqlite3`\n\n### CSV 格式\n\n```csv\nid,deck,question,answer,created_at,tags\n1,默认牌组，\"什么是 FSRS?\",\"Free Spaced Repetition Scheduler\",2024-01-01,\n2,英语，\"Hello\",\"你好\",2024-01-02,vocab\n```\n\n**注意事项:**\n- 使用 RFC 4180 标准\n- 字段包含逗号/换行时需要引号包裹\n- 引号需要转义（\"\" 表示 \"）\n\n### JSON 格式\n\n```json\n{\n  \"exported_at\": \"2024-01-01T00:00:00Z\",\n  \"version\": \"1.0\",\n  \"decks\": [...],\n  \"cards\": [...],\n  \"templates\": [...]\n}\n```\n\n### 实现方案\n\n**API 端点:**\n- `POST /api/export` - 创建导出任务\n  - Body: `{ format: \"apkg\"|\"csv\"|\"json\", deck_id?: number }`\n- `GET /api/export/:id/status` - 获取导出状态\n- `GET /api/export/:id/download` - 下载导出文件\n\n**依赖:**\n```json\n{\n  \"jszip\": \"^3.10.1\",\n  \"better-sqlite3\": \"^9.0.0\"\n}\n```\n\n---\n\n## 4. 学习统计图表\n\n### Chart.js 集成\n\n**CDN 引入:**\n```html\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js\"></script>\n```\n\n### 图表类型\n\n**1. 每日学习量趋势图 (Line Chart)**\n- X 轴：日期（最近 30 天）\n- Y 轴：学习卡片数量\n- 数据源：按日期分组的学习记录\n\n**2. 牌组进度饼图 (Doughnut Chart)**\n- 每个扇区：一个牌组\n- 大小：牌组卡片数量占比\n- 颜色：不同牌组不同颜色\n\n**3. 记忆保持率曲线 (Line Chart)**\n- X 轴：间隔天数\n- Y 轴：保持率（%）\n- 基于 FSRS 算法计算\n\n### 数据库扩展\n\n```sql\n-- 学习记录表（用于统计）\nCREATE TABLE IF NOT EXISTS review_logs (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  card_id INTEGER NOT NULL,\n  rating INTEGER NOT NULL,  -- 1-5\n  interval REAL NOT NULL,\n  ease_factor REAL NOT NULL,\n  reviewed_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  FOREIGN KEY (card_id) REFERENCES cards(id) ON DELETE CASCADE\n);\n\n-- 索引优化查询\nCREATE INDEX IF NOT EXISTS idx_review_logs_date ON review_logs(date(reviewed_at));\nCREATE INDEX IF NOT EXISTS idx_review_logs_card ON review_logs(card_id);\n```\n\n### API 端点\n\n- `GET /api/stats/daily` - 每日学习数据（最近 30 天）\n- `GET /api/stats/decks` - 牌组分布数据\n- `GET /api/stats/retention` - 记忆保持率数据\n- `GET /api/stats/summary` - 综合统计数据\n\n---\n\n## 技术难点与解决方案\n\n### 1. 媒体文件处理\n- **难点**: 文件上传安全、大文件处理、重复文件检测\n- **方案**: \n  - 使用 multer 处理上传\n  - 计算文件哈希避免重复\n  - 限制文件大小和类型\n\n### 2. APKG 导出兼容性\n- **难点**: Anki APKG 格式复杂，需要完全兼容\n- **方案**: \n  - 使用 jszip 创建 ZIP\n  - 创建兼容的 SQLite 结构\n  - 参考 Anki 源码和 genanki 实现\n\n### 3. 模板渲染\n- **难点**: 支持 Anki 语法的模板引擎\n- **方案**: \n  - 实现简单的模板解析器\n  - 支持 `{{Field}}`, `{{#Field}}`, `{{/Field}}`\n  - CSS 隔离（每个模板独立样式）\n\n### 4. 性能优化\n- **难点**: 大量卡片的导出和统计\n- **方案**: \n  - 异步处理（任务队列）\n  - 数据库索引优化\n  - 分页加载\n\n---\n\n## 参考资源\n\n- [Anki APKG 格式文档](https://docs.ankiweb.net/exporting.html)\n- [genanki GitHub](https://github.com/kerrickstaley/genanki)\n- [Chart.js 文档](https://www.chartjs.org/docs/latest/)\n- [Multer GitHub](https://github.com/expressjs/multer)\n"}}],"api":"openai-completions","provider":"bailian","model":"qwen3.5-plus","usage":{"input":22632,"output":2652,"cacheRead":0,"cacheWrite":0,"totalTokens":25284,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772179988006}}
