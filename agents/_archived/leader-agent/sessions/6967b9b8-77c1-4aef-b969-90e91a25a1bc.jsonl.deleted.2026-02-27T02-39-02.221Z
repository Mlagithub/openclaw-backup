const Database = require('better-sqlite3');\nconst db = new Database('./data/cards.db');\n\n// Create a test card that's due in the past (clearly due)\ndb.prepare(\\\"INSERT INTO cards (deck_id, question, answer, due_date, state, repetitions) VALUES (1, '测试卡1', '答案1', '2026-02-26 10:00:00', 'review', 1)\\\").run();\n\nconsole.log('Created test card 1 (due yesterday)');\n\n// Query deck stats\nconst decks = db.prepare(\\`\n  SELECT d.*, \n    (SELECT COUNT(*) FROM cards WHERE deck_id = d.id) as card_count,\n    (SELECT COUNT(*) FROM cards WHERE deck_id = d.id AND due_date <= datetime('now', 'localtime')) as due_count\n  FROM decks d \n  WHERE d.id = 1\n\\`).get();\n\nconsole.log('Deck 1:', {name: decks.name, card_count: decks.card_count, due_count: decks.due_count});\n\n// Query due cards\nconst dueCards = db.prepare(\\\"SELECT * FROM cards WHERE due_date <= datetime('now', 'localtime')\\\").all();\nconsole.log('Due cards:', dueCards.length);\n\n// Clean up\ndb.prepare('DELETE FROM cards WHERE question = ?').run('测试卡1');\nconsole.log('Test card deleted');\n\""}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M2.5","usage":{"input":56482,"output":668,"cacheRead":7853,"cacheWrite":0,"totalTokens":65003,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772157100542}}
