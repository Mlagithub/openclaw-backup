learning'\").get().count;\n      avgEase = db.prepare('SELECT AVG(ease_factor) as avg FROM cards WHERE repetitions > 0').get().avg || 2.5;\n    }\n    \n    res.json({\n      success: true,\n      data: {\n        total,\n\n[116 more lines in file. Use offset=330 to continue.]"}],"isError":false,"timestamp":1772156718708}}
