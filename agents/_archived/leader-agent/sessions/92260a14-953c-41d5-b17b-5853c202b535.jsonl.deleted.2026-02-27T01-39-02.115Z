{"type":"message","id":"6646fd85","parentId":"954da5ac","timestamp":"2026-02-27T00:40:58.881Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"现在更新 server.js 来使用新的 storage 和支持多牌组、主题：","thinkingSignature":"d309307e55495680cb230eeb61f0088c71f78329f050810974638a704550d570"},{"type":"text","text":"现在更新 server.js 来支持所有新功能：\n"},{"type":"toolCall","id":"call_function_yvgb5x6mzvjj_1","name":"write","arguments":{"content":"// server.js - Express Backend for FSRS Web UI with Multi-deck & Theme support\nconst express = require('express');\nconst cors = require('cors');\nconst path = require('path');\nconst Database = require('better-sqlite3');\n\nconst app = express();\nconst PORT = process.env.PORT || 3001;\n\n// Middleware\napp.use(cors());\napp.use(express.json());\napp.use(express.static(path.join(__dirname, 'public')));\n\n// Database setup - connect to existing cards.db\nconst DB_PATH = process.env.DB_PATH || path.join(__dirname, '..', 'data', 'cards.db');\nconst db = new Database(DB_PATH);\n\n// Import FSRS engine\nconst FSRSEngine = require('../src/fsrs');\n\n// ==================== Settings API ====================\n\n// Get theme\napp.get('/api/settings/theme', (req, res) => {\n  try {\n    const theme = db.prepare(\"SELECT value FROM settings WHERE key = 'theme'\").get();\n    res.json({ success: true, data: theme ? theme.value : 'light' });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Set theme\napp.post('/api/settings/theme', (req, res) => {\n  try {\n    const { theme } = req.body;\n    if (!theme || !['light', 'dark'].includes(theme)) {\n      return res.status(400).json({ success: false, error: 'Invalid theme' });\n    }\n    db.prepare(`\n      INSERT INTO settings (key, value) VALUES ('theme', ?)\n      ON CONFLICT(key) DO UPDATE SET value = excluded.value\n    `).run(theme);\n    res.json({ success: true, data: theme });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// ==================== Deck API ====================\n\n// Get all decks\napp.get('/api/decks', (req, res) => {\n  try {\n    const decks = db.prepare(`\n      SELECT d.*, \n        (SELECT COUNT(*) FROM cards WHERE deck_id = d.id) as card_count,\n        (SELECT COUNT(*) FROM cards WHERE deck_id = d.id AND due_date <= datetime('now')) as due_count\n      FROM decks d \n      ORDER BY d.id ASC\n    `).all();\n    res.json({ success: true, data: decks });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Get single deck\napp.get('/api/decks/:id', (req, res) => {\n  try {\n    const deck = db.prepare('SELECT * FROM decks WHERE id = ?').get(req.params.id);\n    if (!deck) {\n      return res.status(404).json({ success: false, error: 'Deck not found' });\n    }\n    res.json({ success: true, data: deck });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Create deck\napp.post('/api/decks', (req, res) => {\n  try {\n    const { name, description } = req.body;\n    if (!name) {\n      return res.status(400).json({ success: false, error: 'Deck name required' });\n    }\n    \n    const stmt = db.prepare('INSERT INTO decks (name, description) VALUES (?, ?)');\n    const result = stmt.run(name, description || '');\n    \n    const newDeck = db.prepare('SELECT * FROM decks WHERE id = ?').get(result.lastInsertRowid);\n    res.json({ success: true, data: newDeck });\n  } catch (error) {\n    if (error.message.includes('UNIQUE')) {\n      return res.status(400).json({ success: false, error: 'Deck name already exists' });\n    }\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Update deck\napp.put('/api/decks/:id', (req, res) => {\n  try {\n    const { name, description } = req.body;\n    const deckId = parseInt(req.params.id);\n    \n    if (deckId === 1) {\n      return res.status(400).json({ success: false, error: 'Cannot modify default deck' });\n    }\n    \n    db.prepare(`\n      UPDATE decks SET name = ?, description = ?, updated_at = datetime('now') WHERE id = ?\n    `).run(name, description || '', deckId);\n    \n    const updatedDeck = db.prepare('SELECT * FROM decks WHERE id = ?').get(deckId);\n    res.json({ success: true, data: updatedDeck });\n  } catch (error) {\n    if (error.message.includes('UNIQUE')) {\n      return res.status(400).json({ success: false, error: 'Deck name already exists' });\n    }\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Delete deck\napp.delete('/api/decks/:id', (req, res) => {\n  try {\n    const deckId = parseInt(req.params.id);\n    \n    if (deckId === 1) {\n      return res.status(400).json({ success: false, error: 'Cannot delete default deck' });\n    }\n    \n    // Move cards to default deck before deleting\n    db.prepare('UPDATE cards SET deck_id = 1 WHERE deck_id = ?').run(deckId);\n    db.prepare('DELETE FROM decks WHERE id = ?').run(deckId);\n    \n    res.json({ success: true });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// ==================== Card API ====================\n\n// Get all cards (with optional deck filter)\napp.get('/api/cards', (req, res) => {\n  try {\n    const deckId = req.query.deck ? parseInt(req.query.deck) : null;\n    let cards;\n    if (deckId) {\n      cards = db.prepare('SELECT * FROM cards WHERE deck_id = ? ORDER BY created_at DESC').all(deckId);\n    } else {\n      cards = db.prepare('SELECT * FROM cards ORDER BY created_at DESC').all();\n    }\n    res.json({ success: true, data: cards });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Get due cards (with optional deck filter)\napp.get('/api/cards/due', (req, res) => {\n  try {\n    const deckId = req.query.deck ? parseInt(req.query.deck) : null;\n    const now = new Date().toISOString();\n    let cards;\n    if (deckId) {\n      cards = db.prepare(`\n        SELECT * FROM cards \n        WHERE deck_id = ? AND due_date <= ? \n        ORDER BY due_date ASC\n      `).all(deckId, now);\n    } else {\n      cards = db.prepare(`\n        SELECT * FROM cards \n        WHERE due_date <= ? \n        ORDER BY due_date ASC\n      `).all(now);\n    }\n    res.json({ success: true, data: cards });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Get single card\napp.get('/api/cards/:id', (req, res) => {\n  try {\n    const card = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    if (!card) {\n      return res.status(404).json({ success: false, error: 'Card not found' });\n    }\n    res.json({ success: true, data: card });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Add new card (with optional deck)\napp.post('/api/cards', (req, res) => {\n  try {\n    const { question, answer, deck_id } = req.body;\n    if (!question || !answer) {\n      return res.status(400).json({ success: false, error: 'Question and answer required' });\n    }\n    \n    const deckId = deck_id ? parseInt(deck_id) : 1;\n    const now = new Date();\n    const stmt = db.prepare(`\n      INSERT INTO cards (deck_id, question, answer, due_date, created_at)\n      VALUES (?, ?, ?, ?, ?)\n    `);\n    const result = stmt.run(deckId, question, answer, now.toISOString(), now.toISOString());\n    \n    const newCard = db.prepare('SELECT * FROM cards WHERE id = ?').get(result.lastInsertRowid);\n    res.json({ success: true, data: newCard });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Move card to different deck\napp.put('/api/cards/:id/deck', (req, res) => {\n  try {\n    const { deck_id } = req.body;\n    db.prepare('UPDATE cards SET deck_id = ? WHERE id = ?').run(deck_id, req.params.id);\n    const updatedCard = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    res.json({ success: true, data: updatedCard });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Update card (after review)\napp.put('/api/cards/:id', (req, res) => {\n  try {\n    const { due_date, interval, ease_factor, repetitions, lapses, state, last_review } = req.body;\n    const stmt = db.prepare(`\n      UPDATE cards SET\n        due_date = ?,\n        interval = ?,\n        ease_factor = ?,\n        repetitions = ?,\n        lapses = ?,\n        state = ?,\n        last_review = ?\n      WHERE id = ?\n    `);\n    stmt.run(due_date, interval, ease_factor, repetitions, lapses, state, last_review, req.params.id);\n    \n    const updatedCard = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    res.json({ success: true, data: updatedCard });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Delete card\napp.delete('/api/cards/:id', (req, res) => {\n  try {\n    db.prepare('DELETE FROM cards WHERE id = ?').run(req.params.id);\n    res.json({ success: true });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// ==================== Statistics API ====================\n\n// Get statistics (with optional deck filter)\napp.get('/api/stats', (req, res) => {\n  try {\n    const deckId = req.query.deck ? parseInt(req.query.deck) : null;\n    const now = new Date().toISOString();\n    \n    let total, due, reviewed, newCards, learning, avgEase;\n    \n    if (deckId) {\n      total = db.prepare('SELECT COUNT(*) as count FROM cards WHERE deck_id = ?').get(deckId).count;\n      due = db.prepare('SELECT COUNT(*) as count FROM cards WHERE deck_id = ? AND due_date <= ?').get(deckId, now).count;\n      reviewed = db.prepare('SELECT COUNT(*) as count FROM cards WHERE deck_id = ? AND repetitions > 0').get(deckId).count;\n      newCards = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE deck_id = ? AND (state = 'new' OR repetitions = 0)\").get(deckId).count;\n      learning = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE deck_id = ? AND (state = 'learning' OR state = 'relearning')\").get(deckId).count;\n      avgEase = db.prepare('SELECT AVG(ease_factor) as avg FROM cards WHERE deck_id = ? AND repetitions > 0').get(deckId).avg || 2.5;\n    } else {\n      total = db.prepare('SELECT COUNT(*) as count FROM cards').get().count;\n      due = db.prepare('SELECT COUNT(*) as count FROM cards WHERE due_date <= ?').get(now).count;\n      reviewed = db.prepare('SELECT COUNT(*) as count FROM cards WHERE repetitions > 0').get().count;\n      newCards = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE state = 'new' OR repetitions = 0\").get().count;\n      learning = db.prepare(\"SELECT COUNT(*) as count FROM cards WHERE state = 'learning' OR state = 'relearning'\").get().count;\n      avgEase = db.prepare('SELECT AVG(ease_factor) as avg FROM cards WHERE repetitions > 0').get().avg || 2.5;\n    }\n    \n    res.json({\n      success: true,\n      data: {\n        total,\n        due,\n        reviewed,\n        new: newCards,\n        learning,\n        avgEase: Math.round(avgEase * 100) / 100\n      }\n    });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// ==================== Review API ====================\n\n// Preview intervals before rating\napp.get('/api/review/:id/preview', (req, res) => {\n  try {\n    const card = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    if (!card) {\n      return res.status(404).json({ success: false, error: 'Card not found' });\n    }\n    \n    const previews = {};\n    for (let rating = 1; rating <= 5; rating++) {\n      const result = FSRSEngine.previewIntervals(card, rating);\n      if (result) {\n        previews[rating] = formatInterval(result.interval);\n      }\n    }\n    \n    res.json({ success: true, data: previews });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Review card with FSRS rating\napp.post('/api/review/:id', (req, res) => {\n  try {\n    const { rating } = req.body;\n    if (!rating || rating < 1 || rating > 5) {\n      return res.status(400).json({ success: false, error: 'Rating must be 1-5' });\n    }\n    \n    const card = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    if (!card) {\n      return res.status(404).json({ success: false, error: 'Card not found' });\n    }\n    \n    // Use FSRS engine for scheduling\n    const fsrsCard = FSRSEngine.dbToCard(card);\n    const result = FSRSEngine.repeat(fsrsCard, rating);\n    \n    if (!result) {\n      return res.status(500).json({ success: false, error: 'Failed to calculate FSRS' });\n    }\n    \n    // Update card\n    const now = new Date();\n    db.prepare(`\n      UPDATE cards SET\n        due_date = ?,\n        interval = ?,\n        ease_factor = ?,\n        repetitions = ?,\n        lapses = ?,\n        state = ?,\n        last_review = ?\n      WHERE id = ?\n    `).run(\n      result.due_date,\n      result.interval,\n      result.ease_factor,\n      result.repetitions,\n      result.lapses,\n      result.state,\n      now.toISOString(),\n      req.params.id\n    );\n    \n    const updatedCard = db.prepare('SELECT * FROM cards WHERE id = ?').get(req.params.id);\n    res.json({ \n      success: true, \n      data: updatedCard, \n      nextInterval: formatInterval(result.interval)\n    });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// Helper function to format interval\nfunction formatInterval(days) {\n  if (days < 1) {\n    return `${Math.round(days * 24)}m`;\n  } else if (days < 30) {\n    return `${Math.round(days)}d`;\n  } else if (days < 365) {\n    return `${Math.round(days / 30)}mo`;\n  } else {\n    return `${Math.round(days / 365)}y`;\n  }\n}\n\n// Serve SPA for all other routes\napp.get('*', (req, res) => {\n  res.sendFile(path.join(__dirname, 'public', 'index.html'));\n});\n\n// Start server\napp.listen(PORT, () => {\n  console.log(`FSRS Web UI server running on http://localhost:${PORT}`);\n});\n\nmodule.exports = app;\n","file_path":"/home/one/.openclaw/skills/fsrs-memory/web/server.js"}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M2.5","usage":{"input":20034,"output":3654,"cacheRead":9100,"cacheWrite":0,"totalTokens":32788,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772152809119}}
{"type":"message","id":"4cc05ceb","parentId":"6646fd85","timestamp":"2026-02-27T00:40:58.905Z","message":{"role":"toolResult","toolCallId":"call_function_yvgb5x6mzvjj_1","toolName":"write","content":[{"type":"text","text":"Successfully wrote 13527 bytes to /home/one/.openclaw/skills/fsrs-memory/web/server.js"}],"isError":false,"timestamp":1772152858902}}
{"type":"message","id":"052a6e7d","parentId":"4cc05ceb","timestamp":"2026-02-27T00:41:00.976Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"现在我需要更新前端来支持多牌组管理和主题切换。让我先查看 styles.css：","thinkingSignature":"8c57fa3a2edc0d2920912c94fc93dd39f5f99b74a345f8f251f0147516030059"},{"type":"toolCall","id":"call_function_7n96s3l9shoi_1","name":"read","arguments":{"file_path":"/home/one/.openclaw/skills/fsrs-memory/web/public/styles.css"}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M2.5","usage":{"input":23727,"output":63,"cacheRead":9100,"cacheWrite":0,"totalTokens":32890,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772152858905}}
{"type":"message","id":"3e5dbe47","parentId":"052a6e7d","timestamp":"2026-02-27T00:41:00.993Z","message":{"role":"toolResult","toolCallId":"call_function_7n96s3l9shoi_1","toolName":"read","content":[{"type":"text","text":"/* FSRS Memory Web UI - Styles */\n\n/* CSS Variables */\n:root {\n  --primary: #6366f1;\n  --primary-dark: #4f46e5;\n  --primary-light: #818cf8;\n  --secondary: #64748b;\n  --success: #22c55e;\n  --warning: #f59e0b;\n  --danger: #ef4444;\n  --bg-dark: #0f172a;\n  --bg-card: #1e293b;\n  --bg-hover: #334155;\n  --text-primary: #f8fafc;\n  --text-secondary: #94a3b8;\n  --text-muted: #64748b;\n  --border: #334155;\n  --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);\n  --radius: 12px;\n  --radius-sm: 8px;\n}\n\n/* Reset & Base */\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nbody {\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;\n  background: var(--bg-dark);\n  color: var(--text-primary);\n  min-height: 100vh;\n}\n\n/* App Layout */\n#app {\n  display: flex;\n  min-height: 100vh;\n}\n\n/* Sidebar */\n.sidebar {\n  width: 260px;\n  background: var(--bg-card);\n  border-right: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;\n  position: fixed;\n  height: 100vh;\n  z-index: 100;\n}\n\n.logo {\n  padding: 24px 20px;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  border-bottom: 1px solid var(--border);\n}\n\n.logo-icon {\n  font-size: 28px;\n}\n\n.logo-text {\n  font-size: 18px;\n  font-weight: 600;\n  background: linear-gradient(135deg, var(--primary-light), var(--primary));\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n\n.nav-menu {\n  padding: 16px 12px;\n  flex: 1;\n}\n\n.nav-item {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  width: 100%;\n  padding: 12px 16px;\n  background: transparent;\n  border: none;\n  border-radius: var(--radius-sm);\n  color: var(--text-secondary);\n  font-size: 15px;\n  cursor: pointer;\n  transition: all 0.2s;\n  text-align: left;\n}\n\n.nav-item:hover {\n  background: var(--bg-hover);\n  color: var(--text-primary);\n}\n\n.nav-item.active {\n  background: var(--primary);\n  color: white;\n}\n\n.nav-icon {\n  font-size: 18px;\n}\n\n.badge {\n  margin-left: auto;\n  background: var(--danger);\n  color: white;\n  padding: 2px 8px;\n  border-radius: 12px;\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.nav-item.active .badge {\n  background: white;\n  color: var(--primary);\n}\n\n.sidebar-stats {\n  padding: 20px;\n  border-top: 1px solid var(--border);\n  display: flex;\n  gap: 16px;\n}\n\n.sidebar-stats .stat-item {\n  flex: 1;\n  text-align: center;\n}\n\n.stat-value {\n  display: block;\n  font-size: 24px;\n  font-weight: 700;\n  color: var(--primary-light);\n}\n\n.stat-label {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n/* Main Content */\n.main-content {\n  flex: 1;\n  margin-left: 260px;\n  padding: 32px;\n  min-height: 100vh;\n}\n\n/* Views */\n.view {\n  display: none;\n  animation: fadeIn 0.3s ease;\n}\n\n.view.active {\n  display: block;\n}\n\n@keyframes fadeIn {\n  from { opacity: 0; transform: translateY(10px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n.view-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 24px;\n}\n\n.view-header h1 {\n  font-size: 28px;\n  font-weight: 600;\n}\n\n/* Study View */\n.study-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 32px;\n}\n\n.study-header h1 {\n  font-size: 32px;\n  font-weight: 700;\n}\n\n.study-progress {\n  background: var(--bg-card);\n  padding: 12px 24px;\n  border-radius: var(--radius);\n  font-size: 16px;\n  font-weight: 600;\n}\n\n.empty-state {\n  text-align: center;\n  padding: 80px 40px;\n  background: var(--bg-card);\n  border-radius: var(--radius);\n}\n\n.empty-icon {\n  font-size: 64px;\n  margin-bottom: 24px;\n}\n\n.empty-state h2 {\n  font-size: 28px;\n  margin-bottom: 12px;\n}\n\n.empty-state p {\n  color: var(--text-secondary);\n  margin-bottom: 24px;\n}\n\n/* Card Area */\n.card-area {\n  max-width: 700px;\n  margin: 0 auto;\n}\n\n.card {\n  background: var(--bg-card);\n  border-radius: var(--radius);\n  overflow: hidden;\n  box-shadow: var(--shadow);\n}\n\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  padding: 16px 20px;\n  background: rgba(0, 0, 0, 0.2);\n  font-size: 14px;\n}\n\n.card-id {\n  color: var(--text-muted);\n}\n\n.card-state {\n  padding: 4px 12px;\n  border-radius: 20px;\n  font-size: 12px;\n  font-weight: 600;\n  text-transform: uppercase;\n}\n\n.card-state.new { background: #3498db; color: white; }\n.card-state.learning { background: #f39c12; color: white; }\n.card-state.review { background: #27ae60; color: white; }\n\n.card-content {\n  padding: 40px;\n  min-height: 200px;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n}\n\n.card-label {\n  font-size: 12px;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  margin-bottom: 16px;\n}\n\n.card-text {\n  font-size: 24px;\n  line-height: 1.6;\n  text-align: center;\n  white-space: pre-wrap;\n}\n\n.card-footer {\n  padding: 20px;\n  border-top: 1px solid var(--border);\n  text-align: center;\n}\n\n/* Rating Buttons */\n.rating-buttons {\n  display: flex;\n  gap: 12px;\n  margin-top: 24px;\n}\n\n.rating-btn {\n  flex: 1;\n  padding: 16px 12px;\n  border: none;\n  border-radius: var(--radius-sm);\n  cursor: pointer;\n  transition: all 0.2s;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 8px;\n}\n\n.rating-btn:hover {\n  transform: translateY(-2px);\n}\n\n.rating-label {\n  font-size: 14px;\n  font-weight: 600;\n  color: white;\n}\n\n.rating-interval {\n  font-size: 12px;\n  color: rgba(255, 255, 255, 0.8);\n}\n\n.rating-again { background: #ef4444; }\n.rating-hard { background: #f59e0b; }\n.rating-good { background: #22c55e; }\n.rating-easy { background: #3b82f6; }\n.rating-perfect { background: #8b5cf6; }\n\n/* Buttons */\n.btn {\n  padding: 12px 24px;\n  border: none;\n  border-radius: var(--radius-sm);\n  font-size: 15px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.btn-primary {\n  background: var(--primary);\n  color: white;\n}\n\n.btn-primary:hover {\n  background: var(--primary-dark);\n}\n\n.btn-secondary {\n  background: var(--bg-hover);\n  color: var(--text-primary);\n}\n\n.btn-secondary:hover {\n  background: var(--border);\n}\n\n.btn-danger {\n  background: var(--danger);\n  color: white;\n}\n\n.btn-hint {\n  background: var(--bg-hover);\n  color: var(--text-secondary);\n  font-size: 14px;\n  padding: 10px 32px;\n}\n\n.btn-hint:hover {\n  background: var(--border);\n  color: var(--text-primary);\n}\n\n.btn-large {\n  padding: 16px 48px;\n  font-size: 16px;\n}\n\n/* Search Box */\n.search-box input {\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-sm);\n  padding: 12px 16px;\n  color: var(--text-primary);\n  font-size: 15px;\n  width: 300px;\n}\n\n.search-box input:focus {\n  outline: none;\n  border-color: var(--primary);\n}\n\n/* Cards List */\n.cards-list {\n  display: grid;\n  gap: 16px;\n}\n\n.card-item {\n  background: var(--bg-card);\n  border-radius: var(--radius);\n  padding: 20px;\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  transition: all 0.2s;\n}\n\n.card-item:hover {\n  background: var(--bg-hover);\n}\n\n.card-item-content {\n  flex: 1;\n  min-width: 0;\n}\n\n.card-item-header {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 8px;\n}\n\n.card-item-id {\n  color: var(--text-muted);\n  font-size: 14px;\n}\n\n.card-item-state {\n  padding: 2px 8px;\n  border-radius: 10px;\n  font-size: 11px;\n}\n\n.card-item-question {\n  font-size: 16px;\n  font-weight: 500;\n  margin-bottom: 8px;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.card-item-answer {\n  font-size: 14px;\n  color: var(--text-secondary);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.card-item-meta {\n  display: flex;\n  gap: 16px;\n  margin-top: 12px;\n  font-size: 13px;\n  color: var(--text-muted);\n}\n\n.card-item-actions {\n  display: flex;\n  gap: 8px;\n}\n\n.btn-icon {\n  width: 36px;\n  height: 36px;\n  padding  display: flex;\n  align-items: center: 0;\n;\n  justify-content: center;\n  border-radius: var(--radius-sm);\n  background: transparent;\n  border: 1px solid var(--border);\n  color: var(--text-secondary);\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.btn-icon:hover {\n  background: var(--bg-hover);\n  color: var(--text-primary);\n}\n\n.btn-icon.danger:hover {\n  background: var(--danger);\n  border-color: var(--danger);\n  color: white;\n}\n\n/* Add Form */\n.add-form {\n  max-width: 600px;\n}\n\n.form-group {\n  margin-bottom: 24px;\n}\n\n.form-group label {\n  display: block;\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--text-secondary);\n  margin-bottom: 8px;\n}\n\n.form-group textarea {\n  width: 100%;\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-sm);\n  padding: 16px;\n  color: var(--text-primary);\n  font-size: 15px;\n  resize: vertical;\n  font-family: inherit;\n}\n\n.form-group textarea:focus {\n  outline: none;\n  border-color: var(--primary);\n}\n\n.quick-add {\n  margin-top: 40px;\n  padding-top: 40px;\n  border-top: 1px solid var(--border);\n}\n\n.quick-add h3 {\n  font-size: 16px;\n  margin-bottom: 16px;\n  color: var(--text-secondary);\n}\n\n/* Stats */\n.stats-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 20px;\n  margin-bottom: 40px;\n}\n\n.stat-card {\n  background: var(--bg-card);\n  border-radius: var(--radius);\n  padding: 24px;\n  text-align: center;\n  transition: all 0.2s;\n}\n\n.stat-card:hover {\n  transform: translateY(-4px);\n}\n\n.stat-card .stat-icon {\n  font-size: 32px;\n  margin-bottom: 12px;\n}\n\n.stat-card .stat-number {\n  font-size: 40px;\n  font-weight: 700;\n  color: var(--primary-light);\n}\n\n.stat-card.stat-due .stat-number {\n  color: var(--warning);\n}\n\n.stat-card.stat-done .stat-number {\n  color: var(--success);\n}\n\n.stat-card .stat-title {\n  font-size: 14px;\n  color: var(--text-secondary);\n  margin-top: 8px;\n}\n\n.stats-chart {\n  background: var(--bg-card);\n  border-radius: var(--radius);\n  padding: 32px;\n}\n\n.stats-chart h3 {\n  font-size: 18px;\n  margin-bottom: 24px;\n}\n\n.progress-bar {\n  height: 32px;\n  border-radius: 16px;\n  overflow: hidden;\n  display: flex;\n  background: var(--bg-dark);\n}\n\n.progress-segment {\n  height: 100%;\n  transition: width 0.5s ease;\n}\n\n.progress-legend {\n  display: flex;\n  gap: 24px;\n  justify-content: center;\n  margin-top: 16px;\n  font-size: 14px;\n  color: var(--text-secondary);\n}\n\n.legend-dot {\n  display: inline-block;\n  width: 12px;\n  height: 12px;\n  border-radius: 50%;\n  margin-right: 8px;\n}\n\n/* Modal */\n.modal {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(0, 0, 0, 0.7);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n}\n\n.modal-content {\n  background: var(--bg-card);\n  border-radius: var(--radius);\n  padding: 32px;\n  max-width: 400px;\n  width: 90%;\n}\n\n.modal-content h3 {\n  font-size: 20px;\n  margin-bottom: 12px;\n}\n\n.modal-content p {\n  color: var(--text-secondary);\n  margin-bottom: 24px;\n}\n\n.modal-actions {\n  display: flex;\n  gap: 12px;\n  justify-content: flex-end;\n}\n\n/* Toast */\n.toast {\n  position: fixed;\n  bottom: 32px;\n  right: 32px;\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: 16px 24px;\n  box-shadow: var(--shadow);\n  transform: translateY(100px);\n  opacity: 0;\n  transition: all 0.3s ease;\n  z-index: 1001;\n}\n\n.toast.show {\n  transform: translateY(0);\n  opacity: 1;\n}\n\n.toast.success {\n  border-color: var(--success);\n}\n\n.toast.error {\n  border-color: var(--danger);\n}\n\n/* Responsive */\n@media (max-width: 1024px) {\n  .sidebar {\n    width: 80px;\n  }\n  \n  .logo-text,\n  .nav-item span:not(.nav-icon):not(.badge),\n  .stat-label {\n    display: none;\n  }\n  \n  .nav-item {\n    justify-content: center;\n    padding: 12px;\n  }\n  \n  .badge {\n    position: absolute;\n    top: 4px;\n    right: 4px;\n    padding: 2px 6px;\n    font-size: 10px;\n  }\n  \n  .main-content {\n    margin-left: 80px;\n  }\n  \n  .stats-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n\n@media (max-width: 768px) {\n  .sidebar {\n    display: none;\n  }\n  \n  .main-content {\n    margin-left: 0;\n    padding: 16px;\n  }\n  \n  .rating-buttons {\n    flex-wrap: wrap;\n  }\n  \n  .rating-btn {\n    min-width: calc(50% - 6px);\n  }\n  \n  .stats-grid {\n    grid-template-columns: 1fr;\n  }\n}\n"}],"isError":false,"timestamp":1772152860990}}
{"type":"message","id":"ed3fc9b4","parentId":"3e5dbe47","timestamp":"2026-02-27T00:42:14.410Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"现在我需要更新 CSS 以支持主题切换，并更新前端 JavaScript 来支持多牌组管理和主题。","thinkingSignature":"423c6c56c6792f7b3a3cae97988fc240a2df277474071280f8f1ccf9326d1d66"},{"type":"toolCall","id":"call_function_itjc050burzl_1","name":"write","arguments":{"content":"/* FSRS Memory Web UI - Styles with Theme Support */\n\n/* CSS Variables - Light Theme */\n:root {\n  --primary: #6366f1;\n  --primary-dark: #4f46e5;\n  --primary-light: #818cf8;\n  --secondary: #64748b;\n  --success: #22c55e;\n  --warning: #f59e0b;\n  --danger: #ef4444;\n  \n  /* Light theme colors */\n  --bg-body: #f8fafc;\n  --bg-dark: #ffffff;\n  --bg-card: #ffffff;\n  --bg-hover: #f1f5f9;\n  --text-primary: #0f172a;\n  --text-secondary: #475569;\n  --text-muted: #94a3b8;\n  --border: #e2e8f0;\n  --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\n  \n  --radius: 12px;\n  --radius-sm: 8px;\n}\n\n/* Dark Theme */\n[data-theme=\"dark\"] {\n  --bg-body: #0f172a;\n  --bg-dark: #0f172a;\n  --bg-card: #1e293b;\n  --bg-hover: #334155;\n  --text-primary: #f8fafc;\n  --text-secondary: #94a3b8;\n  --text-muted: #64748b;\n  --border: #334155;\n  --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.3);\n}\n\n/* Reset & Base */\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nbody {\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;\n  background: var(--bg-body);\n  color: var(--text-primary);\n  min-height: 100vh;\n  transition: background 0.3s, color 0.3s;\n}\n\n/* App Layout */\n#app {\n  display: flex;\n  min-height: 100vh;\n}\n\n/* Sidebar */\n.sidebar {\n  width: 260px;\n  background: var(--bg-card);\n  border-right: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;\n  position: fixed;\n  height: 100vh;\n  z-index: 100;\n  transition: background 0.3s, border-color 0.3s;\n}\n\n.logo {\n  padding: 24px 20px;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  border-bottom: 1px solid var(--border);\n}\n\n.logo-icon {\n  font-size: 28px;\n}\n\n.logo-text {\n  font-size: 18px;\n  font-weight: 600;\n  background: linear-gradient(135deg, var(--primary-light), var(--primary));\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n\n/* Theme Toggle */\n.theme-toggle {\n  padding: 16px 20px;\n  border-bottom: 1px solid var(--border);\n}\n\n.theme-btn {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  width: 100%;\n  padding: 10px 14px;\n  background: var(--bg-hover);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-sm);\n  color: var(--text-secondary);\n  font-size: 14px;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.theme-btn:hover {\n  background: var(--border);\n  color: var(--text-primary);\n}\n\n/* Deck Selector */\n.deck-selector {\n  padding: 12px;\n  border-bottom: 1px solid var(--border);\n}\n\n.deck-selector-label {\n  font-size: 12px;\n  color: var(--text-muted);\n  margin-bottom: 8px;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.deck-select {\n  width: 100%;\n  padding: 10px 12px;\n  background: var(--bg-hover);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-sm);\n  color: var(--text-primary);\n  font-size: 14px;\n  cursor: pointer;\n}\n\n.deck-select:focus {\n  outline: none;\n  border-color: var(--primary);\n}\n\n.nav-menu {\n  padding: 16px 12px;\n  flex: 1;\n}\n\n.nav-item {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  width: 100%;\n  padding: 12px 16px;\n  background: transparent;\n  border: none;\n  border-radius: var(--radius-sm);\n  color: var(--text-secondary);\n  font-size: 15px;\n  cursor: pointer;\n  transition: all 0.2s;\n  text-align: left;\n}\n\n.nav-item:hover {\n  background: var(--bg-hover);\n  color: var(--text-primary);\n}\n\n.nav-item.active {\n  background: var(--primary);\n  color: white;\n}\n\n.nav-icon {\n  font-size: 18px;\n}\n\n.badge {\n  margin-left: auto;\n  background: var(--danger);\n  color: white;\n  padding: 2px 8px;\n  border-radius: 12px;\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.nav-item.active .badge {\n  background: white;\n  color: var(--primary);\n}\n\n.sidebar-stats {\n  padding: 20px;\n  border-top: 1px solid var(--border);\n  display: flex;\n  gap: 16px;\n}\n\n.sidebar-stats .stat-item {\n  flex: 1;\n  text-align: center;\n}\n\n.stat-value {\n  display: block;\n  font-size: 24px;\n  font-weight: 700;\n  color: var(--primary-light);\n}\n\n.stat-label {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n/* Main Content */\n.main-content {\n  flex: 1;\n  margin-left: 260px;\n  padding: 32px;\n  min-height: 100vh;\n  transition: background 0.3s;\n}\n\n/* Views */\n.view {\n  display: none;\n  animation: fadeIn 0.3s ease;\n}\n\n.view.active {\n  display: block;\n}\n\n@keyframes fadeIn {\n  from { opacity: 0; transform: translateY(10px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n.view-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 24px;\n}\n\n.view-header h1 {\n  font-size: 28px;\n  font-weight: 600;\n}\n\n/* Study View */\n.study-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 32px;\n}\n\n.study-header h1 {\n  font-size: 32px;\n  font-weight: 700;\n}\n\n.study-progress {\n  background: var(--bg-card);\n  padding: 12px 24px;\n  border-radius: var(--radius);\n  font-size: 16px;\n  font-weight: 600;\n  border: 1px solid var(--border);\n}\n\n.deck-info {\n  font-size: 14px;\n  color: var(--text-secondary);\n  margin-bottom: 16px;\n}\n\n.empty-state {\n  text-align: center;\n  padding: 80px 40px;\n  background: var(--bg-card);\n  border-radius: var(--radius);\n  border: 1px solid var(--border);\n}\n\n.empty-icon {\n  font-size: 64px;\n  margin-bottom: 24px;\n}\n\n.empty-state h2 {\n  font-size: 28px;\n  margin-bottom: 12px;\n}\n\n.empty-state p {\n  color: var(--text-secondary);\n  margin-bottom: 24px;\n}\n\n/* Card Area */\n.card-area {\n  max-width: 700px;\n  margin: 0 auto;\n}\n\n.card {\n  background: var(--bg-card);\n  border-radius: var(--radius);\n  overflow: hidden;\n  box-shadow: var(--shadow);\n  border: 1px solid var(--border);\n  transition: background 0.3s, border-color 0.3s;\n}\n\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  padding: 16px 20px;\n  background: rgba(0, 0, 0, 0.05);\n  font-size: 14px;\n}\n\n[data-theme=\"dark\"] .card-header {\n  background: rgba(0, 0, 0, 0.2);\n}\n\n.card-id {\n  color: var(--text-muted);\n}\n\n.card-state {\n  padding: 4px 12px;\n  border-radius: 20px;\n  font-size: 12px;\n  font-weight: 600;\n  text-transform: uppercase;\n}\n\n.card-state.new { background: #3498db; color: white; }\n.card-state.learning { background: #f39c12; color: white; }\n.card-state.review { background: #27ae60; color: white; }\n.card-state.relearning { background: #e74c3c; color: white; }\n\n.card-content {\n  padding: 40px;\n  min-height: 200px;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n}\n\n.card-label {\n  font-size: 12px;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  margin-bottom: 16px;\n}\n\n.card-text {\n  font-size: 24px;\n  line-height: 1.6;\n  text-align: center;\n  white-space: pre-wrap;\n}\n\n.card-footer {\n  padding: 20px;\n  border-top: 1px solid var(--border);\n  text-align: center;\n}\n\n/* Rating Buttons */\n.rating-buttons {\n  display: flex;\n  gap: 12px;\n  margin-top: 24px;\n}\n\n.rating-btn {\n  flex: 1;\n  padding: 16px 12px;\n  border: none;\n  border-radius: var(--radius-sm);\n  cursor: pointer;\n  transition: all 0.2s;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 8px;\n}\n\n.rating-btn:hover {\n  transform: translateY(-2px);\n}\n\n.rating-label {\n  font-size: 14px;\n  font-weight: 600;\n  color: white;\n}\n\n.rating-interval {\n  font-size: 12px;\n  color: rgba(255, 255, 255, 0.8);\n}\n\n.rating-again { background: #ef4444; }\n.rating-hard { background: #f59e0b; }\n.rating-good { background: #22c55e; }\n.rating-easy { background: #3b82f6; }\n.rating-perfect { background: #8b5cf6; }\n\n/* Buttons */\n.btn {\n  padding: 12px 24px;\n  border: none;\n  border-radius: var(--radius-sm);\n  font-size: 15px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.btn-primary {\n  background: var(--primary);\n  color: white;\n}\n\n.btn-primary:hover {\n  background: var(--primary-dark);\n}\n\n.btn-secondary {\n  background: var(--bg-hover);\n  color: var(--text-primary);\n  border: 1px solid var(--border);\n}\n\n.btn-secondary:hover {\n  background: var(--border);\n}\n\n.btn-danger {\n  background: var(--danger);\n  color: white;\n}\n\n.btn-hint {\n  background: var(--bg-hover);\n  color: var(--text-secondary);\n  font-size: 14px;\n  padding: 10px 32px;\n  border: 1px solid var(--border);\n}\n\n.btn-hint:hover {\n  background: var(--border);\n  color: var(--text-primary);\n}\n\n.btn-large {\n  padding: 16px 48px;\n  font-size: 16px;\n}\n\n.btn-small {\n  padding: 8px 16px;\n  font-size: 14px;\n}\n\n/* Search Box */\n.search-box {\n  display: flex;\n  gap: 12px;\n}\n\n.search-box input {\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-sm);\n  padding: 12px 16px;\n  color: var(--text-primary);\n  font-size: 15px;\n  width: 300px;\n}\n\n.search-box input:focus {\n  outline: none;\n  border-color: var(--primary);\n}\n\n/* Cards List */\n.cards-list {\n  display: grid;\n  gap: 16px;\n}\n\n.card-item {\n  background: var(--bg-card);\n  border-radius: var(--radius);\n  padding: 20px;\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  transition: all 0.2s;\n  border: 1px solid var(--border);\n}\n\n.card-item:hover {\n  background: var(--bg-hover);\n}\n\n.card-item-content {\n  flex: 1;\n  min-width: 0;\n}\n\n.card-item-header {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 8px;\n}\n\n.card-item-id {\n  color: var(--text-muted);\n  font-size: 14px;\n}\n\n.card-item-deck {\n  font-size: 12px;\n  color: var(--text-muted);\n  background: var(--bg-hover);\n  padding: 2px 8px;\n  border-radius: 4px;\n}\n\n.card-item-state {\n  padding: 2px 8px;\n  border-radius: 10px;\n  font-size: 11px;\n}\n\n.card-item-question {\n  font-size: 16px;\n  font-weight: 500;\n  margin-bottom: 8px;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.card-item-answer {\n  font-size: 14px;\n  color: var(--text-secondary);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.card-item-meta {\n  display: flex;\n  gap: 16px;\n  margin-top: 12px;\n  font-size: 13px;\n  color: var(--text-muted);\n}\n\n.card-item-actions {\n  display: flex;\n  gap: 8px;\n}\n\n.btn-icon {\n  width: 36px;\n  height: 36px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: var(--radius-sm);\n  background: transparent;\n  border: 1px solid var(--border);\n  color: var(--text-secondary);\n  cursor: pointer;\n  transition: all 0.2s;\n}\n\n.btn-icon:hover {\n  background: var(--bg-hover);\n  color: var(--text-primary);\n}\n\n.btn-icon.danger:hover {\n  background: var(--danger);\n  border-color: var(--danger);\n  color: white;\n}\n\n/* Add Form */\n.add-form {\n  max-width: 600px;\n}\n\n.form-group {\n  margin-bottom: 24px;\n}\n\n.form-group label {\n  display: block;\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--text-secondary);\n  margin-bottom: 8px;\n}\n\n.form-group textarea,\n.form-group input,\n.form-group select {\n  width: 100%;\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-sm);\n  padding: 16px;\n  color: var(--text-primary);\n  font-size: 15px;\n  resize: vertical;\n  font-family: inherit;\n}\n\n.form-group textarea:focus,\n.form-group input:focus,\n.form-group select:focus {\n  outline: none;\n  border-color: var(--primary);\n}\n\n.quick-add {\n  margin-top: 40px;\n  padding-top: 40px;\n  border-top: 1px solid var(--border);\n}\n\n.quick-add h3 {\n  font-size: 16px;\n  margin-bottom: 16px;\n  color: var(--text-secondary);\n}\n\n/* Decks View */\n.decks-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\n  gap: 20px;\n}\n\n.deck-card {\n  background: var(--bg-card);\n  border-radius: var(--radius);\n  padding: 24px;\n  border: 1px solid var(--border);\n  transition: all 0.2s;\n}\n\n.deck-card:hover {\n  transform: translateY(-4px);\n  box-shadow: var(--shadow);\n}\n\n.deck-card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  margin-bottom: 16px;\n}\n\n.deck-card-name {\n  font-size: 20px;\n  font-weight: 600;\n}\n\n.deck-card-default {\n  font-size: 11px;\n  background: var(--primary);\n  color: white;\n  padding: 2px 8px;\n  border-radius: 4px;\n}\n\n.deck-card-desc {\n  color: var(--text-secondary);\n  font-size: 14px;\n  margin-bottom: 16px;\n}\n\n.deck-card-stats {\n  display: flex;\n  gap: 24px;\n  margin-bottom: 16px;\n}\n\n.deck-stat {\n  text-align: center;\n}\n\n.deck-stat-value {\n  font-size: 24px;\n  font-weight: 700;\n  color: var(--primary-light);\n}\n\n.deck-stat-label {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n.deck-card-actions {\n  display: flex;\n  gap: 8px;\n}\n\n/* Stats */\n.stats-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 20px;\n  margin-bottom: 40px;\n}\n\n.stat-card {\n  background: var(--bg-card);\n  border-radius: var(--radius);\n  padding: 24px;\n  text-align: center;\n  transition: all 0.2s;\n  border: 1px solid var(--border);\n}\n\n.stat-card:hover {\n  transform: translateY(-4px);\n}\n\n.stat-card .stat-icon {\n  font-size: 32px;\n  margin-bottom: 12px;\n}\n\n.stat-card .stat-number {\n  font-size: 40px;\n  font-weight: 700;\n  color: var(--primary-light);\n}\n\n.stat-card.stat-due .stat-number {\n  color: var(--warning);\n}\n\n.stat-card.stat-done .stat-number {\n  color: var(--success);\n}\n\n.stat-card .stat-title {\n  font-size: 14px;\n  color: var(--text-secondary);\n  margin-top: 8px;\n}\n\n.stats-chart {\n  background: var(--bg-card);\n  border-radius: var(--radius);\n  padding: 32px;\n  border: 1px solid var(--border);\n}\n\n.stats-chart h3 {\n  font-size: 18px;\n  margin-bottom: 24px;\n}\n\n.progress-bar {\n  height: 32px;\n  border-radius: 16px;\n  overflow: hidden;\n  display: flex;\n  background: var(--bg-hover);\n}\n\n.progress-segment {\n  height: 100%;\n  transition: width 0.5s ease;\n}\n\n.progress-legend {\n  display: flex;\n  gap: 24px;\n  justify-content: center;\n  margin-top: 16px;\n  font-size: 14px;\n  color: var(--text-secondary);\n}\n\n.legend-dot {\n  display: inline-block;\n  width: 12px;\n  height: 12px;\n  border-radius: 50%;\n  margin-right: 8px;\n}\n\n/* Modal */\n.modal {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(0, 0, 0, 0.7);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  z-index: 1000;\n}\n\n.modal-content {\n  background: var(--bg-card);\n  border-radius: var(--radius);\n  padding: 32px;\n  max-width: 500px;\n  width: 90%;\n}\n\n.modal-content h3 {\n  font-size: 20px;\n  margin-bottom: 12px;\n}\n\n.modal-content p {\n  color: var(--text-secondary);\n  margin-bottom: 24px;\n}\n\n.modal-actions {\n  display: flex;\n  gap: 12px;\n  justify-content: flex-end;\n}\n\n/* Toast */\n.toast {\n  position: fixed;\n  bottom: 32px;\n  right: 32px;\n  background: var(--bg-card);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: 16px 24px;\n  box-shadow: var(--shadow);\n  transform: translateY(100px);\n  opacity: 0;\n  transition: all 0.3s ease;\n  z-index: 1001;\n}\n\n.toast.show {\n  transform: translateY(0);\n  opacity: 1;\n}\n\n.toast.success {\n  border-color: var(--success);\n}\n\n.toast.error {\n  border-color: var(--danger);\n}\n\n/* Responsive */\n@media (max-width: 1024px) {\n  .sidebar {\n    width: 80px;\n  }\n  \n  .logo-text,\n  .nav-item span:not(.nav-icon):not(.badge),\n  .stat-label,\n  .theme-toggle,\n  .deck-selector {\n    display: none;\n  }\n  \n  .nav-item {\n    justify-content: center;\n    padding: 12px;\n  }\n  \n  .badge {\n    position: absolute;\n    top: 4px;\n    right: 4px;\n    padding: 2px 6px;\n    font-size: 10px;\n  }\n  \n  .main-content {\n    margin-left: 80px;\n  }\n  \n  .stats-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n\n@media (max-width: 768px) {\n  .sidebar {\n    display: none;\n  }\n  \n  .main-content {\n    margin-left: 0;\n    padding: 16px;\n  }\n  \n  .rating-buttons {\n    flex-wrap: wrap;\n  }\n  \n  .rating-btn {\n    min-width: calc(50% - 6px);\n  }\n  \n  .stats-grid {\n    grid-template-columns: 1fr;\n  }\n}\n","file_path":"/home/one/.openclaw/skills/fsrs-memory/web/public/styles.css"}}],"api":"anthropic-messages","provider":"minimax-portal","model":"MiniMax-M2.5","usage":{"input":27608,"output":5028,"cacheRead":9100,"cacheWrite":0,"totalTokens":41736,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772152860993}}
