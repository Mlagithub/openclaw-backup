'apkg'), async (req, res) => {\n  try {\n    if (!req.file) return res.status(400).json({ success: false, error: 'No file uploaded' });\n\n    const importer = new APKGImporter(db);\n    const preview = await importer.preview(req.file.path);\n    fs.unlinkSync(req.file.path);\n\n    if (!preview.success) return res.status(400).json(preview);\n    res.json(preview);\n  } catch (error) {\n    if (req.file && fs.existsSync(req.file.path)) fs.unlinkSync(req.file.path);\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\napp.post('/api/apkg/import', upload.single('apkg'), async (req, res) => {\n  try {\n    if (!req.file) return res.status(400).json({ success: false, error: 'No file uploaded' });\n\n    const { deckId } = req.body;\n    const targetDeckId = deckId ? parseInt(deckId) : 1;\n\n    const importer = new APKGImporter(db);\n    const result = await importer.import(req.file.path, targetDeckId);\n    fs.unlinkSync(req.file.path);\n\n    if (!result.success) return res.status(400).json(result);\n    res.json(result);\n  } catch (error) {\n    if (req.file && fs.existsSync(req.file.path)) fs.unlinkSync(req.file.path);\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\n// ==================== Phase 3 API Routes ====================\nsetupPhase3API(app, db);\n\n// Serve SPA\napp.get('*', (req, res) => {\n  res.sendFile(path.join(__dirname, 'public', 'index.html'));\n});\n\n// Start server\napp.listen(PORT, () => {\n  console.log(`FSRS Web UI server (Phase 3) running on http://localhost:${PORT}`);\n});\n\nmodule.exports = app;","cwd":"/home/one/.openclaw/agents/leader-agent"},"isError":false,"timestamp":1772183086769}}
