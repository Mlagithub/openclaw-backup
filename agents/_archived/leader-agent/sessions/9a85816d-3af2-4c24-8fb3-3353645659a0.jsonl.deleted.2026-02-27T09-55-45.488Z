{"type":"message","id":"aa293bc0","parentId":"d03af59c","timestamp":"2026-02-27T09:04:41.585Z","message":{"role":"toolResult","toolCallId":"call_7f8ba70fce1547d0a34739b9","toolName":"read","content":[{"type":"text","text":"    res.json({ success: true, data: updatedCard, nextInterval: formatInterval(result.interval) });\n  } catch (error) {\n    res.status(500).json({ success: false, error: error.message });\n  }\n});\n\nfunction formatInterval(days) {\n  if (days < 1) {\n    const minutes = Math.round(days * 24 * 60);\n    return minutes < 60 ? `${minutes}m` : `${Math.round(minutes / 60)}h`;\n  } else if (days < 30) {\n    return `${Math.round(days)}d`;\n  } else if (days < 365) {\n    return `${Math.round(days / 30)}mo`;\n  } else {\n    return `${Math.round(days / 365)}y`;\n  }\n}\n\n// ==================== APKG Import API ====================\n\nconst multer = require('multer');\nconst APKGImporter = require('../src/apkg-import');\n\nconst UPLOAD_DIR = path.join(__dirname, 'uploads');\nif (!fs.existsSync(UPLOAD_DIR)) fs.mkdirSync(UPLOAD_DIR, { recursive: true });\n\nconst storage = multer.diskStorage({\n  destination: (req, file, cb) => cb(null, UPLOAD_DIR),\n  filename: (req, file, cb) => cb(null, Date.now() + '-' + file.originalname)\n});\n\nconst upload = multer({ \n  storage,\n  fileFilter: (req, file, cb) => {\n    if (file.originalname.endsWith('.apkg')) cb(null, true);\n    else cb(new Error('Only .apkg files are allowed'));\n  },\n  limits: { fileSize: 50 * 1024 * 1024 }\n});\n\napp.post('/api/apkg/preview', upload.single('apkg'), async (req, res) => {\n  try {\n    if (!req.file) return res.status(400).json({ success: false, error: 'No file uploaded' });\n\n    const importer = new APKGImporter(db);\n    const preview = await importer.preview(req.file.path);\n    fs.unlinkSync(req.file.path);\n\n    if (!preview.success) return res.status(400).json(preview);\n\n[41 more lines in file. Use offset=370 to continue.]"}],"isError":false,"timestamp":1772183081580}}
