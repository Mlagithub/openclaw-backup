{"type":"message","id":"fe0aef91","parentId":"77fde4df","timestamp":"2026-03-03T11:29:59.939Z","message":{"role":"toolResult","toolCallId":"call_e1635d5785df417093673b57","toolName":"read","content":[{"type":"text","text":"#pragma once\n\n#include <limits>\n#include <vector>\n#include <string>\n#include <unordered_map>\n#include <map>\n#include <set>\n#include <iostream>\n\n#include <cgnslib.h>\n\n#include \"vec.h\"\n#include \"meshCutter.h\"\n#include \"format.h\"\n#include \"cgFile.h\"\n\nusing std::set;\nusing std::map;\nusing std::string;\nusing std::vector;\nusing std::unordered_map;\n\nnamespace MeshCut\n{\nclass CartesianCutter : public MeshCutter\n{\npublic:\n    void cut(int argc, char** argv) override;\n\n    struct BoundBox\n    {\n        double max_x = -std::numeric_limits<double>::max();\n        double max_y = -std::numeric_limits<double>::max();\n        double max_z = -std::numeric_limits<double>::max();\n        double min_x = std::numeric_limits<double>::max();\n        double min_y = std::numeric_limits<double>::max();\n        double min_z = std::numeric_limits<double>::max();\n        double range_x() const { return max_x - min_x; }\n        double range_y() const { return max_y - min_y; }\n        double range_z() const { return max_z - min_z; }\n        double min(const int i)\n        {\n            switch (i)\n            {\n            case 1:\n                return min_x;\n            case 2:\n                return min_y;\n            case 3:\n                return min_z;\n            default:\n                throw std::invalid_argument(format(\"invalid axis index: %d\", i));\n            }\n        }\n        double max(const int i)\n        {\n            switch (i)\n            {\n            case 1:\n                return max_x;\n            case 2:\n                return max_y;\n            case 3:\n                return max_z;\n            default:\n                throw std::invalid_argument(format(\"invalid axis index: %d\", i));\n                break;\n            }\n        }\n    };\n\nprivate:\n    struct Location\n    {\n        Location(){}\n        Location(int i, int j, int k) : i(i), j(j), k(k) {}\n        int i, j, k;\n    };\n\n    struct Section\n    {\n        int id = 1;\n        char name[33];\n        ElementType_t cellType;\n        cgsize_t start=1, end=1, dataSize=0;\n        int nBdy=0, flag;\n        vector<vector<cgsize_t>> data;\n        vector<cgsize_t> offset, typeFlag;\n    };\n    \n    struct Face\n    {\n        Face(const vector<cgsize_t>& val);\n        Face(vector<cgsize_t>&& val) noexcept;\n        \n        Face(const Face& other);\n        Face(Face&& other) noexcept;\n\n        Face& operator=(const Face& other);\n        Face& operator=(Face&& other) noexcept;\n\n        vector<cgsize_t> nodeList; \n        bool operator==(const Face &other) const;\n        bool operator<(const Face& rhs) const;\n    };\n\n    struct CellLoader\n    {\n        CellLoader(Section& curS, vector<cgsize_t>& data, vector<cgsize_t>& offset, const int fp);\n        bool nextCell(vector<cgsize_t>& nodes);\n        Section& curS;\n        vector<cgsize_t>& data;\n        vector<cgsize_t>& offset;\n        cgsize_t len;\n        int npe, flag = -1;\n        cgsize_t id = 0;\n    };\n\n    struct Weight\n    {\n    public:\n        Weight(const int nx, const int ny, const int nz);\n\n        // weight value of each sub-mesh at X/Y/Z directions\n        // wx_mesh0, wx_mesh1, wx_mesh2, ... wx_meshN\n        // wy_mesh0, wy_mesh1, wy_mesh2, ... wy_meshN\n        // wz_mesh0, wz_mesh1, wz_mesh2, ... wz_meshN\n        Weight(string fname, const int nx, const int ny, const int nz);\n\n        double x(const Location& loc) const;\n        double y(const Location& loc) const;\n        double z(const Location& loc) const;\n        double sumX(const Location& loc) const;\n        double sumY(const Location& loc) const;\n        double sumZ(const Location& loc) const;\n    private:\n        void updateSumWeight();\n        void normalize();\n\n    private:\n        vector<vector<double>> weights_, sumWeights_;\n    };\n\nprivate:\n    int nx_, ny_, nz_, n_;\n    int bigFile_;\n    map<int, int> smallFiles_;\n    map<int, BoundBox> bbox_;\n\n    int cell_dim_, ibase=1, izone=1, igrid=1;\n    cgsize_t zoneInfo[3];\n    DataType_t coordDataType_;\n    vector<string> coordname_;\n    string interiorFacePrefix_;\n\n    map<int, cgsize_t> globalNumber_;\n    map<int, cgsize_t> globalOffset_;\n    map<int, Section> sections_;\n    map<int, map<cgsize_t, cgsize_t>> nodeIdMap_;\n    vector<vector<double>> nodesData_;\n    set<cgsize_t> nodeIdInBox_;\n    map<int, map<string, vector<cgsize_t>>> outerFace_;\n    vector<int> bodySection_, bdySection_, interiorSection_;\n    vector<cgsize_t> idOffset_;\n\nprivate:\n    vector<vector<cgsize_t>> allFaceInCell(const vector<cgsize_t>& idList, ElementType_t type);\n\n    vector<double> boundingBoxBigMesh();\n\n    void boundingBoxSmallMesh(string weightFilename);\n\n    void checkFile(string filename);\n\n    Vector<double> cellCenter(const vector<cgsize_t>& cell, const ElementType_t type);\n\n    void cut(\n        const std::string &mesh, \n        const int npart, \n        const int nx = 1, \n        const int ny = 1, \n        const int nz = 1, \n        const string weightFilename = \"\",\n        bool multiZone = false, \n        vector<string> fluidDomainNameRule={},\n        string interiorSection = \"\"\n        );\n        \n    bool isBodySection(const Section& section);\n\n    bool isFluidDomain(const string& name, const vector<string>& fluidDomainNameRule);\n\n    bool inBox(const BoundBox& box, const vector<cgsize_t>& cell, const ElementType_t type);\n\n    Location id2Location(const int x) const;\n\n    int location2Id(const Location& loc) const;\n\n    int location2Id(Location&& loc) const;\n\n    vector<int> neighbors(const int x);\n\n    string openToWrite(string filename, const int id);\n\n    bool pickBodyCellInBox(const BoundBox& box, Section& curS);\n\n    int precision();\n\n    void readNode();\n\n    void rwBoundary(const int id);\n\n    void rwInterior(const int id);\n\n    void rwInterface(const int id);\n\n    string stringAFace(const vector<cgsize_t>& face);\n\n    void updateNodeId(const Section& curS);\n\n    void updateOuterFace(const Section& curS, const int id);\n\n    void writeSection(Section &curS, const int id);\n\n    void writeNode(const int id);\n\n    void writeGlobalInfo(const Section& curS, const int id);\n};\n\nstd::ostream &operator<<(std::ostream &os, const CartesianCutter::BoundBox &bbox);\n\n} // namespace MeshCut\n"}],"isError":false,"timestamp":1772537399936}}
{"type":"message","id":"c561abfe","parentId":"fe0aef91","timestamp":"2026-03-03T11:29:59.945Z","message":{"role":"toolResult","toolCallId":"call_6abc03c49b0b4e559a2d7d74","toolName":"read","content":[{"type":"text","text":"#pragma once\n\n#include <memory>\n#include <unordered_map>\n#include <map>\n\n#ifdef SUPPORT_METIS\n#include <metis.h>\n#else \n    typedef int64_t idx_t;\n#endif\n\n#include \"meshCutter.h\"\n#include \"cgFile.h\"\n\nusing std::map;\nusing std::unordered_map;\n\n\nnamespace MeshCut\n{\nclass MetisCutter : public MeshCutter\n{\npublic:\n    MetisCutter();\n    virtual ~MetisCutter();\n\npublic:\n    void cut(int argc, char** argv) override;\n\nprivate:\n    using cgns_filetype = std::shared_ptr<CGFile>;\n    int RANK = 0, SIZE = 1;\n    cgns_filetype bigMesh_;\n    vector<cgns_filetype> smallMesh_;\n    map<int, map<cgsize_t, cgsize_t>> nodeIdG2L_;\n    set<cgsize_t> nodeIds_, cellIds_;\n    vector<idx_t> cellPartition_, nodePartition_;\n    unordered_map<int, map<string, vector<cgsize_t>>> outerFace_;\n    cgsize_t globalOffset_ = 0;\n    set<int> ownerFile_;\n    struct DecomposeResult\n    {\n        idx_t nCellThisRank, start;\n    };\n    struct Cell\n    {\n        idx_t id;   // begin from 1\n        int partId; // begin from 0;\n    };\n    vector<int> ownerThread_;\n\nprivate:\n    void collect_interface();\n    \n    vector<Cell> collect_subBody(const DecomposeResult& decomposeResult, const vector<int>& ownerThread);\n\n    void cut_metis(string mesh, const int np);\n\n    int cut_metis(const vector<vector<idx_t>>& cellToplogy, idx_t np, vector<idx_t>& cellPartition, vector<idx_t>& nodePartition);\n\n    void cut_parmetis(string mesh, const int np);\n\n    int cut_parmetis(idx_t np, vector<idx_t>& elmdist, vector<idx_t>& eptr, vector<idx_t>& eind, vector<idx_t>& cellPartition);\n\n    DecomposeResult decompose_body(const CGFile::Section& bigBody, const int np);\n\n    void updateOwnerThread(string filename, const int np);\n\n    void openSubMeshToWrite(string filename, const int id, const int np);\n\n    void rwBody(const int ifile, const CGFile::Section& bigBody);\n\n    void rwBoundary(const int ifile);\n\n    void rwInterface(const int ifile);\n\n    void rwNode(const int ifile);\n\n    std::string smallMeshName(string bigMeshName, const int id, const int np);\n\n    void updateOuterFace(const CGFile::Section& curS, const int id);\n\n    void writeGlobalInfo(const CGFile::Section& curS, const int id);\n\n    void writeInterface(const int ifile, const int np);\n};\n} // namespace MeshCut\n"}],"isError":false,"timestamp":1772537399943}}
{"type":"message","id":"18688dc6","parentId":"c561abfe","timestamp":"2026-03-03T11:29:59.951Z","message":{"role":"toolResult","toolCallId":"call_30c7819399da4ca0bc6ced14","toolName":"read","content":[{"type":"text","text":"#\n# A small macro used for converting a list into a space\n# separated string:\n#\n# Usage:\n#     TO_STRING(string ${list1} ${list2} ...)\n#\nMACRO(TO_STRING _variable)\n  SET(${_variable} \"\")\n  FOREACH(_var  ${ARGN})\n    SET(${_variable} \"${${_variable}} ${_var}\")\n  ENDFOREACH()\n  STRING(STRIP \"${${_variable}}\" ${_variable})\nENDMACRO()\n\n#\n# If 'variable' is empty it will be set to 'value'\n#\nMACRO(SET_IF_EMPTY _variable)\n  IF(\"${${_variable}}\" STREQUAL \"\")\n    SET(${_variable} ${ARGN})\n  ENDIF()\nENDMACRO()\n\n\nMACRO(_FIND_LIBRARY _library_name)\n  # Save a string representation of the arguments before cmake's\n  # FIND_FILE gets its hands on it.\n  TO_STRING(_str ${ARGN})\n\n  FIND_LIBRARY(${_library_name} ${ARGN})\n\n  IF(${_library_name} MATCHES \"-NOTFOUND\")\n    MESSAGE(STATUS \"${_library_name} not found! The call was:\")\n    MESSAGE(STATUS \"    FIND_LIBRARY(${_library_name} ${_str})\")\n  ELSE()\n    MESSAGE(STATUS \"Found ${${_library_name}}\")\n    target_link_libraries(${TgtLib} PUBLIC ${${_library_name}})\n  ENDIF()\nENDMACRO()\n\n#\n# A small wrapper around FIND_FILE to be a bit more verbose\n#\nMACRO(_FIND_PATH _path_name)\n  # Save a string representation of the arguments before cmake's\n  # FIND_PATH gets its hands on it.\n  TO_STRING(_str ${ARGN})\n\n  FIND_PATH(${_path_name} ${ARGN})\n\n  IF(${_path_name} MATCHES \"-NOTFOUND\")\n    MESSAGE(STATUS \"${_path_name} not found! The call was:\")\n    MESSAGE(STATUS \"    FIND_PATH(${_path_name} ${_str})\")\n  ELSE()\n    MESSAGE(STATUS \"Found ${${_path_name}}\")\n    target_include_directories(${TgtLib} PUBLIC ${${_path_name}})\n  ENDIF()\nENDMACRO()\n\n\n# CGNS\nSET_IF_EMPTY(CGNS_DIR \"$ENV{CGNS_ROOT}\")\n_FIND_LIBRARY(CGNS_LIBRARY\n    NAMES cgns\n    HINTS ${CGNS_DIR}\n    PATH_SUFFIXES lib64 lib\n)\n_FIND_PATH(CGNS_INCLUDE_DIR cgnslib.h\n    HINTS ${CGNS_DIR}\n    PATH_SUFFIXES include cgns include/cgns\n)\n\n# METIS\nset (METIS_ROOT \"$ENV{METIS_ROOT}\")\nfind_library(metislib NAMES metis PATHS \"${METIS_ROOT}/lib\" NO_DEFAULT_PATH)\nif(metislib)\n    message(STATUS \"Found metis: \" ${metislib})\n    target_compile_definitions(${TgtLib} PUBLIC \"SUPPORT_METIS\")\n    target_link_libraries(${TgtLib} PUBLIC ${metislib})\n    target_include_directories(${TgtLib} PUBLIC \"${METIS_ROOT}/include\")\nelseif()\n    message(ERROR \"Can not find metis.\")\nendif()\n\n# ParMETIS\nset (PARMETIS_ROOT \"$ENV{PARMETIS_ROOT}\")\nfind_library(parmetislib NAMES parmetis PATHS \"${PARMETIS_ROOT}/lib\" REQUIRED NO_DEFAULT_PATH)\nif(parmetislib)\n    target_compile_definitions(${TgtLib} PUBLIC \"SUPPORT_PARMETIS\")\n    message(STATUS \"Found parmetis: \" ${parmetislib})\n    target_include_directories(${TgtLib} PUBLIC \"${PARMETIS_ROOT}/include\")\n    target_link_libraries(${TgtLib} PUBLIC ${parmetislib})\nelseif()\n    message(ERROR \"Can not find parmetis.\")\nendif()\n\n\n# MPI\nfind_package(MPI)\nif(MPI_FOUND)\n    message(STATUS \"Found MPI_LIB: \" ${MPI_CXX_LIBRARIES})\n    target_include_directories(${TgtLib} PUBLIC ${MPI_C_INCLUDE_DIRS} ${MPI_CXX_INCLUDE_DIRS})\n    target_link_libraries(${TgtLib} PUBLIC ${MPI_C_LIBRARIES} ${MPI_CXX_LIBRARIES})\nelse(MPI_FOUND)\n    set (MPI_ROOT \"$ENV{MPI_ROOT}\")\n    find_library(mpilib NAMES mpi PATHS \"${MPI_ROOT}/lib\" `which mpicc`../../lib)\n    target_include_directories(${TgtLib} PUBLIC \"${MPI_ROOT}/include\")\n    target_link_libraries(${TgtLib} PUBLIC ${mpilib})\nendif(MPI_FOUND)\n\ntarget_include_directories(${TgtLib} \nPUBLIC \n    ${CMAKE_CURRENT_LIST_DIR}\n)\n\ntarget_sources(${TgtLib}\nPRIVATE\n    meshCutter.cpp\n    stringUtil.cpp\n    cmdLine.cpp\n    cgFile.cpp\n    cartesianCutter.cpp\n    metisCutter.cpp\n    mpiAdapter.cpp\n)"}],"isError":false,"timestamp":1772537399949}}
