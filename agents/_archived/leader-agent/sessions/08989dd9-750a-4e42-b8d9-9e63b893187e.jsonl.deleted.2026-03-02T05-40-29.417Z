t.original_url).toBe('https://findtest.com');\n    });\n\n    test('should return null for non-existent code', () => {\n      const result = findByShortCode('nonexistent');\n      expect(result).toBeUndefined();\n    });\n  });\n\n  describe('findByOriginalUrl', () => {\n    test('should find URL by original URL', () => {\n      insertUrl('origtest', 'https://origtest.com');\n      const result = findByOriginalUrl('https://origtest.com');\n      expect(result).toBeDefined();\n      expect(result.short_code).toBe('origtest');\n    });\n\n    test('should return null for non-existent URL', () => {\n      const result = findByOriginalUrl('https://nonexistent.com');\n      expect(result).toBeUndefined();\n    });\n  });\n\n  describe('incrementClickCount', () => {\n    test('should increment click count', () => {\n      insertUrl('clicktest', 'https://clicktest.com');\n      const before = findByShortCode('clicktest');\n      expect(before.click_count).toBe(0);\n      \n      incrementClickCount('clicktest');\n      \n      const after = findByShortCode('clicktest');\n      expect(after.click_count).toBe(1);\n    });\n  });\n\n  describe('getNextId', () => {\n    test('should return next available ID', () => {\n      const id1 = getNextId();\n      insertUrl(`idtest${id1}`, `https://idtest${id1}.com`);\n      \n      const id2 = getNextId();\n      expect(id2).toBe(id1 + 1);\n    });\n  });\n\n  describe('listUrls', () => {\n    test('should list URLs with limit', () => {\n      const result = listUrls(10);\n      expect(result.length).toBeLessThanOrEqual(10);\n    });\n  });\n\n  describe('deleteUrl', () => {\n    test('should delete URL', () => {\n      insertUrl('deletetest', 'https://deletetest.com');\n      const deleted = deleteUrl('deletetest');\n      expect(deleted).toBe(true);\n      \n      const result = findByShortCode('deletetest');\n      expect(result).toBeUndefined();\n    });\n\n    test('should return false for non-existent URL', () => {\n      const deleted = deleteUrl('nonexistent');\n      expect(deleted).toBe(false);\n    });\n  });\n});\nEOF"}}],"api":"openai-completions","provider":"bailian","model":"glm-5","usage":{"input":835,"output":905,"cacheRead":26642,"cacheWrite":0,"totalTokens":28382,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772426911824}}
