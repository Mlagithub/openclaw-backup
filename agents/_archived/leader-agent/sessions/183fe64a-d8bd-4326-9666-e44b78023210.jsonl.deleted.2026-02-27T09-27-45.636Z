n    type: 'DATETIME',\n    notnull: 0,\n    dflt_value: null,\n    pk: 0\n  },\n  {\n    cid: 11,\n    name: 'deck_id',\n    type: 'INTEGER',\n    notnull: 0,\n    dflt_value: '1',\n    pk: 0\n  },\n  {\n    cid: 12,\n    name: 'template_id',\n    type: 'INTEGER',\n    notnull: 0,\n    dflt_value: '1',\n    pk: 0\n  },\n  {\n    cid: 13,\n    name: 'tags',\n    type: 'TEXT',\n    notnull: 0,\n    dflt_value: \"''\",\n    pk: 0\n  }\n]\ndecks: [\n  {\n    cid: 0,\n    name: 'id',\n    type: 'INTEGER',\n    notnull: 0,\n    dflt_value: null,\n    pk: 1\n  },\n  {\n    cid: 1,\n    name: 'name',\n    type: 'TEXT',\n    notnull: 1,\n    dflt_value: null,\n    pk: 0\n  },\n  {\n    cid: 2,\n    name: 'description',\n    type: 'TEXT',\n    notnull: 0,\n    dflt_value: null,\n    pk: 0\n  },\n  {\n    cid: 3,\n    name: 'created_at',\n    type: 'DATETIME',\n    notnull: 0,\n    dflt_value: 'CURRENT_TIMESTAMP',\n    pk: 0\n  },\n  {\n    cid: 4,\n    name: 'updated_at',\n    type: 'DATETIME',\n    notnull: 0,\n    dflt_value: 'CURRENT_TIMESTAMP',\n    pk: 0\n  }\n]\nmedia_files: [\n  {\n    cid: 0,\n    name: 'id',\n    type: 'INTEGER',\n    notnull: 0,\n    dflt_value: null,\n    pk: 1\n  },\n  {\n    cid: 1,\n    name: 'filename',\n    type: 'TEXT',\n    notnull: 1,\n    dflt_value: null,\n    pk: 0\n  },\n  {\n    cid: 2,\n    name: 'original_name',\n    type: 'TEXT',\n    notnull: 1,\n    dflt_value: null,\n    pk: 0\n  },\n  {\n    cid: 3,\n    name: 'mime_type',\n    type: 'TEXT',\n    notnull: 1,\n    dflt_value: null,\n    pk: 0\n  },\n  {\n    cid: 4,\n    name: 'file_size',\n    type: 'INTEGER',\n    notnull: 1,\n    dflt_value: null,\n    pk: 0\n  },\n  {\n    cid: 5,\n    name: 'file_hash',\n    type: 'TEXT',\n    notnull: 0,\n    dflt_value: null,\n    pk: 0\n  },\n  {\n    cid: 6,\n    name: 'uploaded_at',\n    type: 'DATETIME',\n    notnull: 0,\n    dflt_value: 'CURRENT_TIMESTAMP',\n    pk: 0\n  },\n  {\n    cid: 7,\n    name: 'card_id',\n    type: 'INTEGER',\n    notnull: 0,\n    dflt_value: null,\n    pk: 0\n  }\n]\ncard_templates: [\n  {\n    cid: 0,\n    name: 'id',\n    type: 'INTEGER',\n    notnull: 0,\n    dflt_value: null,\n    pk: 1\n  },\n  {\n    cid: 1,\n    name: 'name',\n    type: 'TEXT',\n    notnull: 1,\n    dflt_value: null,\n    pk: 0\n  },\n  {\n    cid: 2,\n    name: 'type',\n    type: 'TEXT',\n    notnull: 1,\n    dflt_value: \"'basic'\",\n    pk: 0\n  },\n  {\n    cid: 3,\n    name: 'front_template',\n    type: 'TEXT',\n    notnull: 1,\n    dflt_value: null,\n    pk: 0\n  },\n  {\n    cid: 4,\n    name: 'back_template',\n    type: 'TEXT',\n    notnull: 1,\n    dflt_value: null,\n    pk: 0\n  },\n  {\n    cid: 5,\n    name: 'css',\n    type: 'TEXT',\n    notnull: 0,\n    dflt_value: \"''\",\n    pk: 0\n  },\n  {\n    cid: 6,\n    name: 'is_default',\n    type: 'INTEGER',\n    notnull: 0,\n    dflt_value: '0',\n    pk: 0\n  },\n  {\n    cid: 7,\n    name: 'created_at',\n    type: 'DATETIME',\n    notnull: 0,\n    dflt_value: 'CURRENT_TIMESTAMP',\n    pk: 0\n  },\n  {\n    cid: 8,\n    name: 'updated_at',\n    type: 'DATETIME',\n    notnull: 0,\n    dflt_value: 'CURRENT_TIMESTAMP',\n    pk: 0\n  }\n]","cwd":"/home/one/.openclaw/agents/leader-agent"},"isError":false,"timestamp":1772180915845}}
