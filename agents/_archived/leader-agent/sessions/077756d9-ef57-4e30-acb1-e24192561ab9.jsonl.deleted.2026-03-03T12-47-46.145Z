     loadNextBlock();\n }\n \n@@ -108,24 +107,44 @@ bool CGFile::CellLoader::loadNextBlock()\n {\n     if (start + blockSize > upperBound) return false;\n \n-    cgsize_t curBlockDataSize = 0;\n     start += blockSize;\n     auto end = std::min(start + blockSize - 1, upperBound);\n     len = end - start + 1;\n-    cg_ElementPartialSize(fp, 1, 1, curS.id, start, end, &curBlockDataSize);\n-\n-    vector<cgsize_t>{}.swap(data);\n+    \n     if (curS.isMixed())\n     {\n         vector<cgsize_t>{}.swap(offset);\n-        data.assign(curBlockDataSize, 0);\n-        offset.assign(len + 1, 0);\n-        cg_poly_elements_partial_read(fp, 1, 1, curS.id, start, end, data.data(), offset.data(), NULL);\n+        offset.clear();\n+        offset.push_back(0);\n+        data.clear();\n+        \n+        auto connView = _cgioSection->get_connectivity_view(start, end);\n+        cgsize_t offsetVal = 0;\n+        for (cgsize_t i = 0; i < len; ++i) {\n+            auto conn = connView.get_connectivity(i);\n+            ElementType_t type = connView.get_type(i);\n+            if (i == 0) flag = type;\n+            offsetVal += conn.size();\n+            if (i > 0) offset.push_back(offsetVal);\n+            offsetVal++; // for type flag\n+            // Store type flag first, then node indices\n+            data.push_back(type);\n+            for (auto nodeIdx : conn) {\n+                data.push_back(nodeIdx + 1); // Convert to 1-based\n+            }\n+        }\n+        // Rebuild offset array\n+        offset.clear();\n+        offset.push_back(0);\n+        cgsize_t currentOffset = 0;\n+        for (size_t i = 0; i < len; ++i) {\n+            currentOffset += data[currentOffset] + 1; // type + nodes\n+            offset.push_back(currentOffset);\n+        }\n     }\n     else\n     {\n         cg_npe(curS.cellType, &npe);\n-        data.assign(curBlockDataSize, 0);\n-        cg_elements_partial_read(fp, 1, 1, curS.id, start, end, data.data(), NULL);\n+        auto connView = _cgioSection->get_connectivity_view(start, end);\n+        data.clear();\n+        data.reserve(len * npe);\n+        for (cgsize_t i = 0; i < len; ++i) {\n+            auto conn = connView.get_connectivity(i);\n+            for (auto nodeIdx : conn) {\n+                data.push_back(nodeIdx + 1); // Convert to 1-based\n+            }\n+        }\n     }\n \n-    ++blockId;\n     id = 0;\n \n     return true;\nPATCHEOF\necho \"Patch created\""}}],"api":"openai-completions","provider":"bailian","model":"qwen3.5-plus","usage":{"input":61810,"output":1356,"cacheRead":0,"cacheWrite":0,"totalTokens":63166,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"toolUse","timestamp":1772538938463}}
