{"type":"message","id":"4f392e01","parentId":"cdb2a09c","timestamp":"2026-02-27T05:21:31.865Z","message":{"role":"toolResult","toolCallId":"call_function_9tici083w7f2_1","toolName":"read","content":[{"type":"text","text":"// server.js - Express Backend for FSRS Web UI with Multi-deck & Theme support\nconst express = require('express');\nconst cors = require('cors');\nconst path = require('path');\nconst Database = require('better-sqlite3');\n\nconst app = express();\nconst PORT = process.env.PORT || 3001;\n\n// Middleware\napp.use(cors());\napp.use(express.json());\napp.use(express.static(path.join(__dirname, 'public')));\n\n// Database setup - connect to existing cards.db\nconst DB_PATH = process.env.DB_PATH || path.join(__dirname, '..', 'data', 'cards.db');\nconst db = new Database(DB_PATH);\n\n// Import FSRS engine\nconst FSRSEngine = require('../src/fsrs');\n\n// ==================== Database Helper Functions ====================\n\n// Fix inconsistent state values in database\nfunction fixCardStates() {\n  try {\n    // Fix \"2.0\" state to \"review\" (this was a bug where State.Review = 2 was stored as string)\n    const result = db.prepare(\"UPDATE cards SET state = 'review' WHERE state = '2.0'\").run();\n    if (result.changes > 0) {\n      console.log(`Fixed ${result.changes} cards with invalid state '2.0'`);\n    }\n    \n    // Fix empty or null states to \"new\"\n    db.prepare(\"UPDATE cards SET state = 'new' WHERE state IS NULL OR state = ''\").run();\n  } catch (error) {\n    console.error('Error fixing card states:', error);\n  }\n}\n\n// Run state fix on startup\nfixCardStates();\n\n// Get current local time for database queries\nfunction getLocalNow() {\n  return new Date().toISOString();\n}\n\n// ==================== Settings API ====================\n\n// Get theme\n\n[402 more lines in file. Use offset=51 to continue.]"}],"isError":false,"timestamp":1772169691859}}
