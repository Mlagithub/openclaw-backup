{"type":"message","id":"9a6ebab3","parentId":"7f6f5c78","timestamp":"2026-03-04T08:38:04.139Z","message":{"role":"toolResult","toolCallId":"tool-992893478c654cbca3eb7f657f60afdb","toolName":"read","content":[{"type":"text","text":"}\n\n// collect interface from all other threads\n// P0-2: Optimized with sparse point-to-point communication and binary serialization\nvoid MetisCutter::collect_interface()\n{\n    // 1. Identify target ranks (processes we need to communicate with)\n    std::set<int> targetRanks;\n    for (const auto& [nbrFile, faces] : outerFace_)\n    {\n        if (!faces.empty() && ownerThread_.size() > static_cast<size_t>(nbrFile))\n        {\n            int ownerRank = ownerThread_[nbrFile];\n            if (ownerRank != RANK)\n                targetRanks.insert(ownerRank);\n        }\n    }\n\n    // 2. Exchange target rank lists using Allgather (small data, O(SIZE) cost)\n    vector<int> myTargets(targetRanks.begin(), targetRanks.end());\n    int myTargetCount = static_cast<int>(myTargets.size());\n    vector<int> allTargetCounts(SIZE, 0);\n    MPI_Allgather(&myTargetCount, 1, MPI_INT, allTargetCounts.data(), 1, MPI_INT, MPI_COMM_WORLD);\n\n    // Calculate displacements for Allgatherv\n    vector<int> targetDisps(SIZE, 0);\n    int totalTargets = 0;\n    for (int i = 0; i < SIZE; ++i)\n    {\n        targetDisps[i] = totalTargets;\n        totalTargets += allTargetCounts[i];\n    }\n\n    // Gather all target ranks\n    vector<int> allTargets(totalTargets, 0);\n    MPI_Allgatherv(myTargets.data(), myTargetCount, MPI_INT,\n                   allTargets.data(), allTargetCounts.data(), targetDisps.data(), MPI_INT, MPI_COMM_WORLD);\n\n    // 3. Build list of source ranks (ranks that will send to us)\n    std::set<int> sourceRanks;\n    for (int i = 0; i < SIZE; ++i)\n    {\n        if (i == RANK) continue;\n        int start = targetDisps[i];\n        int end = start + allTargetCounts[i];\n        for (int j = start; j < end; ++j)\n        {\n            if (allTargets[j] == RANK)\n            {\n                sourceRanks.insert(i);\n                break;\n            }\n        }\n    }\n\n    // 4. Binary serialization of interface data (P1-3: using hash keys)\n    auto packInterfaceBinary = [&, this]() -> std::vector<char>\n    {\n        std::vector<char> buffer;\n        \n        // Count files with data\n        int fileCount = 0;\n        for (const auto& [nbrFile, faces] : outerFace_)\n        {\n            if (!faces.empty() && ownerThread_.size() > static_cast<size_t>(nbrFile) && ownerThread_[nbrFile] != RANK)\n                ++fileCount;\n        }\n        \n        // Write file count\n        size_t pos = 0;\n        buffer.resize(sizeof(int));\n        std::memcpy(buffer.data(), &fileCount, sizeof(int));\n        pos = sizeof(int);\n        \n        for (const auto& [nbrFile, faces] : outerFace_)\n        {\n            if (faces.empty()) continue;\n            if (ownerThread_.size() <= static_cast<size_t>(nbrFile)) continue;\n            if (ownerThread_[nbrFile] == RANK) continue;  // Skip own files\n            \n            // Write file ID\n            size_t needed = pos + sizeof(int) + sizeof(int);\n            if (buffer.size() < needed) buffer.resize(needed);\n            int fid = nbrFile;\n            std::memcpy(buffer.data() + pos, &fid, sizeof(int));\n            pos += sizeof(int);\n            \n            // Write face count\n            int faceCount = static_cast<int>(faces.size());\n            std::memcpy(buffer.data() + pos, &faceCount, sizeof(int));\n            pos += sizeof(int);\n            \n            // Write each face (P1-3: serialize face hash and face nodes for interface matching)\n            for (const auto& [faceHash, faceNodes] : faces)\n            {\n                // Write face hash\n                needed = pos + sizeof(size_t) + sizeof(int) + faceNodes.size() * sizeof(cgsize_t);\n                if (buffer.size() < needed) buffer.resize(needed);\n                std::memcpy(buffer.data() + pos, &faceHash, sizeof(size_t));\n                pos += sizeof(size_t);\n                \n                // Write face node count\n                int nodeCount = static_cast<int>(faceNodes.size());\n                std::memcpy(buffer.data() + pos, &nodeCount, sizeof(int));\n                pos += sizeof(int);\n                \n                // Write face nodes\n                if (nodeCount > 0)\n                {\n                    std::memcpy(buffer.data() + pos, faceNodes.data(), nodeCount * sizeof(cgsize_t));\n                    pos += nodeCount * sizeof(cgsize_t);\n                }\n            }\n        }\n        buffer.resize(pos);\n        return buffer;\n    };\n\n    auto unpackInterfaceBinary = [&, this](const std::vector<char>& buffer)\n    {\n        if (buffer.empty()) return;\n        \n        size_t pos = 0;\n        int fileCount;\n        std::memcpy(&fileCount, buffer.data(), sizeof(int));\n        pos = sizeof(int);\n        \n        for (int i = 0; i < fileCount; ++i)\n        {\n            // Read file ID\n            int nbrFile;\n            std::memcpy(&nbrFile, buffer.data() + pos, sizeof(int));\n            pos += sizeof(int);\n            \n            // Read face count\n            int faceCount;\n            std::memcpy(&faceCount, buffer.data() + pos, sizeof(int));\n            pos += sizeof(int);\n            \n            if (ownerFile_.count(nbrFile) != 0) continue;\n            \n            check(true, \" \", format(\"  Thread %d: recv %d interface of file %d\\n\", RANK, faceCount, nbrFile));\n            \n            auto& nbrOuterFace = outerFace_[nbrFile];\n            for (int j = 0; j < faceCount; ++j)\n            {\n                // Read face hash\n                size_t faceHash;\n                std::memcpy(&faceHash, buffer.data() + pos, sizeof(size_t));\n                pos += sizeof(size_t);\n                \n                // Read face node count\n                int nodeCount;\n                std::memcpy(&nodeCount, buffer.data() + pos, sizeof(int));\n                pos += sizeof(int);\n                \n                // Read face nodes\n                vector<cgsize_t> faceNodes(nodeCount);\n                if (nodeCount > 0)\n                {\n                    std::memcpy(faceNodes.data(), buffer.data() + pos, nodeCount * sizeof(cgsize_t));\n                    pos += nodeCount * sizeof(cgsize_t);\n                }\n                \n                nbrOuterFace.insert({faceHash, faceNodes});\n            }\n        }\n    };\n\n    MPIAdapter::Barrier();\n\n    // 5. Point-to-point communication using two-phase protocol (size then data)\n    auto packedData = packInterfaceBinary();\n    int sendSize = static_cast<int>(packedData.size());\n    \n    // Convert sourceRanks to vector for indexed access\n    std::vector<int> sourceList(sourceRanks.begin(), sourceRanks.end());\n    int numSources = static_cast<int>(sourceList.size());\n    int numTargets = static_cast<int>(targetRanks.size());\n    \n    // Phase 1: Exchange message sizes\n    std::vector<int> recvSizes(numSources, 0);\n    std::vector<MPI_Request> sizeRecvRequests(numSources);\n    std::vector<MPI_Request> sizeSendRequests(numTargets);\n    \n    // Post receives for sizes\n    for (int i = 0; i < numSources; ++i)\n    {\n        MPI_Irecv(&recvSizes[i], 1, MPI_INT, sourceList[i], DataTAG + RANK, MPI_COMM_WORLD, &sizeRecvRequests[i]);\n    }\n    \n    // Send sizes to targets\n    int targetIdx = 0;\n    for (int target : targetRanks)\n    {\n        MPI_Isend(&sendSize, 1, MPI_INT, target, DataTAG + target, MPI_COMM_WORLD, &sizeSendRequests[targetIdx++]);\n    }\n    \n    // Wait for size exchanges\n    std::vector<MPI_Status> tmpStatuses;\n\n[636 more lines in file. Use offset=256 to continue.]"}],"isError":false,"timestamp":1772613484137}}
